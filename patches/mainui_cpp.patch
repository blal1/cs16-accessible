diff --git a/menu_access.cpp b/menu_access.cpp
new file mode 100644
index 0000000..fcece10
--- /dev/null
+++ b/menu_access.cpp
@@ -0,0 +1,687 @@
+/*
+menu_access.cpp - screen reader support for every menu window (NVDA)
+
+Instead of instrumenting each control, the active window is observed once per
+frame: which window is on top, which item holds the keyboard cursor (descending
+into nested holders such as tab views and script pages), and a text description
+of that item. Any change is spoken:
+
+  new window      -> title (or dialog message) + focused item, interrupting
+  focus moved     -> full description of the new item ("Audio, bouton")
+  value changed   -> only the new value ("cochée", "40 pour cent", table row)
+  text field edit -> typed / deleted characters, character under the cursor
+
+Because it reads state rather than events, it also covers mouse changes and
+windows that update themselves (connection progress).
+*/
+
+#include "BaseMenu.h"
+#include "ItemsHolder.h"
+#include "BaseWindow.h"
+#include "Framework.h"
+#include "Action.h"
+#include "PicButton.h"
+#include "CheckBox.h"
+#include "Slider.h"
+#include "SpinControl.h"
+#include "Field.h"
+#include "Switch.h"
+#include "DropDown.h"
+#include "Table.h"
+#include "MessageBox.h"
+#include "YesNoMessageBox.h"
+
+#include "menu_access.h"
+#include "access_tts.h"
+
+#include <stdio.h>
+#include <string.h>
+#include <typeinfo>
+
+static const size_t DESC_SIZE = 1024;
+
+static CMenuBaseWindow *s_pLastWindow;
+static CMenuBaseItem *s_pLastItem;
+static char s_szLastValue[DESC_SIZE];
+static char s_szLastField[DESC_SIZE];
+static int s_iLastFieldCursor;
+static char s_szLastStaticText[DESC_SIZE];
+static bool s_bToldHowToNavigate;
+static CMenuBaseWindow *s_pSettlingWindow;
+static unsigned int s_uSettleStart;
+static CMenuBaseItem *s_pCandidateItem;
+static int s_iLastCursor = -1;
+static unsigned int s_uCandidateStart;
+
+// ---------------------------------------------------------------------------
+// Text helpers
+// ---------------------------------------------------------------------------
+
+// Appends src to dst, dropping ^N colour codes and control characters.
+static void Append( char *dst, size_t size, const char *src )
+{
+	if( !src )
+		return;
+	size_t o = strlen( dst );
+	for( const char *p = src; *p && o + 1 < size; p++ )
+	{
+		if( *p == '^' && p[1] >= '0' && p[1] <= '9' )
+		{
+			p++;
+			continue;
+		}
+		if( (unsigned char)*p < 0x20 )
+		{
+			if( o > 0 && dst[o - 1] != ' ' )
+				dst[o++] = ' ';
+			continue;
+		}
+		dst[o++] = *p;
+	}
+	dst[o] = 0;
+}
+
+static void AppendSep( char *dst, size_t size, const char *src )
+{
+	if( !src || !src[0] )
+		return;
+	if( dst[0] )
+		Append( dst, size, ", " );
+	Append( dst, size, src );
+}
+
+// Appends a sentence, separated by ". ", skipping empty or blank text.
+static void AppendSentence( char *dst, size_t size, const char *src )
+{
+	if( !src )
+		return;
+	while( *src == ' ' || *src == '.' )
+		src++;
+	if( !src[0] )
+		return;
+	if( dst[0] )
+	{
+		const size_t len = strlen( dst );
+		Append( dst, size, strchr( ".?!:", dst[len - 1] ) ? " " : ". " );
+	}
+	Append( dst, size, src );
+}
+
+static void Speak( const char *text, bool interrupt )
+{
+	if( text && text[0] )
+		AccessTts_Speak( text, interrupt ? 1 : 0 );
+}
+
+// Spoken form of one UTF-8 character.
+static void DescribeChar( const char *utf8, int len, bool hidden, char *out, size_t size )
+{
+	if( hidden )
+		snprintf( out, size, "étoile" );
+	else if( len == 1 && utf8[0] == ' ' )
+		snprintf( out, size, "espace" );
+	else
+		snprintf( out, size, "%.*s", len, utf8 );
+}
+
+static int Utf8Len( const char *p )
+{
+	const unsigned char c = (unsigned char)*p;
+	if( c < 0x80 ) return 1;
+	if( ( c & 0xE0 ) == 0xC0 ) return 2;
+	if( ( c & 0xF0 ) == 0xE0 ) return 3;
+	if( ( c & 0xF8 ) == 0xF0 ) return 4;
+	return 1;
+}
+
+// ---------------------------------------------------------------------------
+// Window titles
+// ---------------------------------------------------------------------------
+
+static const char *KnownTitle( const char *className )
+{
+	static const struct { const char *name; const char *title; } titles[] =
+	{
+		{ "CMenuMain", "Menu principal" },
+		{ "CMenuNewGame", "Nouvelle partie" },
+		{ "CMenuMultiplayer", "Multijoueur" },
+		{ "CMenuServerBrowser", "Liste des serveurs" },
+		{ "CMenuServerInfo", "Informations du serveur" },
+		{ "CMenuCreateGame", "Créer une partie" },
+		{ "CMenuCustomGame", "Choix du mod" },
+		{ "CMenuLoadGame", "Charger une partie" },
+		{ "CMenuSaveLoad", "Sauvegarder et charger" },
+		{ "CMenuOptions", "Options" },
+		{ "CMenuAudio", "Options audio" },
+		{ "CMenuVideo", "Options vidéo" },
+		{ "CMenuVidOptions", "Réglages de l'image" },
+		{ "CMenuVidModes", "Résolution et mode d'affichage" },
+		{ "CMenuControls", "Touches du clavier" },
+		{ "CAdvancedControls", "Commandes avancées, souris" },
+		{ "CMenuGameOptions", "Options de jeu" },
+		{ "CMenuPlayerSetup", "Personnalisation du joueur" },
+		{ "CMenuCrosshair", "Réglage du viseur" },
+		{ "CMenuInputDevices", "Périphériques d'entrée" },
+		{ "CMenuGamePad", "Manette" },
+		{ "CMenuGyro", "Gyroscope" },
+		{ "CMenuTouchButtons", "Boutons tactiles" },
+		{ "CMenuTouchEdit", "Édition tactile" },
+		{ "CMenuTouchOptions", "Options tactiles" },
+		{ "CMenuFileDialog", "Choix d'un fichier" },
+		{ "ScriptConfig", "Options du serveur" },
+		{ "CClientJoinGame", "Choix de l'équipe" },
+		{ "CClientJoinClass", "Choix du personnage" },
+		{ "CMenuColorPickerDialog", "Choix de couleur" },
+		{ "CMenuCommandPickerDialog", "Choix d'une commande" },
+		{ "ConnectionProgress", "Connexion" },
+		{ "ConnectionWarning", "Avertissement de connexion" },
+		{ "Credits", "Crédits" },
+	};
+	if( !className )
+		return NULL;
+	for( size_t i = 0; i < sizeof( titles ) / sizeof( titles[0] ); i++ )
+		if( !strcmp( className, titles[i].name ) )
+			return titles[i].title;
+	return NULL;
+}
+
+// Title for a window: dialogs speak their message, menus a known title, then the
+// banner text (label of the button that opened it), then the internal name.
+static void WindowTitle( CMenuBaseWindow *win, char *out, size_t size )
+{
+	out[0] = 0;
+	if( CMenuYesNoMessageBox *yn = dynamic_cast<CMenuYesNoMessageBox *>( win ))
+	{
+		Append( out, size, "Question : " );
+		Append( out, size, yn->dlgMessage1.szName );
+		return;
+	}
+	if( CMenuMessageBox *mb = dynamic_cast<CMenuMessageBox *>( win ))
+	{
+		Append( out, size, "Message : " );
+		Append( out, size, mb->GetMessage() );
+		return;
+	}
+
+	const char *known = KnownTitle( win->szName );
+	if( known )
+	{
+		Append( out, size, known );
+		if( !strcmp( win->szName, "CMenuMain" ) && EngFuncs::ClientInGame() )
+			Append( out, size, ", partie en cours" );
+		return;
+	}
+	CMenuFramework *fw = dynamic_cast<CMenuFramework *>( win );
+	if( fw && fw->banner.szName && fw->banner.szName[0] )
+		Append( out, size, fw->banner.szName );
+	else
+		Append( out, size, win->szName );
+}
+
+// ---------------------------------------------------------------------------
+// Items
+// ---------------------------------------------------------------------------
+
+static bool IsFocusable( CMenuBaseItem *item )
+{
+	return item && item->IsVisible() && !( item->iFlags & ( QMF_INACTIVE | QMF_MOUSEONLY ));
+}
+
+// Worth announcing: a labelled item or an input control. Banners and pictures
+// are keyboard-reachable in mainui but carry nothing a listener can use.
+static bool IsMeaningful( CMenuBaseItem *item )
+{
+	if( !IsFocusable( item ))
+		return false;
+	// The title banner repeats the window name, which the title already says.
+	if( dynamic_cast<CMenuFramework::CMenuBannerBitmap *>( item ))
+		return false;
+	if( item->szName && item->szName[0] )
+		return true;
+	return dynamic_cast<CMenuEditable *>( item ) || dynamic_cast<CMenuTable *>( item ) || dynamic_cast<CMenuItemsHolder *>( item );
+}
+
+// The item that really has the keyboard cursor, descending into nested holders.
+static CMenuBaseItem *FocusedLeaf( CMenuItemsHolder *holder )
+{
+	CMenuBaseItem *item = holder->ItemAtCursor();
+	for( int depth = 0; item && depth < 8; depth++ )
+	{
+		CMenuItemsHolder *inner = dynamic_cast<CMenuItemsHolder *>( item );
+		if( !inner || inner->IsWindow() )
+			break;
+		CMenuBaseItem *next = inner->ItemAtCursor();
+		if( !next )
+			break;
+		item = next;
+	}
+	return item;
+}
+
+// The arrows stopped on a decoration: continue in the same direction to the
+// next meaningful item (wrapping), as if the decoration were not there.
+static void SkipDecoration( CMenuBaseWindow *win, int previousCursor )
+{
+	const int count = win->ItemCount();
+	const int cursor = win->GetCursor();
+	if( count <= 0 || cursor < 0 )
+		return;
+	// The arrows move one step at a time, skipping hidden and mouse-only items, so a
+	// jump of more than half the list means the cursor wrapped around the end.
+	int dir = cursor > previousCursor ? 1 : -1;
+	if( previousCursor >= 0 && ( cursor - previousCursor > count / 2 || previousCursor - cursor > count / 2 ))
+		dir = -dir;
+	for( int step = 1; step < count; step++ )
+	{
+		const int i = ( ( cursor + dir * step ) % count + count ) % count;
+		if( IsMeaningful( win->GetItemByIndex( i )))
+		{
+			win->SetCursor( i );
+			return;
+		}
+	}
+}
+
+static void DescribeTableRow( CMenuTable *table, char *out, size_t size )
+{
+	CMenuBaseModel *model = table->GetModel();
+	const int rows = model ? model->GetRows() : 0;
+	if( rows <= 0 )
+	{
+		Append( out, size, "vide" );
+		return;
+	}
+	const int row = table->GetCurrentIndex();
+	if( row < 0 || row >= rows )
+	{
+		char buf[64];
+		snprintf( buf, sizeof( buf ), "%d lignes, aucune sélectionnée", rows );
+		Append( out, size, buf );
+		return;
+	}
+
+	char pos[64];
+	snprintf( pos, sizeof( pos ), "ligne %d sur %d", row + 1, rows );
+	Append( out, size, pos );
+	for( int col = 0; col < model->GetColumns(); col++ )
+	{
+		const char *cell = model->GetCellText( row, col );
+		if( !cell || !cell[0] )
+			continue;
+		// Rows made only of '=' are section separators in the key binding list.
+		if( strspn( cell, "=-_ " ) == strlen( cell ))
+		{
+			Append( out, size, ", séparateur de section" );
+			continue;
+		}
+		Append( out, size, ", " );
+		const char *header = table->GetHeaderText( col );
+		if( header && header[0] )
+		{
+			Append( out, size, header );
+			Append( out, size, " " );
+		}
+		Append( out, size, cell );
+	}
+}
+
+// value: only the part that changes when the user operates the control.
+// kind: spoken control type ("bouton", "case à cocher"...).
+static void DescribeItem( CMenuBaseItem *item, char *kind, char *value )
+{
+	kind[0] = value[0] = 0;
+	if( !item )
+		return;
+
+	if( CMenuCheckBox *cb = dynamic_cast<CMenuCheckBox *>( item ))
+	{
+		strcpy( kind, "case à cocher" );
+		Append( value, DESC_SIZE, cb->bChecked ? "cochée" : "non cochée" );
+	}
+	else if( CMenuSlider *sl = dynamic_cast<CMenuSlider *>( item ))
+	{
+		strcpy( kind, "curseur" );
+		const float range = sl->GetMaxValue() - sl->GetMinValue();
+		const int percent = range > 0.0f ? (int)( ( sl->GetCurrentValue() - sl->GetMinValue() ) / range * 100.0f + 0.5f ) : 0;
+		snprintf( value, DESC_SIZE, "%d pour cent", percent );
+	}
+	else if( CMenuSpinControl *sp = dynamic_cast<CMenuSpinControl *>( item ))
+	{
+		strcpy( kind, "sélecteur, flèches gauche et droite" );
+		Append( value, DESC_SIZE, sp->GetDisplayText() );
+	}
+	else if( CMenuField *f = dynamic_cast<CMenuField *>( item ))
+	{
+		strcpy( kind, "zone de texte" );
+		const char *buf = f->GetBuffer();
+		if( !buf || !buf[0] )
+			Append( value, DESC_SIZE, "vide" );
+		else if( f->bHideInput )
+			snprintf( value, DESC_SIZE, "%d caractères masqués", (int)strlen( buf ));
+		else
+			Append( value, DESC_SIZE, buf );
+	}
+	else if( CMenuDropDown *dd = dynamic_cast<CMenuDropDown *>( item ))
+	{
+		strcpy( kind, "liste déroulante, flèches haut et bas" );
+		Append( value, DESC_SIZE, dd->GetCurrentName() );
+	}
+	else if( CMenuSwitch *sw = dynamic_cast<CMenuSwitch *>( item ))
+	{
+		strcpy( kind, "onglets, Entrée pour changer" );
+		Append( value, DESC_SIZE, sw->GetSwitchName( sw->GetState() ));
+	}
+	else if( CMenuTable *tb = dynamic_cast<CMenuTable *>( item ))
+	{
+		strcpy( kind, "liste, flèches haut et bas, Entrée pour choisir" );
+		DescribeTableRow( tb, value, DESC_SIZE );
+	}
+	else if( dynamic_cast<CMenuPicButton *>( item ))
+	{
+		strcpy( kind, "bouton" );
+	}
+}
+
+// Name to speak for an item. Unnamed controls (filter drop-downs, fields in some
+// dialogs) are laid out as "label, control": use the nearest static text before it.
+static const char *SpokenName( CMenuBaseItem *item )
+{
+	if( item->szName && item->szName[0] )
+		return item->szName;
+
+	CMenuItemsHolder *parent = item->Parent();
+	if( !parent )
+		return NULL;
+
+	int index = -1;
+	for( int i = 0; i < parent->ItemCount(); i++ )
+	{
+		if( parent->GetItemByIndex( i ) == item )
+		{
+			index = i;
+			break;
+		}
+	}
+	for( int i = index - 1; i >= 0; i-- )
+	{
+		CMenuBaseItem *prev = parent->GetItemByIndex( i );
+		if( !prev || !prev->IsVisible() )
+			continue;
+		if( dynamic_cast<CMenuAction *>( prev ))
+			return prev->szName && prev->szName[0] ? prev->szName : NULL;
+		if( IsMeaningful( prev ))
+			break;	// another control comes first: the label is not ours
+	}
+	return NULL;
+}
+
+static void FullDescription( CMenuBaseItem *item, char *out, size_t size )
+{
+	char kind[128], value[DESC_SIZE];
+	DescribeItem( item, kind, value );
+
+	Append( out, size, SpokenName( item ));
+	AppendSep( out, size, kind );
+	AppendSep( out, size, value );
+	if( item->iFlags & QMF_GRAYED )
+		AppendSep( out, size, "indisponible" );
+	if( item->szStatusText && item->szStatusText[0] && ( !item->szName || strcmp( item->szName, item->szStatusText )))
+	{
+		Append( out, size, ". " );
+		Append( out, size, item->szStatusText );
+	}
+}
+
+// Visible static texts of a window (dialog bodies, connection progress...).
+static void StaticTexts( CMenuItemsHolder *win, char *out, size_t size )
+{
+	out[0] = 0;
+	for( int i = 0; i < win->ItemCount(); i++ )
+	{
+		CMenuBaseItem *item = win->GetItemByIndex( i );
+		if( !item || !item->IsVisible() || !dynamic_cast<CMenuAction *>( item ))
+			continue;
+		if( item->szName && item->szName[0] )
+		{
+			if( out[0] )
+				Append( out, size, ". " );
+			Append( out, size, item->szName );
+		}
+	}
+}
+
+// Text field editing: say what was typed or deleted, or the character reached.
+static void AnnounceFieldEdit( CMenuField *field )
+{
+	const char *now = field->GetBuffer() ? field->GetBuffer() : "";
+	const int cursor = field->GetCursorPos();
+	const char *before = s_szLastField;
+	const size_t lenNow = strlen( now ), lenBefore = strlen( before );
+	char spoken[256] = "";
+
+	if( strcmp( now, before ))
+	{
+		size_t prefix = 0;
+		while( prefix < lenNow && prefix < lenBefore && now[prefix] == before[prefix] )
+			prefix++;
+		size_t suffix = 0;
+		while( suffix < lenNow - prefix && suffix < lenBefore - prefix && now[lenNow - 1 - suffix] == before[lenBefore - 1 - suffix] )
+			suffix++;
+
+		const int added = (int)( lenNow - prefix - suffix );
+		const int removed = (int)( lenBefore - prefix - suffix );
+		if( added > 0 && removed == 0 )
+		{
+			if( added <= 4 )
+				DescribeChar( now + prefix, added, field->bHideInput, spoken, sizeof( spoken ));
+			else if( !field->bHideInput )
+				snprintf( spoken, sizeof( spoken ), "%.*s", added, now + prefix );
+		}
+		else if( removed > 0 && added == 0 )
+		{
+			char ch[64];
+			DescribeChar( before + prefix, removed, field->bHideInput, ch, sizeof( ch ));
+			snprintf( spoken, sizeof( spoken ), "%s effacé", ch );
+		}
+		else
+		{
+			// Replaced wholesale (history, paste, completion).
+			snprintf( spoken, sizeof( spoken ), "%s", field->bHideInput ? "texte masqué" : ( lenNow ? now : "vide" ));
+		}
+	}
+	else if( cursor != s_iLastFieldCursor )
+	{
+		if( cursor >= 0 && (size_t)cursor < lenNow )
+			DescribeChar( now + cursor, Utf8Len( now + cursor ), field->bHideInput, spoken, sizeof( spoken ));
+		else
+			snprintf( spoken, sizeof( spoken ), "fin" );
+	}
+
+	Speak( spoken, true );
+	snprintf( s_szLastField, sizeof( s_szLastField ), "%s", now );
+	s_iLastFieldCursor = cursor;
+}
+
+static void RememberField( CMenuBaseItem *item )
+{
+	CMenuField *field = dynamic_cast<CMenuField *>( item );
+	snprintf( s_szLastField, sizeof( s_szLastField ), "%s", field && field->GetBuffer() ? field->GetBuffer() : "" );
+	s_iLastFieldCursor = field ? field->GetCursorPos() : 0;
+}
+
+// ---------------------------------------------------------------------------
+// Frame
+// ---------------------------------------------------------------------------
+
+static cvar_t *access_menu_mouse;
+
+void MenuAccess_Init( void )
+{
+	access_menu_mouse = EngFuncs::CvarRegister( "access_menu_mouse", "0", FCVAR_ARCHIVE );
+}
+
+bool MenuAccess_MouseEnabled( void )
+{
+	return access_menu_mouse && access_menu_mouse->value != 0.0f;
+}
+
+void MenuAccess_ParkPointer( void )
+{
+	// Keyboard-only mode: park the menu's pointer off screen, so windows that
+	// re-test the pointer when they open or regain focus never move the focus.
+	if( !MenuAccess_MouseEnabled( ))
+	{
+		uiStatic.cursorX = -10000;
+		uiStatic.cursorY = -10000;
+	}
+}
+
+void MenuAccess_Frame( void )
+{
+	MenuAccess_ParkPointer();
+
+	CMenuBaseWindow *win = NULL;
+	if( uiStatic.menu.IsActive() )
+		win = uiStatic.menu.Current();
+	else if( uiStatic.client.IsActive() )
+		win = uiStatic.client.Current();
+
+	if( !win )
+	{
+		// Menus closed: the next open window is announced again.
+		s_pLastWindow = NULL;
+		s_pLastItem = NULL;
+		return;
+	}
+
+	static CMenuBaseWindow *s_pLoggedWindow;
+	if( win != s_pLoggedWindow )
+	{
+		char diag[160];
+		snprintf( diag, sizeof( diag ), "fenêtre %s, %d éléments, curseur %d", win->szName, win->ItemCount(), win->GetCursor() );
+		AccessTts_Log( diag );
+		for( int i = 0; i < win->ItemCount(); i++ )
+		{
+			CMenuBaseItem *it = win->GetItemByIndex( i );
+			if( !it )
+				continue;
+			snprintf( diag, sizeof( diag ), "  [%d] %s flags=%08x visible=%d '%s'", i, typeid( *it ).name(), it->iFlags,
+				it->IsVisible() ? 1 : 0, it->szName ? it->szName : "" );
+			AccessTts_Log( diag );
+		}
+		s_pLoggedWindow = win;
+	}
+
+	const bool windowChanged = win != s_pLastWindow;
+	const unsigned int now = AccessTts_Ticks();
+
+	CMenuBaseItem *item = FocusedLeaf( win );
+	if( item && !IsMeaningful( item ))
+	{
+		// The arrows stopped on a banner or picture: carry on to the next
+		// meaningful item. Never done when a window opens, because the key that
+		// opened it is still being released and buttons activate on release.
+		if( !windowChanged && win->GetCursor() != s_iLastCursor && IsFocusable( win->ItemAtCursor() ))
+		{
+			SkipDecoration( win, s_iLastCursor );
+			item = FocusedLeaf( win );
+			if( item && !IsMeaningful( item ))
+				item = NULL;
+		}
+		else
+			item = NULL;
+	}
+
+	// Let the opening animation settle (items turn visible/active) briefly, so
+	// the title is spoken together with the focused item when there is one.
+	if( windowChanged && !item )
+	{
+		if( s_pSettlingWindow != win )
+		{
+			s_pSettlingWindow = win;
+			s_uSettleStart = now;
+		}
+		if( (int)( now - s_uSettleStart ) < 400 )
+			return;
+	}
+	s_pSettlingWindow = NULL;
+
+	// Focus changes are spoken once stable for 80 ms, so transient flicker
+	// (animations) never reaches the speech output.
+	if( !windowChanged && item && item != s_pLastItem )
+	{
+		if( item != s_pCandidateItem )
+		{
+			s_pCandidateItem = item;
+			s_uCandidateStart = now;
+			return;
+		}
+		if( (int)( now - s_uCandidateStart ) < 80 )
+			return;
+	}
+	s_pCandidateItem = NULL;
+
+	char kind[128], value[DESC_SIZE];
+	DescribeItem( item, kind, value );
+
+	char text[DESC_SIZE * 2];
+	text[0] = 0;
+
+	char statics[DESC_SIZE];
+	StaticTexts( win, statics, sizeof( statics ));
+
+	if( windowChanged )
+	{
+		WindowTitle( win, text, sizeof( text ));
+
+		if( item )
+		{
+			char desc[DESC_SIZE] = "";
+			FullDescription( item, desc, sizeof( desc ));
+			AppendSentence( text, sizeof( text ), desc );
+		}
+		else if( !dynamic_cast<CMenuYesNoMessageBox *>( win ) && !dynamic_cast<CMenuMessageBox *>( win ))
+		{
+			AppendSentence( text, sizeof( text ), statics );
+		}
+
+		if( !s_bToldHowToNavigate )
+		{
+			AppendSentence( text, sizeof( text ), "Flèches pour naviguer, Entrée pour valider, Échap pour revenir." );
+			s_bToldHowToNavigate = true;
+		}
+		Speak( text, true );
+		RememberField( item );
+	}
+	else if( !item )
+	{
+		// Nothing focused (cursor on a decoration). Windows without any focus
+		// that update themselves (connection progress) speak their text changes.
+		if( !s_pLastItem && strcmp( statics, s_szLastStaticText ))
+			Speak( statics, false );
+		snprintf( s_szLastStaticText, sizeof( s_szLastStaticText ), "%s", statics );
+		s_pLastWindow = win;
+		s_iLastCursor = win->GetCursor();
+		return;
+	}
+	else if( item != s_pLastItem )
+	{
+		FullDescription( item, text, sizeof( text ));
+		Speak( text, true );
+		RememberField( item );
+	}
+	else if( CMenuField *field = dynamic_cast<CMenuField *>( item ))
+	{
+		AnnounceFieldEdit( field );
+	}
+	else if( strcmp( value, s_szLastValue ))
+	{
+		Speak( value, true );
+	}
+
+	snprintf( s_szLastStaticText, sizeof( s_szLastStaticText ), "%s", statics );
+	s_pLastWindow = win;
+	s_pLastItem = item;
+	s_iLastCursor = win->GetCursor();
+	snprintf( s_szLastValue, sizeof( s_szLastValue ), "%s", value );
+}
diff --git a/menu_access.h b/menu_access.h
new file mode 100644
index 0000000..d3df0c9
--- /dev/null
+++ b/menu_access.h
@@ -0,0 +1,13 @@
+/*
+menu_access.h - screen reader support for every menu window (NVDA)
+*/
+#pragma once
+
+// Call once per frame: announces window changes, focus moves and value changes.
+void MenuAccess_Frame( void );
+// Registers the menu accessibility cvars.
+void MenuAccess_Init( void );
+// False while access_menu_mouse is 0: mouse hovering must not move the focus.
+bool MenuAccess_MouseEnabled( void );
+// Moves the menu pointer off screen when the mouse is disabled (see access_menu_mouse).
+void MenuAccess_ParkPointer( void );
