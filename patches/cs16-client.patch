diff --git a/cl_dll/accessibility/access_speech.cpp b/cl_dll/accessibility/access_speech.cpp
new file mode 100644
index 0000000..7098d1f
--- /dev/null
+++ b/cl_dll/accessibility/access_speech.cpp
@@ -0,0 +1,465 @@
+/*
+access_speech.cpp - screen reader (NVDA) announcements for blind players
+
+Speech goes through access_tts (NVDA controller, loaded at runtime), so the
+client still works when NVDA is missing: announcements are then dropped.
+*/
+
+#include "hud.h"
+#include "cl_util.h"
+#include "accessibility/access_speech.h"
+#include "accessibility/access_nav.h"
+#include "accessibility/access_screens.h"
+
+#include <string.h>
+#include <stdio.h>
+
+#include "accessibility/access_tts.h"
+#include "vgui_parser.h"
+
+#define ACCESS_ARRAYSIZE( a ) ( sizeof( a ) / sizeof( ( a )[0] ) )
+
+static bool s_bWarned;
+
+static cvar_t *access_speech;
+static cvar_t *access_speech_chat;
+static cvar_t *access_speech_kills;
+static cvar_t *access_speech_hud;
+static cvar_t *access_textmenus;
+static cvar_t *access_debug;
+
+static char s_szLastSpoken[1024];
+
+// Cached HUD state for access_status.
+static int s_iHealth = -1;
+static int s_iArmor = -1;
+static int s_iMoney = -1;
+static char s_szWeapon[64];
+static int s_iClip = -1;
+static int s_iReserve = -1;
+
+// Latest-wins announcement slots: rapid updates (damage ticks, buy bursts) are
+// merged and only the final value is spoken once the value has settled.
+enum AccessSlot
+{
+	ACCESS_SLOT_HEALTH = 0,
+	ACCESS_SLOT_ARMOR,
+	ACCESS_SLOT_MONEY,
+	ACCESS_SLOT_COUNT
+};
+
+struct PendingAnnouncement
+{
+	char text[128];
+	unsigned int dueTick;
+	bool pending;
+};
+
+static PendingAnnouncement s_Pending[ACCESS_SLOT_COUNT];
+
+static const unsigned int ACCESS_COALESCE_MS = 400;
+
+// Strips GoldSrc markup so the screen reader only gets words:
+// color bytes (0x01-0x04), menu codes (\r \w \y \d \R), and runs of whitespace.
+// Newlines become ". " so menu items are separated by a pause.
+static void CleanForSpeech( const char *in, char *out, size_t outSize )
+{
+	size_t o = 0;
+	bool lastWasSpace = true;
+
+	for( const unsigned char *p = (const unsigned char *)in; *p && o + 3 < outSize; p++ )
+	{
+		unsigned char c = *p;
+
+		if( c == '\\' && p[1] && strchr( "rwydR", p[1] ) )
+		{
+			// \R right-aligns the rest of the line (prices in buy menus):
+			// read it as a separate column, "Sidearm, 400".
+			if( p[1] == 'R' && o > 0 && !lastWasSpace )
+			{
+				out[o++] = ',';
+				out[o++] = ' ';
+				lastWasSpace = true;
+			}
+			p++;
+			continue;
+		}
+
+		if( c == '\n' )
+		{
+			while( o > 0 && out[o - 1] == ' ' )
+				o--;
+			if( o > 0 && !strchr( ".:!?", out[o - 1] ) )
+				out[o++] = '.';
+			out[o++] = ' ';
+			lastWasSpace = true;
+			continue;
+		}
+
+		if( c < 0x20 || c == 0x7f )
+			c = ' ';
+
+		if( c == ' ' )
+		{
+			if( lastWasSpace )
+				continue;
+			lastWasSpace = true;
+		}
+		else
+		{
+			lastWasSpace = false;
+		}
+
+		out[o++] = (char)c;
+	}
+
+	while( o > 0 && ( out[o - 1] == ' ' || out[o - 1] == '.' ) )
+		o--;
+	out[o] = 0;
+}
+
+static void SpeakRaw( const char *clean, bool interrupt )
+{
+	if( !clean[0] )
+		return;
+
+	strncpy( s_szLastSpoken, clean, sizeof( s_szLastSpoken ) - 1 );
+	s_szLastSpoken[sizeof( s_szLastSpoken ) - 1] = 0;
+
+	if( access_debug && access_debug->value )
+		gEngfuncs.Con_Printf( "[access] %s\n", clean );
+
+	const int result = AccessTts_Speak( clean, interrupt ? 1 : 0 );
+	if( result == ACCESS_TTS_OK )
+	{
+		s_bWarned = false;
+	}
+	else if( !s_bWarned )
+	{
+		gEngfuncs.Con_Printf( result == ACCESS_TTS_UNAVAILABLE
+			? "[access] nvdaControllerClient.dll introuvable : annonces vocales désactivées.\n"
+			: "[access] NVDA ne répond pas (lancé ?).\n" );
+		s_bWarned = true;
+	}
+}
+
+static bool SpeechEnabled( cvar_t *category )
+{
+	if( !access_speech || !access_speech->value )
+		return false;
+	return !category || category->value != 0.0f;
+}
+
+void Access_Speak( const char *text, bool interrupt )
+{
+	if( !text || !SpeechEnabled( NULL ) )
+		return;
+
+	char clean[1024];
+	CleanForSpeech( text, clean, sizeof( clean ) );
+	SpeakRaw( clean, interrupt );
+}
+
+static void SpeakCoalesced( AccessSlot slot, const char *text )
+{
+	PendingAnnouncement &p = s_Pending[slot];
+	strncpy( p.text, text, sizeof( p.text ) - 1 );
+	p.text[sizeof( p.text ) - 1] = 0;
+	p.dueTick = AccessTts_Ticks() + ACCESS_COALESCE_MS;
+	p.pending = true;
+}
+
+void Access_Frame( void )
+{
+	// Apply the accessibility profile (key binds, cvars) once, after the engine
+	// has run the user's own config files, so these binds take precedence.
+	static bool s_bProfileApplied;
+	if( !s_bProfileApplied )
+	{
+		gEngfuncs.pfnClientCmd( "exec access.cfg\n" );
+		s_bProfileApplied = true;
+	}
+
+	// The client localizes at startup, before the user's config sets
+	// ui_language; reload the strings whenever the language changes so
+	// server menus and messages are spoken in the chosen language.
+	static char s_szLanguage[32];
+	static bool s_bLanguageKnown;
+	const char *language = gEngfuncs.pfnGetCvarString( "ui_language" );
+	if( language && ( !s_bLanguageKnown || strcmp( language, s_szLanguage )))
+	{
+		// The first sighting after startup may already differ from what
+		// Localize_Init() saw in CHud::Init, so always reload once.
+		Localize_Init();
+		snprintf( s_szLanguage, sizeof( s_szLanguage ), "%s", language );
+		s_bLanguageKnown = true;
+	}
+
+	const unsigned int now = AccessTts_Ticks();
+	for( int i = 0; i < ACCESS_SLOT_COUNT; i++ )
+	{
+		PendingAnnouncement &p = s_Pending[i];
+		if( p.pending && (int)( now - p.dueTick ) >= 0 )
+		{
+			p.pending = false;
+			if( SpeechEnabled( access_speech_hud ) )
+				Access_Speak( p.text );
+		}
+	}
+}
+
+bool Access_WantsTextMenus( void )
+{
+	return access_textmenus && access_textmenus->value && access_speech && access_speech->value;
+}
+
+// weapon_ak47 / ak47 -> readable name.
+static const char *FriendlyWeaponName( const char *name )
+{
+	static const struct { const char *id; const char *spoken; } table[] =
+	{
+		{ "p228", "P228" }, { "glock18", "Glock 18" }, { "glock", "Glock 18" }, { "usp", "USP" },
+		{ "deagle", "Desert Eagle" }, { "elite", "Dual Berettas" }, { "fiveseven", "Five-SeveN" },
+		{ "m3", "fusil à pompe M3" }, { "xm1014", "fusil à pompe XM1014" },
+		{ "mac10", "MAC-10" }, { "tmp", "TMP" }, { "mp5navy", "MP5" }, { "ump45", "UMP 45" }, { "p90", "P90" },
+		{ "galil", "Galil" }, { "famas", "FAMAS" }, { "ak47", "AK-47" }, { "m4a1", "M4A1" },
+		{ "sg552", "SG 552" }, { "aug", "AUG" }, { "scout", "Scout" }, { "awp", "AWP" },
+		{ "g3sg1", "G3SG1" }, { "sg550", "SG 550" }, { "m249", "mitrailleuse M249" },
+		{ "knife", "couteau" }, { "hegrenade", "grenade explosive" }, { "flashbang", "grenade flash" },
+		{ "smokegrenade", "grenade fumigène" }, { "c4", "bombe C4" },
+		{ "grenade", "grenade" }, { "worldspawn", "chute" }, { "trigger_hurt", "environnement" },
+	};
+
+	if( !name )
+		return "";
+	if( !strncmp( name, "weapon_", 7 ) )
+		name += 7;
+	for( size_t i = 0; i < ACCESS_ARRAYSIZE( table ); i++ )
+	{
+		if( !stricmp( name, table[i].id ) )
+			return table[i].spoken;
+	}
+	return name;
+}
+
+void Access_OnHealth( int health )
+{
+	AccessNav_OnHealth( health );
+	if( health == s_iHealth )
+		return;
+	s_iHealth = health;
+	if( health <= 0 )
+		return; // death is announced by the death notice
+
+	char buf[64];
+	snprintf( buf, sizeof( buf ), "Santé %d", health );
+	SpeakCoalesced( ACCESS_SLOT_HEALTH, buf );
+}
+
+void Access_OnArmor( int armor )
+{
+	if( armor == s_iArmor )
+		return;
+	s_iArmor = armor;
+
+	char buf[64];
+	snprintf( buf, sizeof( buf ), "Armure %d", armor );
+	SpeakCoalesced( ACCESS_SLOT_ARMOR, buf );
+}
+
+void Access_OnMoney( int money, int delta )
+{
+	const bool firstUpdate = s_iMoney < 0;
+	s_iMoney = money;
+	if( delta == 0 || firstUpdate )
+		return;
+
+	char buf[96];
+	snprintf( buf, sizeof( buf ), "%s%d dollars, total %d", delta > 0 ? "plus " : "moins ", delta > 0 ? delta : -delta, money );
+	SpeakCoalesced( ACCESS_SLOT_MONEY, buf );
+}
+
+void Access_OnWeaponSelected( const char *weaponName, int clip, int reserve )
+{
+	const char *spoken = FriendlyWeaponName( weaponName );
+	const bool changed = strcmp( s_szWeapon, spoken ) != 0;
+
+	strncpy( s_szWeapon, spoken, sizeof( s_szWeapon ) - 1 );
+	s_szWeapon[sizeof( s_szWeapon ) - 1] = 0;
+	s_iClip = clip;
+	s_iReserve = reserve;
+	AccessNav_OnClip( changed, clip );
+
+	if( !changed || !SpeechEnabled( access_speech_hud ) )
+		return;
+
+	char buf[160];
+	if( clip >= 0 )
+		snprintf( buf, sizeof( buf ), "%s, %d balles, réserve %d", spoken, clip, reserve );
+	else
+		snprintf( buf, sizeof( buf ), "%s", spoken );
+	Access_Speak( buf, true );
+}
+
+void Access_OnChatLine( const char *line )
+{
+	if( SpeechEnabled( access_speech_chat ) )
+		Access_Speak( line );
+}
+
+void Access_OnCenterMessage( const char *message )
+{
+	if( SpeechEnabled( NULL ) )
+		Access_Speak( message );
+}
+
+void Access_OnMenu( const char *menu )
+{
+	if( SpeechEnabled( NULL ) )
+		Access_Speak( menu, true );
+}
+
+void Access_OnDeath( const char *killer, const char *victim, const char *weapon,
+	bool headshot, bool localIsKiller, bool localIsVictim )
+{
+	if( !SpeechEnabled( access_speech_kills ) && !localIsVictim && !localIsKiller )
+		return;
+	if( !SpeechEnabled( NULL ) )
+		return;
+
+	const char *w = FriendlyWeaponName( weapon );
+	const char *hs = headshot ? ", tir à la tête" : "";
+	char buf[256];
+
+	if( localIsVictim && localIsKiller )
+		snprintf( buf, sizeof( buf ), "Vous vous êtes tué" );
+	else if( localIsVictim )
+		snprintf( buf, sizeof( buf ), "Vous êtes mort, tué par %s, %s%s", killer[0] ? killer : "le monde", w, hs );
+	else if( localIsKiller )
+		snprintf( buf, sizeof( buf ), "Vous avez tué %s, %s%s", victim, w, hs );
+	else if( killer[0] && strcmp( killer, victim ) )
+		snprintf( buf, sizeof( buf ), "%s a tué %s, %s%s", killer, victim, w, hs );
+	else
+		snprintf( buf, sizeof( buf ), "%s est mort", victim );
+
+	Access_Speak( buf, localIsVictim );
+}
+
+void Access_OnStatusIcon( const char *icon, int state )
+{
+	// C4 icon: state 1 = carrying the bomb, 2 = flashing inside a bomb site.
+	if( !stricmp( icon, "c4" ))
+	{
+		static int c4State;
+		if( state == c4State )
+			return;
+		const char *text = NULL;
+		if( state == 2 )
+			text = "Site de bombe, vous pouvez poser la bombe";
+		else if( state == 1 && c4State == 2 )
+			text = "Hors du site de bombe";
+		else if( state == 1 )
+			text = "Vous portez la bombe";
+		c4State = state;
+		if( text && SpeechEnabled( access_speech_hud ) )
+			Access_Speak( text );
+		return;
+	}
+
+	const bool enabled = state != 0;
+	static const struct { const char *icon; const char *enter; const char *leave; } zones[] =
+	{
+		{ "buyzone", "Zone d'achat", "Hors zone d'achat" },
+		{ "rescue", "Zone de sauvetage des otages", NULL },
+		{ "escape", "Zone d'évasion", NULL },
+		{ "vipsafety", "Zone de sécurité VIP", NULL },
+		{ "defuser", "Kit de désamorçage équipé", NULL },
+	};
+	static bool active[ACCESS_ARRAYSIZE( zones )];
+
+	for( size_t i = 0; i < ACCESS_ARRAYSIZE( zones ); i++ )
+	{
+		if( stricmp( icon, zones[i].icon ) )
+			continue;
+		// The server resends enabled icons (e.g. flashing C4); only announce transitions.
+		if( active[i] == enabled )
+			return;
+		active[i] = enabled;
+
+		const char *text = enabled ? zones[i].enter : zones[i].leave;
+		if( text && SpeechEnabled( access_speech_hud ) )
+			Access_Speak( text );
+		return;
+	}
+}
+
+static void Access_Cmd_Status( void )
+{
+	char buf[256];
+	int o = 0;
+
+	o += snprintf( buf + o, sizeof( buf ) - o, "Santé %d, armure %d", s_iHealth < 0 ? 0 : s_iHealth, s_iArmor < 0 ? 0 : s_iArmor );
+	if( s_iMoney >= 0 && o < (int)sizeof( buf ) )
+		o += snprintf( buf + o, sizeof( buf ) - o, ", %d dollars", s_iMoney );
+	if( s_szWeapon[0] && o < (int)sizeof( buf ) )
+	{
+		if( s_iClip >= 0 )
+			snprintf( buf + o, sizeof( buf ) - o, ", %s, %d balles, réserve %d", s_szWeapon, s_iClip, s_iReserve );
+		else
+			snprintf( buf + o, sizeof( buf ) - o, ", %s", s_szWeapon );
+	}
+
+	// Explicit request: speak even if HUD announcements are muted.
+	if( access_speech && access_speech->value )
+	{
+		char clean[256];
+		CleanForSpeech( buf, clean, sizeof( clean ) );
+		SpeakRaw( clean, true );
+	}
+}
+
+static void Access_Cmd_Repeat( void )
+{
+	if( s_szLastSpoken[0] && access_speech && access_speech->value )
+	{
+		char copy[sizeof( s_szLastSpoken )];
+		strcpy( copy, s_szLastSpoken );
+		SpeakRaw( copy, true );
+	}
+}
+
+static void Access_Cmd_Say( void )
+{
+	char buf[512];
+	buf[0] = 0;
+	for( int i = 1; i < gEngfuncs.Cmd_Argc(); i++ )
+	{
+		if( i > 1 )
+			strncat( buf, " ", sizeof( buf ) - strlen( buf ) - 1 );
+		strncat( buf, gEngfuncs.Cmd_Argv( i ), sizeof( buf ) - strlen( buf ) - 1 );
+	}
+	Access_Speak( buf, true );
+}
+
+static void Access_Cmd_Silence( void )
+{
+	AccessTts_Cancel();
+}
+
+void Access_Init( void )
+{
+	access_speech       = CVAR_CREATE( "access_speech", "1", FCVAR_ARCHIVE );
+	access_speech_chat  = CVAR_CREATE( "access_speech_chat", "1", FCVAR_ARCHIVE );
+	access_speech_kills = CVAR_CREATE( "access_speech_kills", "1", FCVAR_ARCHIVE );
+	access_speech_hud   = CVAR_CREATE( "access_speech_hud", "1", FCVAR_ARCHIVE );
+	access_textmenus    = CVAR_CREATE( "access_textmenus", "1", FCVAR_ARCHIVE );
+	access_debug        = CVAR_CREATE( "access_debug", "0", FCVAR_ARCHIVE );
+
+	gEngfuncs.pfnAddCommand( "access_status", Access_Cmd_Status );
+	gEngfuncs.pfnAddCommand( "access_repeat", Access_Cmd_Repeat );
+	gEngfuncs.pfnAddCommand( "access_say", Access_Cmd_Say );
+	gEngfuncs.pfnAddCommand( "access_silence", Access_Cmd_Silence );
+
+	AccessNav_Init();
+	AccessScreens_Init();
+}
