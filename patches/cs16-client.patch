+// weapon_ak47 / ak47 -> readable name.
+const char *Access_WeaponName( const char *name )
+{
+	static const struct { const char *id; const char *spoken; } table[] =
+	{
+		{ "p228", "P228" }, { "glock18", "Glock 18" }, { "glock", "Glock 18" }, { "usp", "USP" },
+		{ "deagle", "Desert Eagle" }, { "elite", "Dual Berettas" }, { "fiveseven", "Five-SeveN" },
+		{ "m3", "fusil à pompe M3" }, { "xm1014", "fusil à pompe XM1014" },
+		{ "mac10", "MAC-10" }, { "tmp", "TMP" }, { "mp5navy", "MP5" }, { "ump45", "UMP 45" }, { "p90", "P90" },
+		{ "galil", "Galil" }, { "famas", "FAMAS" }, { "ak47", "AK-47" }, { "m4a1", "M4A1" },
+		{ "sg552", "SG 552" }, { "aug", "AUG" }, { "scout", "Scout" }, { "awp", "AWP" },
+		{ "g3sg1", "G3SG1" }, { "sg550", "SG 550" }, { "m249", "mitrailleuse M249" },
+		{ "knife", "couteau" }, { "hegrenade", "grenade explosive" }, { "flashbang", "grenade flash" },
+		{ "smokegrenade", "grenade fumigène" }, { "c4", "bombe C4" },
+		{ "grenade", "grenade" }, { "worldspawn", "chute" }, { "trigger_hurt", "environnement" },
+	};
+
+	if( !name )
+		return "";
+	if( !strncmp( name, "weapon_", 7 ) )
+		name += 7;
+	for( size_t i = 0; i < ACCESS_ARRAYSIZE( table ); i++ )
+	{
+		if( !stricmp( name, table[i].id ) )
+			return table[i].spoken;
+	}
+	return name;
+}
+
+void Access_OnHealth( int health )
+{
+	AccessNav_OnHealth( health );
+	if( s_iHealth <= 0 && health > 0 )
+		s_flSpawnTime = gHUD.m_flTime;
+	if( health == s_iHealth )
+		return;
+	s_iHealth = health;
+	if( health <= 0 || Access_IsSpectating() )
+		return; // death is announced by the death notice
+
+	char buf[64];
+	snprintf( buf, sizeof( buf ), "Santé %d", health );
+	SpeakCoalesced( ACCESS_SLOT_HEALTH, buf );
+}
+
+void Access_OnArmor( int armor )
+{
+	if( armor == s_iArmor )
+		return;
+	s_iArmor = armor;
+	if( Access_IsSpectating() )
+		return;
+
+	char buf[64];
+	snprintf( buf, sizeof( buf ), "Armure %d", armor );
+	SpeakCoalesced( ACCESS_SLOT_ARMOR, buf );
+}
+
+void Access_OnMoney( int money, int delta )
+{
+	const bool firstUpdate = s_iMoney < 0;
+	s_iMoney = money;
+	if( delta == 0 || firstUpdate )
+		return;
+
+	char buf[96];
+	snprintf( buf, sizeof( buf ), "%s%d dollars, total %d", delta > 0 ? "plus " : "moins ", delta > 0 ? delta : -delta, money );
+	SpeakCoalesced( ACCESS_SLOT_MONEY, buf );
+}
+
+void Access_OnWeaponSelected( const char *weaponName, int clip, int reserve )
+{
+	const char *spoken = Access_WeaponName( weaponName );
+	const bool changed = strcmp( s_szWeapon, spoken ) != 0;
+
+	// Same weapon, magazine refilled by more than one round: a reload ended
+	// (shotguns load shell by shell and stay quiet). Out of ammo entirely: say it.
+	if( !changed && !Access_IsSpectating() && SpeechEnabled( access_speech_hud ))
+	{
+		if( s_iClip >= 0 && clip > s_iClip + 1 )
+		{
+			char buf[64];
+			snprintf( buf, sizeof( buf ), "Rechargé, %d balles", clip );
+			Access_Speak( buf );
+		}
+		else if( clip == 0 && reserve == 0 && ( s_iClip != 0 || s_iReserve != 0 ))
+			Access_Speak( "Plus de munitions, changez d'arme", true );
+	}
+
+	strncpy( s_szWeapon, spoken, sizeof( s_szWeapon ) - 1 );
+	s_szWeapon[sizeof( s_szWeapon ) - 1] = 0;
+	s_iClip = clip;
+	s_iReserve = reserve;
+	AccessNav_OnClip( changed, clip );
+
+	if( !changed || !SpeechEnabled( access_speech_hud ) || Access_IsSpectating() )
+		return;
+
+	char buf[160];
+	if( clip >= 0 )
+		snprintf( buf, sizeof( buf ), "%s, %d balles, réserve %d", spoken, clip, reserve );
+	else
+		snprintf( buf, sizeof( buf ), "%s", spoken );
+	Access_Speak( buf, true );
+}
+
+void Access_OnChatLine( const char *line )
+{
+	if( !SpeechEnabled( access_speech_chat ) || !line )
+		return;
+
+	// Server-formatted chat keeps the English status tags: say them in French.
+	static const struct { const char *tag; const char *spoken; } tags[] =
+	{
+		{ "*DEAD*", "(mort)" }, { "*SPEC*", "(spectateur)" },
+		{ "(Counter-Terrorist)", "(antiterroriste)" }, { "(Terrorist)", "(terroriste)" },
+		{ "(Spectator)", "(spectateur)" },
+	};
+	char buf[1024];
+	size_t o = 0;
+	for( const char *p = line; *p && o + 1 < sizeof( buf ); )
+	{
+		bool replaced = false;
+		for( size_t i = 0; i < ACCESS_ARRAYSIZE( tags ) && !replaced; i++ )
+		{
+			const size_t len = strlen( tags[i].tag );
+			if( strncmp( p, tags[i].tag, len ))
+				continue;
+			o += snprintf( buf + o, sizeof( buf ) - o, "%s", tags[i].spoken );
+			if( o >= sizeof( buf ))
+				o = sizeof( buf ) - 1;
+			p += len;
+			replaced = true;
+		}
+		if( !replaced )
+			buf[o++] = *p++;
+	}
+	buf[o] = 0;
+	Access_Speak( buf );
+}
+
+void Access_OnCenterMessage( const char *message )
+{
+	if( SpeechEnabled( NULL ) )
+		Access_Speak( message );
+}
+
+void Access_OnMenu( const char *menu )
+{
+	if( SpeechEnabled( NULL ) )
+		Access_Speak( menu, true );
+}
