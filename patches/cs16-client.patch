@@ -0,0 +1,12 @@
+/*
+access_screens.h - spoken versions of the HUD screens that only exist visually:
+scoreboard, round timer, MOTD, hint texts, aim status bar, spectator, intermission
+*/
+#pragma once
+
+void AccessScreens_Init( void );
+void AccessScreens_Frame( void );
+
+void AccessScreens_OnHudText( const char *text );
+void AccessScreens_OnStatusBar( const char *text );
+void AccessScreens_OnMotd( const char *text );
diff --git a/cl_dll/accessibility/access_speech.cpp b/cl_dll/accessibility/access_speech.cpp
new file mode 100644
index 0000000..47f2373
--- /dev/null
+++ b/cl_dll/accessibility/access_speech.cpp
@@ -0,0 +1,724 @@
+/*
+access_speech.cpp - screen reader (NVDA) announcements for blind players
+
+Speech goes through access_tts (NVDA controller, loaded at runtime), so the
+client still works when NVDA is missing: announcements are then dropped.
+*/
+
+#include "hud.h"
