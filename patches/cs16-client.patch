+
+static void UpdateGuidance( void )
+{
+	if( !s_szTargetName[0] )
+		return;
+
+	RebuildTargets();
+	const Target *t = CurrentTarget();
+	if( !t )
+	{
+		StopGuidance();	// e.g. the dropped bomb was picked up
+		return;
+	}
+
+	const Vector feet( s_L.origin.x, s_L.origin.y, s_L.feetZ );
+	const float toGoal = ( t->pos - feet ).Length2D();
+	if( toGoal < 90.0f && fabsf( t->pos.z - feet.z ) < 120.0f )
+	{
+		Play( CUE_ARRIVED, Centered( 0.9f ) );
+		char buf[96];
+		snprintf( buf, sizeof( buf ), "Arrivé : %s", t->name );
+		Access_Speak( buf );
+		StopGuidance();
+		return;
+	}
+
+	if( s_Path.empty() || s_flTime >= s_flNextRepath )
+		Repath( *t );
+
+	// Drop waypoints we have reached.
+	while( s_iPathNext + 1 < s_Path.size() && ( FromAccess( s_Path[s_iPathNext] ) - feet ).Length2D() < 56.0f )
+		s_iPathNext++;
+
+	// Far off the path (fell, got pushed): recompute now.
+	if( ( FromAccess( s_Path[s_iPathNext] ) - feet ).Length2D() > 450.0f )
+		Repath( *t );
+
+	// Beacon on the farthest of the next few waypoints still in line of sight,
+	// so the sound leads around corners instead of into walls.
+	size_t aim = s_iPathNext;
+	for( size_t i = s_iPathNext + 1; i < s_Path.size() && i <= s_iPathNext + 4; i++ )
+	{
+		const Vector wp = FromAccess( s_Path[i] ) + Vector( 0.0f, 0.0f, 36.0f );
+		if( !LineOfSight( s_L.eye, wp ) )
+			break;
+		aim = i;
+	}
+
+	if( s_flTime < s_flNextBeacon )
+		return;
+
+	const Vector beacon = FromAccess( s_Path[aim] ) + Vector( 0.0f, 0.0f, 36.0f );
+	const float dist = ( beacon - s_L.eye ).Length();
+	// The bomb gets its own timbre so it is never confused with a route point.
+	Play( t->dynamic ? CUE_OBJECTIVE : CUE_BEACON, Spatial( beacon, 0.0f, 0.75f ) );
+	s_flNextBeacon = s_flTime + ( dist < 200.0f ? 0.35f : ( dist > 800.0f ? 1.1f : 0.35f + 0.75f * ( dist - 200.0f ) / 600.0f ) );
+}
+
+// ---------------------------------------------------------------------------
+// Players: visible enemies, nearby teammates, aim assistance tone
+// ---------------------------------------------------------------------------
+
+struct PlayerTrack
+{
+	bool visible;
+	float nextCue;
+	float nextCheck;
+	// Hearing: speed estimate and cue pacing for players heard out of sight.
+	Vector prevOrigin;
+	float prevTime;
+	float nextStep;
+	float nextShot;
+};
+
+static PlayerTrack s_Players[MAX_PLAYERS + 1];
+static float s_flNextAim;
+static bool s_bBlind;	// flashed: enemies are not "seen" (hearing still works)
+
+// How far the game's own sounds carry, roughly (units).
+static const float HEARING_STEPS_RANGE = 1000.0f;
+static const float HEARING_SHOTS_RANGE = 3000.0f;
+
+// The game plays footsteps for a player running (walking and crouching are
+// silent), and a sighted player hears them through walls too: enemies heard but
+// not in sight get a footstep cue at their position.
+static void UpdateFootsteps( PlayerTrack &track, const cl_entity_t *ent )
+{
+	const Vector pos = ent->origin;
+	const float dt = s_flTime - track.prevTime;
+	if( track.prevTime <= 0.0f || dt <= 0.0f || dt > 0.5f )
+	{
+		track.prevOrigin = pos;
+		track.prevTime = s_flTime;
+		return;
+	}
+	if( dt < 0.05f )
+		return;	// measure the speed over at least 50 ms
+
+	Vector delta = pos - track.prevOrigin;
+	const float climb = fabsf( delta.z ) / dt;
+	delta.z = 0.0f;
+	const float speed = delta.Length() / dt;
+	track.prevOrigin = pos;
+	track.prevTime = s_flTime;
+
+	if( !access_hearing || !access_hearing->value || track.visible )
+		return;
+	// Below running speed: silent. Far above, or falling fast: a jump or respawn.
+	if( speed < 150.0f || speed > 400.0f || climb > 250.0f )
+		return;
+	if( ( pos - s_L.eye ).Length() > HEARING_STEPS_RANGE || s_flTime < track.nextStep )
+		return;
+	Play( CUE_FOOTSTEP, Spatial( pos, HEARING_STEPS_RANGE, 0.7f ) );
+	track.nextStep = s_flTime + 0.33f;
+}
+
+static cl_entity_t *PlayerEntityIfInView( int i, cl_entity_t *local )
+{
+	cl_entity_t *ent = gEngfuncs.GetEntityByIndex( i );
+	if( !ent || !ent->player || ent == local || !ent->model )
+		return NULL;
+	if( ent->curstate.messagenum < local->curstate.messagenum )
+		return NULL;	// not in our PVS this frame
+	if( g_PlayerExtraInfo[i].dead )
+		return NULL;
+	return ent;
+}
+
+static void UpdatePlayers( cl_entity_t *local )
+{
+	const bool wantEnemies = access_enemies && access_enemies->value;
+	const bool wantTeam = access_teammates && access_teammates->value;
+	const bool wantAim = access_aimcue && access_aimcue->value;
+	const float fov = access_enemy_fov && access_enemy_fov->value > 0.0f ? access_enemy_fov->value : 360.0f;
+
+	struct Visible { int index; float dist; Vector chest; };
+	Visible visible[MAX_PLAYERS];
+	int visibleCount = 0;
+
+	const int maxClients = gEngfuncs.GetMaxClients() < MAX_PLAYERS ? gEngfuncs.GetMaxClients() : MAX_PLAYERS;
+	for( int i = 1; i <= maxClients; i++ )
+	{
+		PlayerTrack &track = s_Players[i];
+		cl_entity_t *ent = PlayerEntityIfInView( i, local );
+		const int team = g_PlayerExtraInfo[i].teamnumber;
+		if( !ent || team == 0 || s_L.team == 0 )
+		{
+			track.visible = false;
+			track.prevTime = 0.0f;
+			continue;
+		}
+		if( team != s_L.team )
+			UpdateFootsteps( track, ent );
+
+		const Vector chest = ent->origin + Vector( 0.0f, 0.0f, 8.0f );
+		const float dist = ( chest - s_L.eye ).Length();
+
+		if( team == s_L.team )
+		{
+			if( wantTeam && dist < 350.0f && s_flTime >= track.nextCue )
+			{
+				Play( CUE_TEAMMATE, Spatial( chest, 350.0f, 0.35f ) );
+				track.nextCue = s_flTime + 1.2f;
+			}
+			continue;
+		}
+
+		if( !wantEnemies && !wantAim )
+			continue;
+
+		// Line-of-sight checks are the expensive part: 10 Hz per player.
+		if( s_flTime >= track.nextCheck )
+		{
+			track.nextCheck = s_flTime + 0.1f;
+			const bool inFov = fov >= 360.0f || fabsf( RelativeYaw( chest ) ) <= fov * 0.5f;
+			const Vector head = ent->origin + Vector( 0.0f, 0.0f, 26.0f );
+			const bool nowVisible = !s_bBlind && inFov && ( LineOfSight( s_L.eye, chest ) || LineOfSight( s_L.eye, head ) );
+
+			if( nowVisible && !track.visible && wantEnemies )
+			{
+				Play( CUE_ENEMY_SPOTTED, Spatial( chest, 0.0f, 0.9f ) );
+				track.nextCue = s_flTime + 0.35f;
+			}
+			track.visible = nowVisible;
+		}
+
+		if( track.visible && visibleCount < MAX_PLAYERS )
+		{
+			visible[visibleCount].index = i;
+			visible[visibleCount].dist = dist;
+			visible[visibleCount].chest = chest;
+			visibleCount++;
+		}
+	}
+
+	// Speech when enemies come into view after none were: direction and
+	// distance of the closest one (the blip alone says "left", not "how far").
+	static int s_iPrevVisible;
+	static float s_flNextSpottedSpeech;
+	if( wantEnemies && visibleCount > 0 && s_iPrevVisible == 0 && s_flTime >= s_flNextSpottedSpeech &&
+		access_speech_spotted && access_speech_spotted->value )
+	{
+		int nearest = 0;
+		for( int v = 1; v < visibleCount; v++ )
+			if( visible[v].dist < visible[nearest].dist )
+				nearest = v;
+		char buf[96];
+		snprintf( buf, sizeof( buf ), "%s, %s, %s%s", visibleCount > 1 ? "Ennemis" : "Ennemi",
+			ClockText( RelativeYaw( visible[nearest].chest )), MetersText( visible[nearest].dist ),
+			ElevationText( visible[nearest].chest ));
+		Access_Speak( buf, true );
+		s_flNextSpottedSpeech = s_flTime + 3.0f;
+	}
+	s_iPrevVisible = visibleCount;
+
+	// Pulse the three closest visible enemies; closer = faster.
+	for( int pass = 0; pass < 3 && wantEnemies; pass++ )
+	{
+		int best = -1;
+		for( int v = 0; v < visibleCount; v++ )
+			if( visible[v].index > 0 && ( best < 0 || visible[v].dist < visible[best].dist ) )
+				best = v;
+		if( best < 0 )
+			break;
+
+		PlayerTrack &track = s_Players[visible[best].index];
+		if( s_flTime >= track.nextCue )
+		{
+			Play( CUE_ENEMY, Spatial( visible[best].chest, 2500.0f, 0.8f ) );
+			const float d = visible[best].dist;
+			track.nextCue = s_flTime + ( d < 300.0f ? 0.3f : ( d > 1500.0f ? 1.0f : 0.3f + 0.7f * ( d - 300.0f ) / 1200.0f ) );
+		}
+		visible[best].index = -visible[best].index;	// mark used
+	}
+	for( int v = 0; v < visibleCount; v++ )
+		if( visible[v].index < 0 )
+			visible[v].index = -visible[v].index;
+
+	// Aim tone for the visible enemy closest to the crosshair.
+	if( !wantAim || visibleCount == 0 || s_flTime < s_flNextAim )
+		return;
+
+	const float cone = access_aim_cone && access_aim_cone->value > 1.0f ? access_aim_cone->value : 30.0f;
+	float bestErr = 1e9f;
+	int bestV = -1;
+	for( int v = 0; v < visibleCount; v++ )
+	{
+		Vector to = visible[v].chest - s_L.eye;
+		to = to.Normalize();
+		const float cosErr = DotProduct( to, s_L.forward );
+		const float err = acosf( cosErr > 1.0f ? 1.0f : ( cosErr < -1.0f ? -1.0f : cosErr ) ) * RAD2DEG;
+		if( err < bestErr )
+		{
+			bestErr = err;
+			bestV = v;
+		}
+	}
+	if( bestV < 0 || bestErr > cone )
+		return;
+
+	// Roughly the angular half-width of a player's torso at that range.
+	const float lockAngle = atan2f( 14.0f, visible[bestV].dist ) * RAD2DEG;
+	const float relYaw = RelativeYaw( visible[bestV].chest );
+	if( bestErr <= ( lockAngle > 1.0f ? lockAngle : 1.0f ) )
+	{
+		Play( CUE_AIM_LOCK, Centered( 0.8f ) );
+		s_flNextAim = s_flTime + 0.11f;
+	}
+	else
+	{
+		AccessCueParams p = SpatialFromRelYaw( relYaw, 0.55f );
+		p.muffle = 0.0f;
+		p.pitch = 0.8f + 1.4f * ( 1.0f - bestErr / cone );
+		Play( CUE_AIM, p );
+		s_flNextAim = s_flTime + 0.06f + bestErr * 0.01f;
+	}
+}
+
+void AccessNav_OnGunshot( int entindex, const float *muzzle )
+{
+	// Gunfire carries far and through walls for everyone: enemy shots are heard.
+	if( !access_hearing || !access_hearing->value || !muzzle || s_L.team == 0 )
+		return;
+	if( entindex <= 0 || entindex > MAX_PLAYERS || entindex == s_L.index )
+		return;
+	if( g_PlayerExtraInfo[entindex].teamnumber == s_L.team || gHUD.m_fPlayerDead || g_iUser1 )
+		return;
+
+	const Vector src( muzzle[0], muzzle[1], muzzle[2] );
+	PlayerTrack &track = s_Players[entindex];
+	if( ( src - s_L.eye ).Length() > HEARING_SHOTS_RANGE || s_flTime < track.nextShot )
+		return;
+	track.nextShot = s_flTime + 0.25f;	// automatic fire: a few cues per second
+	Play( CUE_GUNSHOT, Spatial( src, HEARING_SHOTS_RANGE, 0.8f ) );
+}
+
+void AccessNav_OnShotTrace( int entindex, int hitgroup )
+{
+	// A sighted shooter sees blood and the target flinch: a knock says the same
+	// (a higher one for the head). Nothing aims or fires for the player.
+	if( entindex <= 0 || entindex > gEngfuncs.GetMaxClients() || entindex == s_L.index )
+		return;
+	const int team = g_PlayerExtraInfo[entindex].teamnumber;
+	if( team == 0 || team == s_L.team || g_PlayerExtraInfo[entindex].dead )
+		return;
+	static float s_flLastHit;
+	if( s_flTime - s_flLastHit < 0.05f && s_flTime >= s_flLastHit )
+		return;
+	s_flLastHit = s_flTime;
+	AccessCueParams p = Centered( 0.8f );
+	p.pitch = hitgroup == 1 ? 1.6f : 1.0f;
+	Play( CUE_HIT, p );
+}
+
+// ---------------------------------------------------------------------------
+// Items on the ground (weapons, bomb, defuse kit, hostages)
+// ---------------------------------------------------------------------------
+
+struct ItemSighting
+{
+	int index;
+	Vector pos;
+	float dist;
+	bool important;	// the bomb: spoken when first seen
+	char name[48];
+};
+
+static std::vector<ItemSighting> s_Items;	// in sight, closest first
+static float s_flNextItemScan;
+static float s_flNextItemCue;
+static int s_iAnnouncedBomb = -1;
+
+static const float ITEM_RANGE = 1000.0f;	// listed with the item key (25 m)
+static const float ITEM_CUE_RANGE = 400.0f;	// chimes (10 m)
+
+static bool ItemName( const cl_entity_t *ent, char *out, size_t size, bool *important )
+{
+	*important = false;
+	if( !ent->model || ent->model->type != mod_studio || ent->player )
+		return false;
+	if( ent->curstate.effects & EF_NODRAW )
+		return false;
+	if( ent->curstate.movetype == MOVETYPE_BOUNCE )
+		return false;	// grenade in flight: announced by the grenade tracker
+
+	const char *base = strrchr( ent->model->name, '/' );
+	base = base ? base + 1 : ent->model->name;
+
+	if( !strcmp( base, "w_backpack.mdl" ))
+	{
+		snprintf( out, size, "bombe au sol" );
+		*important = true;
+	}
+	else if( !strcmp( base, "w_c4.mdl" ))
+	{
+		snprintf( out, size, "bombe posée" );
+		*important = true;
+	}
+	else if( !strcmp( base, "w_thighpack.mdl" ))
+		snprintf( out, size, "kit de désamorçage" );
+	else if( !strcmp( base, "w_shield.mdl" ))
+		snprintf( out, size, "bouclier" );
+	else if( !strncmp( base, "hostage", 7 ) || !strcmp( base, "scientist.mdl" ))
+		snprintf( out, size, "otage" );
+	else if( !strncmp( base, "w_", 2 ))
+	{
+		char id[32];
+		snprintf( id, sizeof( id ), "%s", base + 2 );
+		if( char *dot = strchr( id, '.' ))
+			*dot = 0;
+		snprintf( out, size, "%s", Access_WeaponName( !strcmp( id, "mp5" ) ? "mp5navy" : id ));
+	}
+	else
+		return false;
+	return true;
+}
+
+static bool CloserItem( const ItemSighting &a, const ItemSighting &b )
+{
+	return a.dist < b.dist;
+}
+
+static void UpdateItems( cl_entity_t *local )
+{
+	if( s_flTime >= s_flNextItemScan )
+	{
+		s_flNextItemScan = s_flTime + 0.25f;
+		s_Items.clear();
+		bool bombInSight = false;
+		for( int i = gEngfuncs.GetMaxClients() + 1; i < 2048; i++ )
+		{
+			cl_entity_t *ent = gEngfuncs.GetEntityByIndex( i );
+			if( !ent )
+				break;
+			if( ent->curstate.messagenum < local->curstate.messagenum )
+				continue;
+			ItemSighting s;
+			if( !ItemName( ent, s.name, sizeof( s.name ), &s.important ))
+				continue;
+			s.pos = ent->origin + Vector( 0.0f, 0.0f, 4.0f );
+			s.dist = ( s.pos - s_L.eye ).Length();
+			// Fair play: only what the screen would show.
+			if( s.dist > ITEM_RANGE || !LineOfSight( s_L.eye, s.pos ))
+				continue;
+			s.index = i;
+			s_Items.push_back( s );
+
+			if( s.important )
+			{
+				bombInSight = true;
+				if( s_iAnnouncedBomb != i )
+				{
+					char buf[128];
+					snprintf( buf, sizeof( buf ), "%s en vue, %s, %s", s.name, ClockText( RelativeYaw( s.pos )), MetersText( s.dist ));
+					buf[0] = buf[0] - 'a' + 'A';	// "bombe..." starts the sentence
+					Access_Speak( buf );
+					s_iAnnouncedBomb = i;
+				}
+			}
+		}
+		if( !bombInSight && s_Items.empty() )
+			s_iAnnouncedBomb = -1;
+		std::sort( s_Items.begin(), s_Items.end(), CloserItem );
+	}
+
+	// Chime the closest item in reach; faster and brighter when almost on it.
+	if( !access_items || !access_items->value || s_Items.empty() || s_flTime < s_flNextItemCue )
+		return;
+	const ItemSighting &closestItem = s_Items[0];
+	if( closestItem.dist > ITEM_CUE_RANGE )
+		return;
+	AccessCueParams p = Spatial( closestItem.pos, ITEM_CUE_RANGE, 0.45f );
+	if( closestItem.dist < 64.0f )
+		p.pitch *= 1.25f;
+	Play( CUE_ITEM, p );
+	s_flNextItemCue = s_flTime + ( closestItem.dist < 128.0f ? 0.8f : 1.5f );
+}
+
+// ---------------------------------------------------------------------------
+// Map features: ladders and doors nearby, water, slopes and stairs
+// ---------------------------------------------------------------------------
+
+struct FeatureState
+{
+	bool inRange;	// announced, in sight
+	float nextCue;
+};
+
+static std::vector<FeatureState> s_FeatureStates;
+static float s_flNextFeatureScan;
+static int s_iWaterLevel;		// 0 dry, 1 feet in liquid, 2 head under
+static float s_flNextWaterCheck;
+static int s_iSlope;			// +1 going up, -1 going down, 0 flat
+static float s_flSlopeSince;
+static float s_flNextSlopeCheck;
+static bool s_bOnLadder;
+
+static const float FEATURE_NEAR = 250.0f;	// announced when closer (6 m)
+static const float FEATURE_FAR = 400.0f;	// forgotten when farther (10 m)
+
+// Closest point of a feature's box, and its distance from p.
+static float FeatureDistance( const AccessFeature &f, const Vector &p, Vector &closest )
+{
+	closest.x = p.x < f.mins.x ? f.mins.x : ( p.x > f.maxs.x ? f.maxs.x : p.x );
+	closest.y = p.y < f.mins.y ? f.mins.y : ( p.y > f.maxs.y ? f.maxs.y : p.y );
+	closest.z = p.z < f.mins.z ? f.mins.z : ( p.z > f.maxs.z ? f.maxs.z : p.z );
+	return ( closest - p ).Length();
+}
+
+static const char *FeatureName( AccessFeatureType type )
+{
+	switch( type )
+	{
+	case FEAT_LADDER: return "Échelle";
+	case FEAT_DOOR: return "Porte";
+	default: return NULL;
+	}
+}
+
+// The trace must stop short of the feature's own surface (doors are solid).
+static bool FeatureInSight( const Vector &closest )
+{
+	Vector toEye = s_L.eye - closest;
+	const float len = toEye.Length();
+	if( len < 1.0f )
+		return true;
+	return LineOfSight( s_L.eye, closest + toEye * ( 8.0f / len ));
+}
+
+static void UpdateFeatures( void )
+{
+	if( !access_features || !access_features->value || s_flTime < s_flNextFeatureScan )
+		return;
+	s_flNextFeatureScan = s_flTime + 0.3f;
+
+	const std::vector<AccessFeature> &features = AccessMap_Features();
+	if( s_FeatureStates.size() != features.size() )
+		s_FeatureStates.assign( features.size(), FeatureState() );
+
+	for( size_t i = 0; i < features.size(); i++ )
+	{
+		const char *name = FeatureName( features[i].type );
+		if( !name )
+			continue;
+		FeatureState &st = s_FeatureStates[i];
+		Vector closest;
+		const float dist = FeatureDistance( features[i], s_L.eye, closest );
+		if( dist > FEATURE_FAR )
+		{
+			st.inRange = false;
+			continue;
+		}
+		if( dist > FEATURE_NEAR || !FeatureInSight( closest ))
+			continue;
+
+		const AccessCue cue = features[i].type == FEAT_LADDER ? CUE_LADDER : CUE_DOOR;
+		if( !st.inRange )
+		{
+			char buf[96];
+			snprintf( buf, sizeof( buf ), "%s, %s, %s", name, ClockText( RelativeYaw( closest )), MetersText( dist ));
+			Access_Speak( buf );
+			st.inRange = true;
+			st.nextCue = 0.0f;
+		}
+		// Ladders keep sounding while near, to find and grab them; doors once.
+		if( s_flTime >= st.nextCue && ( features[i].type == FEAT_LADDER || st.nextCue == 0.0f ))
+		{
+			Play( cue, Spatial( closest, FEATURE_NEAR, 0.6f ));
+			st.nextCue = s_flTime + 2.0f;
+		}
+	}
+}
+
+static bool IsLiquid( const Vector &p )
+{
+	Vector q = p;
+	const int contents = gEngfuncs.PM_PointContents( q, NULL );
+	return contents == CONTENTS_WATER || contents == CONTENTS_SLIME || contents == CONTENTS_LAVA;
+}
+
+static void UpdateWaterAndLadder( cl_entity_t *local )
+{
+	if( !access_features || !access_features->value )
+		return;
+
+	const bool onLadder = local->curstate.movetype == MOVETYPE_FLY;
+	if( onLadder != s_bOnLadder )
+	{
+		Access_Speak( onLadder ? "Sur l'échelle, avancez en regardant en haut ou en bas" : "Hors de l'échelle" );
+		s_bOnLadder = onLadder;
+	}
+
+	if( s_flTime < s_flNextWaterCheck )
+		return;
+	s_flNextWaterCheck = s_flTime + 0.2f;
+	const int level = IsLiquid( s_L.eye ) ? 2 : ( IsLiquid( Vector( s_L.origin.x, s_L.origin.y, s_L.feetZ + 4.0f )) ? 1 : 0 );
+	if( level == s_iWaterLevel )
+		return;
+	static const char *const text[3][3] =
+	{
+		// from dry, from feet in water, from head under
+		{ NULL, "Hors de l'eau", "Hors de l'eau" },
+		{ "Dans l'eau", NULL, "Tête hors de l'eau" },
+		{ "Sous l'eau", "Sous l'eau", NULL },
+	};
+	if( text[level][s_iWaterLevel] )
+		Access_Speak( text[level][s_iWaterLevel] );
+	if( level > s_iWaterLevel )
+		Play( CUE_WATER, Centered( 0.6f ));
+	s_iWaterLevel = level;
+}
+
+// Ground height under a point, or false over a drop.
+static bool GroundZ( const Vector &at, float &z )
+{
+	Vector hit;
+	const Vector top( at.x, at.y, s_L.feetZ + 24.0f );
+	const Vector bottom( at.x, at.y, s_L.feetZ - 48.0f );
+	if( TraceDistance( top, bottom, &hit ) >= 71.0f )
+		return false;
+	z = hit.z;
+	return true;
+}
+
+// Rising or falling ground along the walking direction (stairs, ramps): said
+// once when it starts, again only after some flat ground.
+static void UpdateSlope( void )
+{
+	if( !access_features || !access_features->value || s_flTime < s_flNextSlopeCheck )
+		return;
+	s_flNextSlopeCheck = s_flTime + 0.25f;
+	if( s_flSpeed < 60.0f || s_bOnLadder || s_iWaterLevel )
+		return;
+
+	float z[4];
+	for( int k = 0; k < 4; k++ )
+	{
+		const Vector at = s_L.origin + s_vecMoveDir * ( 20.0f + 24.0f * k );
+		if( !GroundZ( at, z[k] ))
+			return;	// a drop: the ledge detector speaks for it
+	}
+	int up = 0, down = 0;
+	for( int k = 1; k < 4; k++ )
+	{
+		const float d = z[k] - z[k - 1];
+		if( d >= 3.0f && d <= 20.0f )
+			up++;
+		else if( d <= -3.0f && d >= -20.0f )
+			down++;
+	}
+	const int slope = up >= 2 ? 1 : ( down >= 2 ? -1 : 0 );
+	if( slope != 0 && slope != s_iSlope )
+	{
+		Access_Speak( slope > 0 ? "Montée" : "Descente" );
+		s_iSlope = slope;
+		s_flSlopeSince = s_flTime;
+	}
+	else if( slope == 0 && s_iSlope != 0 && s_flTime - s_flSlopeSince > 1.5f )
+		s_iSlope = 0;
+	else if( slope != 0 )
+		s_flSlopeSince = s_flTime;
+}
