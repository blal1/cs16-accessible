diff --git a/cl_dll/accessibility/access_tts.c b/cl_dll/accessibility/access_tts.c
new file mode 100644
index 0000000..ce7f9a8
--- /dev/null
+++ b/cl_dll/accessibility/access_tts.c
@@ -0,0 +1,148 @@
+/*
+access_tts.c - minimal screen reader output (NVDA controller client)
+*/
+
+#include "access_tts.h"
+
+#ifdef _WIN32
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+// Optional transcript: when ACCESS_TTS_LOG names a file, every utterance is
+// appended to it (used by the automated menu tests, and handy for debugging).
+static void LogUtterance( const char *utf8, int interrupt )
+{
+	static int checked;
+	static char path[MAX_PATH];
+	FILE *f;
+
+	if( !checked )
+	{
+		const char *env = getenv( "ACCESS_TTS_LOG" );
+		checked = 1;
+		if( env )
+			snprintf( path, sizeof( path ), "%s", env );
+	}
+	if( !path[0] )
+		return;
+	f = fopen( path, "ab" );
+	if( !f )
+		return;
+	// "! " interrupting speech, "  " queued speech, "# " diagnostic only
+	fprintf( f, "%s%s\n", interrupt == 2 ? "# " : ( interrupt ? "! " : "  " ), utf8 );
+	fclose( f );
+}
+
+typedef unsigned long ( __stdcall *nvdaSpeakText_t )( const wchar_t *text );
+typedef unsigned long ( __stdcall *nvdaCancelSpeech_t )( void );
+
+static int s_loadTried;
+static nvdaSpeakText_t s_pfnSpeakText;
+static nvdaCancelSpeech_t s_pfnCancelSpeech;
+
+static void LoadNvda( void )
+{
+	HMODULE self = NULL, lib = NULL;
+	wchar_t path[MAX_PATH];
+
+	if( s_loadTried )
+		return;
+	s_loadTried = 1;
+
+	// Next to the calling module first (cl_dlls\ for client and menu, engine dir for xash.dll).
+	if( GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+		(LPCWSTR)&LoadNvda, &self ) )
+	{
+		DWORD len = GetModuleFileNameW( self, path, MAX_PATH );
+		wchar_t *slash = len > 0 && len < MAX_PATH ? wcsrchr( path, L'\\' ) : NULL;
+		if( slash && ( slash - path ) + 32 < MAX_PATH )
+		{
+			wcscpy( slash + 1, L"nvdaControllerClient.dll" );
+			lib = LoadLibraryW( path );
+		}
+	}
+	if( !lib )
+		lib = LoadLibraryW( L"nvdaControllerClient.dll" );
+	if( !lib )
+		return;
+
+	s_pfnSpeakText = (nvdaSpeakText_t)GetProcAddress( lib, "nvdaController_speakText" );
+	s_pfnCancelSpeech = (nvdaCancelSpeech_t)GetProcAddress( lib, "nvdaController_cancelSpeech" );
+	if( !s_pfnSpeakText )
+		FreeLibrary( lib );
+}
+
+void AccessTts_Log( const char *utf8 )
+{
+	LogUtterance( utf8, 2 );
+}
+
+int AccessTts_Speak( const char *utf8, int interrupt )
+{
+	wchar_t wide[2048];
+	int n;
+
+	if( !utf8 || !utf8[0] )
+		return ACCESS_TTS_OK;
+
+	LogUtterance( utf8, interrupt );
+	LoadNvda();
+	if( !s_pfnSpeakText )
+		return ACCESS_TTS_UNAVAILABLE;
+
+	n = MultiByteToWideChar( CP_UTF8, MB_ERR_INVALID_CHARS, utf8, -1, wide, (int)( sizeof( wide ) / sizeof( wide[0] ) ) );
+	if( n == 0 )
+		n = MultiByteToWideChar( CP_ACP, 0, utf8, -1, wide, (int)( sizeof( wide ) / sizeof( wide[0] ) ) );
+	if( n == 0 )
+		return ACCESS_TTS_OK;	// too long or unconvertible: drop silently
+	wide[sizeof( wide ) / sizeof( wide[0] ) - 1] = 0;
+
+	if( interrupt && s_pfnCancelSpeech )
+		s_pfnCancelSpeech();
+
+	return s_pfnSpeakText( wide ) == 0 ? ACCESS_TTS_OK : ACCESS_TTS_NOT_RUNNING;
+}
+
+void AccessTts_Cancel( void )
+{
+	LoadNvda();
+	if( s_pfnCancelSpeech )
+		s_pfnCancelSpeech();
+}
+
+unsigned int AccessTts_Ticks( void )
+{
+	return (unsigned int)GetTickCount();
+}
+
+#else // !_WIN32
+
+void AccessTts_Log( const char *utf8 )
+{
+	(void)utf8;
+}
+
+#include <time.h>
+
+int AccessTts_Speak( const char *utf8, int interrupt )
+{
+	(void)utf8;
+	(void)interrupt;
+	return ACCESS_TTS_UNAVAILABLE;
+}
+
+void AccessTts_Cancel( void )
+{
+}
+
+unsigned int AccessTts_Ticks( void )
+{
+	struct timespec ts;
+	clock_gettime( CLOCK_MONOTONIC, &ts );
+	return (unsigned int)( ts.tv_sec * 1000u + ts.tv_nsec / 1000000u );
+}
+
+#endif
diff --git a/cl_dll/accessibility/access_tts.h b/cl_dll/accessibility/access_tts.h
new file mode 100644
index 0000000..14ddaef
--- /dev/null
+++ b/cl_dll/accessibility/access_tts.h
@@ -0,0 +1,36 @@
+/*
+access_tts.h - minimal screen reader output (NVDA controller client), shared by
+the client (client.dll), the menus (menu.dll) and the engine (xash.dll).
+
+Plain C and free of engine headers, so it can be dropped into any of the three
+code bases; nvdaControllerClient.dll is loaded at runtime from the module's own
+folder, then from the normal DLL search path.
+*/
+#ifndef ACCESS_TTS_H
+#define ACCESS_TTS_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum
+{
+	ACCESS_TTS_OK = 1,
+	ACCESS_TTS_NOT_RUNNING = 0,		// DLL loaded but NVDA did not accept the text
+	ACCESS_TTS_UNAVAILABLE = -1		// no nvdaControllerClient.dll / unsupported platform
+};
+
+// Speaks UTF-8 text (invalid UTF-8 falls back to the ANSI code page).
+// interrupt != 0 cancels whatever is being spoken first.
+int AccessTts_Speak( const char *utf8, int interrupt );
+void AccessTts_Cancel( void );
+// Millisecond tick counter (wraps; compare with signed differences).
+unsigned int AccessTts_Ticks( void );
+// Writes a diagnostic line to the ACCESS_TTS_LOG transcript only (never spoken).
+void AccessTts_Log( const char *utf8 );
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // ACCESS_TTS_H
