+// Latest-wins announcement slots: rapid updates (damage ticks, buy bursts) are
+// merged and only the final value is spoken once the value has settled.
+enum AccessSlot
+{
+	ACCESS_SLOT_HEALTH = 0,
+	ACCESS_SLOT_ARMOR,
+	ACCESS_SLOT_MONEY,
+	ACCESS_SLOT_COUNT
+};
+
+struct PendingAnnouncement
+{
+	char text[128];
+	unsigned int dueTick;
+	bool pending;
+};
+
+static PendingAnnouncement s_Pending[ACCESS_SLOT_COUNT];
+
+static const unsigned int ACCESS_COALESCE_MS = 400;
+
+// Strips GoldSrc markup so the screen reader only gets words:
+// color bytes (0x01-0x04), menu codes (\r \w \y \d \R), and runs of whitespace.
+// Newlines become ". " so menu items are separated by a pause.
+static void CleanForSpeech( const char *in, char *out, size_t outSize )
+{
+	size_t o = 0;
+	bool lastWasSpace = true;
+
+	for( const unsigned char *p = (const unsigned char *)in; *p && o + 3 < outSize; p++ )
+	{
+		unsigned char c = *p;
+
+		if( c == '\\' && p[1] && strchr( "rwydR", p[1] ) )
+		{
+			// \R right-aligns the rest of the line (prices in buy menus):
+			// read it as a separate column, "Sidearm, 400".
+			if( p[1] == 'R' && o > 0 && !lastWasSpace )
+			{
+				out[o++] = ',';
+				out[o++] = ' ';
+				lastWasSpace = true;
+			}
+			p++;
+			continue;
+		}
+
+		// ^0-^9: player-name and server-message colour codes (Xash3D, AMX).
+		if( c == '^' && p[1] >= '0' && p[1] <= '9' )
+		{
+			p++;
+			continue;
+		}
+
+		if( c == '\n' )
+		{
+			while( o > 0 && out[o - 1] == ' ' )
+				o--;
+			if( o > 0 && !strchr( ".:!?", out[o - 1] ) )
+				out[o++] = '.';
+			out[o++] = ' ';
+			lastWasSpace = true;
+			continue;
+		}
+
+		if( c < 0x20 || c == 0x7f )
+			c = ' ';
+
+		if( c == ' ' )
+		{
+			if( lastWasSpace )
+				continue;
+			lastWasSpace = true;
+		}
+		else
+		{
+			lastWasSpace = false;
+		}
+
+		out[o++] = (char)c;
+	}
+
+	while( o > 0 && ( out[o - 1] == ' ' || out[o - 1] == '.' ) )
+		o--;
+	out[o] = 0;
+}
+
+static void SpeakRaw( const char *clean, bool interrupt )
+{
+	if( !clean[0] )
+		return;
+
+	strncpy( s_szLastSpoken, clean, sizeof( s_szLastSpoken ) - 1 );
+	s_szLastSpoken[sizeof( s_szLastSpoken ) - 1] = 0;
+
+	if( access_debug && access_debug->value )
+		gEngfuncs.Con_Printf( "[access] %s\n", clean );
+
+	const int result = AccessTts_Speak( clean, interrupt ? 1 : 0 );
+	if( result == ACCESS_TTS_OK )
+	{
+		s_bWarned = false;
+	}
+	else if( !s_bWarned )
+	{
+		gEngfuncs.Con_Printf( result == ACCESS_TTS_UNAVAILABLE
+			? "[access] nvdaControllerClient.dll introuvable : annonces vocales désactivées.\n"
+			: "[access] NVDA ne répond pas (lancé ?).\n" );
+		s_bWarned = true;
+	}
+}
+
+static bool SpeechEnabled( cvar_t *category )
+{
+	if( !access_speech || !access_speech->value )
+		return false;
+	return !category || category->value != 0.0f;
+}
+
+void Access_Speak( const char *text, bool interrupt )
+{
+	if( !text || !SpeechEnabled( NULL ) )
+		return;
+
+	char clean[1024];
+	CleanForSpeech( text, clean, sizeof( clean ) );
+	SpeakRaw( clean, interrupt );
+}
+
+static void SpeakCoalesced( AccessSlot slot, const char *text )
+{
+	PendingAnnouncement &p = s_Pending[slot];
+	strncpy( p.text, text, sizeof( p.text ) - 1 );
+	p.text[sizeof( p.text ) - 1] = 0;
+	p.dueTick = AccessTts_Ticks() + ACCESS_COALESCE_MS;
+	p.pending = true;
+}
+
+void Access_Frame( void )
+{
+	// Apply the accessibility profile (key binds, cvars) once, after the engine
+	// has run the user's own config files, so these binds take precedence.
+	static bool s_bProfileApplied;
+	if( !s_bProfileApplied )
+	{
+		gEngfuncs.pfnClientCmd( "exec access.cfg\n" );
+		s_bProfileApplied = true;
+	}
+
+	// The client localizes at startup, before the user's config sets
+	// ui_language; reload the strings whenever the language changes so
+	// server menus and messages are spoken in the chosen language.
+	static char s_szLanguage[32];
+	static bool s_bLanguageKnown;
+	const char *language = gEngfuncs.pfnGetCvarString( "ui_language" );
+	if( language && ( !s_bLanguageKnown || strcmp( language, s_szLanguage )))
+	{
+		// The first sighting after startup may already differ from what
+		// Localize_Init() saw in CHud::Init, so always reload once.
+		Localize_Init();
+		snprintf( s_szLanguage, sizeof( s_szLanguage ), "%s", language );
+		s_bLanguageKnown = true;
+	}
+
+	// New map (connection, map change on a server): say which one.
+	static char s_szLevel[64];
+	const char *level = gEngfuncs.pfnGetLevelName();
+	if( level && level[0] && strcmp( level, s_szLevel ))
+	{
+		snprintf( s_szLevel, sizeof( s_szLevel ), "%s", level );
+		char map[64];
+		const char *base = strrchr( level, '/' );
+		snprintf( map, sizeof( map ), "%s", base ? base + 1 : level );
+		if( char *ext = strstr( map, ".bsp" ))
+			*ext = 0;
+		char buf[96];
+		snprintf( buf, sizeof( buf ), "Carte %s", map );
+		Access_Speak( buf );
+	}
+	else if( !level || !level[0] )
+		s_szLevel[0] = 0;
+
+	// Spectating shows the watched player's HUD: never read it as our own. When
+	// we play again, forget the cached values so the respawn update is spoken.
+	static bool s_bWasSpectating;
+	const bool spectating = Access_IsSpectating();
+	if( s_bWasSpectating && !spectating )
+	{
+		s_iHealth = s_iArmor = -1;
+		s_szWeapon[0] = 0;
+	}
+	s_bWasSpectating = spectating;
+
+	const unsigned int now = AccessTts_Ticks();
+	for( int i = 0; i < ACCESS_SLOT_COUNT; i++ )
+	{
+		PendingAnnouncement &p = s_Pending[i];
+		if( p.pending && (int)( now - p.dueTick ) >= 0 )
+		{
+			p.pending = false;
+			// Queued just before we started watching someone: no longer ours.
+			const bool watchedPlayer = spectating && i != ACCESS_SLOT_MONEY;
+			if( SpeechEnabled( access_speech_hud ) && !watchedPlayer )
+				Access_Speak( p.text );
+		}
+	}
+}
