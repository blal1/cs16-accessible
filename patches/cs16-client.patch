@@ -0,0 +1,70 @@
+/*
+access_map.h - map knowledge for navigation: objectives (from the BSP entity
+lump) and the bot navigation mesh (maps/<map>.nav) with A* path finding
+*/
+#pragma once
+
+#include <vector>
+
+struct AccessVec
+{
+	float x, y, z;
+};
+
+enum AccessObjectiveType
+{
+	OBJ_BOMBSITE = 0,
+	OBJ_HOSTAGE,
+	OBJ_RESCUE_ZONE,
+	OBJ_VIP_SAFETY,
+	OBJ_ESCAPE_ZONE,
+	OBJ_SPAWN_CT,
+	OBJ_SPAWN_T,
+};
+
+struct AccessObjective
+{
+	AccessObjectiveType type;
+	AccessVec pos;
+	char name[64];	// spoken, e.g. "site de bombe est"
+	bool hasBounds;	// zones drawn as brushes (bomb sites, rescue zones...)
+	AccessVec mins, maxs;
+};
+
+// Map features worth knowing about when walking by (brush entities).
+enum AccessFeatureType
+{
+	FEAT_LADDER = 0,
+	FEAT_DOOR,
+	FEAT_BREAKABLE,	// glass, crates, vents that break
+};
+
+struct AccessFeature
+{
+	AccessFeatureType type;
+	AccessVec mins, maxs;	// bounds in the closed / initial position
+};
+
+// Reloads everything when the level changes; cheap to call every frame.
+void AccessMap_Update( const char *levelName );
+bool AccessMap_HasNav( void );
+const std::vector<AccessObjective> &AccessMap_Objectives( void );
+const std::vector<AccessFeature> &AccessMap_Features( void );
+
+// "nord", "nord-est", ... for a world yaw in degrees (0 = +x = east, 90 = +y = north).
+const char *AccessMap_CompassWord( float yawDegrees );
+
+// Nav area under/near a point, or -1.
+int AccessMap_FindArea( const AccessVec &pos );
+// A* over the nav mesh. Fills waypoints (portal points between areas, then goal)
+// and returns the path length in world units, or -1 when unreachable.
+float AccessMap_FindPath( const AccessVec &from, const AccessVec &to, std::vector<AccessVec> &waypoints );
+
+// Where a point is, in words, from walking distances to the map objectives:
+// "près du site de bombe ouest", "entre le départ terroriste et le site de
+// bombe est". key identifies the place (for change detection). False without a
+// nav mesh or off the mesh.
+bool AccessMap_PlaceName( const AccessVec &pos, char *out, size_t size, int *key );
+
+// Parser entry point, also used by the standalone tests.
+void AccessMap_LoadFromBuffers( const unsigned char *bsp, size_t bspSize, const unsigned char *nav, size_t navSize );
diff --git a/cl_dll/accessibility/access_nav.cpp b/cl_dll/accessibility/access_nav.cpp
