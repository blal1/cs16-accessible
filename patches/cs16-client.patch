+		return;
+	const Vector src( from[0], from[1], from[2] );
+	AccessCueParams p = ( src.x == 0.0f && src.y == 0.0f && src.z == 0.0f ) ? Centered( 0.8f ) : Spatial( src, 0.0f, 0.8f );
+	p.gain = damage >= 30 ? 1.0f : 0.6f;
+	Play( CUE_DAMAGE, p );
+}
