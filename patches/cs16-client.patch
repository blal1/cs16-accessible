+/*
+access_map.h - map knowledge for navigation: objectives (from the BSP entity
+lump) and the bot navigation mesh (maps/<map>.nav) with A* path finding
+*/
+#pragma once
+
+#include <vector>
+
+struct AccessVec
+{
+	float x, y, z;
+};
+
+enum AccessObjectiveType
+{
+	OBJ_BOMBSITE = 0,
+	OBJ_HOSTAGE,
+	OBJ_RESCUE_ZONE,
+	OBJ_VIP_SAFETY,
+	OBJ_ESCAPE_ZONE,
+	OBJ_SPAWN_CT,
+	OBJ_SPAWN_T,
+};
+
+struct AccessObjective
+{
+	AccessObjectiveType type;
+	AccessVec pos;
+	char name[64];	// spoken, e.g. "site de bombe est"
+};
+
+// Reloads everything when the level changes; cheap to call every frame.
+void AccessMap_Update( const char *levelName );
+bool AccessMap_HasNav( void );
+const std::vector<AccessObjective> &AccessMap_Objectives( void );
+
+// "nord", "nord-est", ... for a world yaw in degrees (0 = +x = east, 90 = +y = north).
+const char *AccessMap_CompassWord( float yawDegrees );
+
+// Nav area under/near a point, or -1.
+int AccessMap_FindArea( const AccessVec &pos );
+// A* over the nav mesh. Fills waypoints (portal points between areas, then goal)
+// and returns the path length in world units, or -1 when unreachable.
+float AccessMap_FindPath( const AccessVec &from, const AccessVec &to, std::vector<AccessVec> &waypoints );
+
+// Parser entry point, also used by the standalone tests.
+void AccessMap_LoadFromBuffers( const unsigned char *bsp, size_t bspSize, const unsigned char *nav, size_t navSize );
diff --git a/cl_dll/accessibility/access_nav.cpp b/cl_dll/accessibility/access_nav.cpp
new file mode 100644
index 0000000..281b8fb
--- /dev/null
+++ b/cl_dll/accessibility/access_nav.cpp
@@ -0,0 +1,1105 @@
+/*
+access_nav.cpp - audio navigation and combat cues for blind players
+
+Everything here turns world state into short procedural sounds (access_audio)
+placed around the listener: pan = left/right, muffled = behind, higher pitch =
+above / closer. Speech (access_speech) is reserved for discrete facts.
+
+Fair-play rule: enemies are only sonified when the local player has a clear
+line of sight to them, i.e. information a sighted player would have on screen.
+*/
+
+#include "hud.h"
+#include "cl_util.h"
+#include "const.h"
+#include "entity_state.h"
+#include "cl_entity.h"
+#include "com_model.h"
+#include "pm_defs.h"
+#include "pmtrace.h"
+#include "event_api.h"
+#include "com_weapons.h"
+
+#include "accessibility/access_audio.h"
+#include "accessibility/access_map.h"
+#include "accessibility/access_nav.h"
+#include "accessibility/access_speech.h"
+#include "accessibility/access_tts.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <vector>
+
+extern int g_iUser1;
+
+static const float UNITS_TO_METERS = 0.0254f;
+static const float RAD2DEG = 57.2957795f;
+static const float DEG2RAD = 0.0174532925f;
+
+static cvar_t *access_cues;
+static cvar_t *access_cue_volume;
+static cvar_t *access_sonar;
+static cvar_t *access_sonar_range;
+static cvar_t *access_ledges;
+static cvar_t *access_enemies;
+static cvar_t *access_enemy_fov;
+static cvar_t *access_teammates;
+static cvar_t *access_aimcue;
+static cvar_t *access_aim_cone;
+static cvar_t *access_grenades;
+static cvar_t *access_compass_tick;
+static cvar_t *access_heartbeat;
+
+// ---------------------------------------------------------------------------
+// Listener and spatialization
+// ---------------------------------------------------------------------------
+
+struct Listener
+{
+	Vector origin;		// hull center
+	Vector eye;
+	float feetZ;
+	float yaw, pitch;	// degrees, HL convention (yaw 0 = +x, 90 = +y; pitch > 0 looks down)
+	Vector forward;		// full view direction
+	int index;
+	int team;
+	bool ducking;
+};
+
+static Listener s_L;
+static float s_flTime;
+static float s_flPrevYaw;
+static Vector s_vecPrevOrigin;
+static float s_flSpeed;		// horizontal units/s
+static float s_flTurnRate;	// degrees/s
+static Vector s_vecMoveDir;	// normalized horizontal velocity
+
+static float NormalizeAngle( float a )
+{
+	a = fmodf( a + 180.0f, 360.0f );
+	if( a < 0.0f )
+		a += 360.0f;
+	return a - 180.0f;
+}
+
+// Angle of pos relative to the view, positive = to the left.
+static float RelativeYaw( const Vector &pos )
+{
+	return NormalizeAngle( atan2f( pos.y - s_L.eye.y, pos.x - s_L.eye.x ) * RAD2DEG - s_L.yaw );
+}
+
+static AccessCueParams SpatialFromRelYaw( float relYaw, float gain )
+{
+	AccessCueParams p;
+	p.pan = -sinf( relYaw * DEG2RAD );
+	p.muffle = fabsf( relYaw ) > 90.0f ? ( fabsf( relYaw ) - 90.0f ) / 90.0f : 0.0f;
+	p.gain = gain;
+	p.pitch = 1.0f;
+	return p;
+}
+
+// Full 3D placement: direction, distance falloff, and elevation mapped to pitch
+// (+/- half an octave for straight up/down).
+static AccessCueParams Spatial( const Vector &pos, float maxDistance, float baseGain )
+{
+	const Vector d = pos - s_L.eye;
+	const float horiz = sqrtf( d.x * d.x + d.y * d.y );
+	const float dist = d.Length();
+
+	float gain = baseGain;
+	if( maxDistance > 0.0f )
+	{
+		const float falloff = 1.0f - dist / maxDistance;
+		gain *= falloff < 0.2f ? 0.2f : falloff;
+	}
+
+	AccessCueParams p = SpatialFromRelYaw( RelativeYaw( pos ), gain );
+	const float elevation = atan2f( d.z, horiz > 1.0f ? horiz : 1.0f ) * RAD2DEG;
+	p.pitch = powf( 2.0f, elevation / 90.0f * 0.5f );
+	return p;
+}
+
+static void Play( AccessCue cue, const AccessCueParams &p )
+{
+	if( !access_cues || !access_cues->value )
+		return;
+	AccessAudio_Play( cue, p );
+
+	// Transcript (ACCESS_TTS_LOG only): first use of each cue, for automated checks.
+	static const char *names[CUE_COUNT] = { "mur côté", "mur devant", "vide", "marche", "balise", "arrivée",
+		"ennemi", "coéquipier", "visée", "visée verrouillée", "objectif", "nord", "balayage", "ouverture",
+		"dégâts", "grenade", "cœur", "munitions", "ennemi repéré" };
+	static bool logged[CUE_COUNT];
+	if( cue >= 0 && cue < CUE_COUNT && !logged[cue] )
+	{
+		char line[96];
+		snprintf( line, sizeof( line ), "son : %s (pan %.2f, étouffé %.2f)", names[cue], p.pan, p.muffle );
+		AccessTts_Log( line );
+		logged[cue] = true;
+	}
+}
+
+static AccessCueParams Centered( float gain )
+{
+	return SpatialFromRelYaw( 0.0f, gain );
+}
+
+// 1..12 o'clock for a relative yaw (12 = ahead, 3 = right, 9 = left).
+static int ClockHour( float relYaw )
+{
+	int h = (int)floorf( -relYaw / 30.0f + 0.5f );
+	h = ( ( h % 12 ) + 12 ) % 12;
+	return h == 0 ? 12 : h;
+}
+
+// "1 heure" / "3 heures"; rotating buffers so several fit in one printf.
+static const char *ClockText( float relYaw )
+{
+	static char buffers[4][16];
+	static int next;
+	char *out = buffers[next];
+	next = ( next + 1 ) % 4;
+	const int h = ClockHour( relYaw );
+	snprintf( out, sizeof( buffers[0] ), "%d heure%s", h, h > 1 ? "s" : "" );
+	return out;
+}
+
+static int Meters( float units )
+{
+	return (int)( units * UNITS_TO_METERS + 0.5f );
+}
+
+// ---------------------------------------------------------------------------
+// Traces (world and brush entities; players are never solid here)
+// ---------------------------------------------------------------------------
+
+static bool s_bTraceOpen;
+
+static void BeginTraces( void )
+{
+	gEngfuncs.pEventAPI->EV_SetUpPlayerPrediction( false, true );
+	gEngfuncs.pEventAPI->EV_PushPMStates();
+	gEngfuncs.pEventAPI->EV_SetTraceHull( 2 );
+	s_bTraceOpen = true;
+}
+
+static void EndTraces( void )
+{
+	if( s_bTraceOpen )
+		gEngfuncs.pEventAPI->EV_PopPMStates();
+	s_bTraceOpen = false;
+}
+
+// Distance travelled before hitting something (== full length when clear).
+static float TraceDistance( const Vector &start, const Vector &end, Vector *hit = NULL )
+{
+	pmtrace_t tr;
+	Vector s = start, e = end;
+	gEngfuncs.pEventAPI->EV_PlayerTrace( s, e, PM_STUDIO_IGNORE, -1, &tr );
+	if( hit )
+		*hit = tr.endpos;
+	if( tr.startsolid )
+		return 0.0f;
+	return ( end - start ).Length() * tr.fraction;
+}
+
+static bool LineOfSight( const Vector &start, const Vector &end )
+{
+	pmtrace_t tr;
+	Vector s = start, e = end;
+	gEngfuncs.pEventAPI->EV_PlayerTrace( s, e, PM_STUDIO_IGNORE | PM_GLASS_IGNORE, -1, &tr );
+	return !tr.startsolid && tr.fraction > 0.99f;
+}
+
+static Vector DirFromYaw( float yawDegrees )
+{
+	return Vector( cosf( yawDegrees * DEG2RAD ), sinf( yawDegrees * DEG2RAD ), 0.0f );
+}
+
+// ---------------------------------------------------------------------------
+// Wall sonar and ledge / step detection
+// ---------------------------------------------------------------------------
+
+static const float s_SonarAngles[] = { 0.0f, 45.0f, -45.0f, 90.0f, -90.0f, 180.0f };
+static int s_iSonarStep;
+static float s_flNextSonar;
+static float s_flNextLedge;
+static float s_flNextStep;
+static bool s_bWarnedBigDrop;
+
+static void UpdateSonar( void )
+{
+	const int mode = access_sonar ? (int)access_sonar->value : 0;
+	if( mode <= 0 || s_flTime < s_flNextSonar )
+		return;
+	s_flNextSonar = s_flTime + 0.045f;
+
+	// Mode 1: only while moving or turning, so standing still is quiet.
+	const bool active = mode >= 2 || s_flSpeed > 20.0f || s_flTurnRate > 25.0f;
+	const int count = sizeof( s_SonarAngles ) / sizeof( s_SonarAngles[0] );
+	const float rel = s_SonarAngles[s_iSonarStep];
+	s_iSonarStep = ( s_iSonarStep + 1 ) % count;
+	if( !active && rel != 0.0f )
+		return;
+
+	const float range = access_sonar_range && access_sonar_range->value > 16.0f ? access_sonar_range->value : 128.0f;
+	const Vector start = s_L.origin;
+	const Vector end = start + DirFromYaw( s_L.yaw + rel ) * range;
+	const float d = TraceDistance( start, end );
+	if( d >= range - 1.0f )
+		return;
+
+	const float closeness = 1.0f - d / range;
+	AccessCueParams p = SpatialFromRelYaw( rel, 0.15f + 0.6f * closeness * closeness );
+	p.pitch = 0.85f + 0.5f * closeness;
+	Play( rel == 0.0f ? CUE_WALL_FRONT : CUE_WALL_TAP, p );
+}
+
+static void UpdateLedges( void )
+{
+	if( !access_ledges || !access_ledges->value || s_flSpeed < 30.0f )
+		return;
+
+	const Vector dir = s_vecMoveDir;
+	const float probe = 56.0f;
+
+	// Obstacle at knee height but clear at jump height -> can be jumped.
+	const Vector knee( s_L.origin.x, s_L.origin.y, s_L.feetZ + 18.0f );
+	const float kneeDist = TraceDistance( knee, knee + dir * probe );
+	if( kneeDist < probe - 8.0f )
+	{
+		const Vector high( s_L.origin.x, s_L.origin.y, s_L.feetZ + 58.0f );
+		if( TraceDistance( high, high + dir * probe ) >= probe - 1.0f && s_flTime >= s_flNextStep )
+		{
+			Play( CUE_STEP, SpatialFromRelYaw( NormalizeAngle( atan2f( dir.y, dir.x ) * RAD2DEG - s_L.yaw ), 0.7f ) );
+			s_flNextStep = s_flTime + 0.8f;
+		}
+		return;
+	}
+
+	// Floor ahead: how far down is it?
+	const Vector ahead = knee + dir * probe;
+	Vector hit;
+	const float maxDrop = 400.0f;
+	const float down = TraceDistance( ahead, ahead - Vector( 0.0f, 0.0f, 18.0f + maxDrop ), &hit );
+	const float drop = down - 18.0f;
+	if( drop < 48.0f )
+	{
+		s_bWarnedBigDrop = false;
+		return;
+	}
+
+	if( s_flTime >= s_flNextLedge )
+	{
+		// Deeper drops sound lower.
+		AccessCueParams p = SpatialFromRelYaw( NormalizeAngle( atan2f( dir.y, dir.x ) * RAD2DEG - s_L.yaw ), 0.8f );
+		p.pitch = drop > 250.0f ? 0.6f : ( drop > 120.0f ? 0.8f : 1.0f );
+		Play( CUE_LEDGE, p );
+		s_flNextLedge = s_flTime + 0.7f;
+	}
+
+	// Falls over ~200 units hurt in CS.
+	if( drop > 220.0f && !s_bWarnedBigDrop )
+	{
+		s_bWarnedBigDrop = true;
+		Access_Speak( drop >= maxDrop ? "Vide profond devant" : "Chute dangereuse devant" );
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Radar sweep (access_scan): 24 rays around the player, near walls sound high,
+// far walls low, open space is a breath of noise. Ends with a spoken summary.
+// ---------------------------------------------------------------------------
+
+static const int SCAN_STEPS = 24;
+static const float SCAN_RANGE = 1200.0f;
+static const float SCAN_OPEN = 500.0f;
+static int s_iScanStep = -1;
+static float s_flNextScan;
+static float s_ScanDist[SCAN_STEPS];
+static float s_flScanYaw;
+
+static void Cmd_Scan( void )
+{
+	// Never ignore a request silently: say why nothing will be heard.
+	if( gHUD.m_fPlayerDead || g_iUser1 || CL_IsDead() )
+	{
+		Access_Speak( "Balayage impossible, vous n'êtes pas en jeu", true );
+		return;
+	}
+	if( gHUD.m_Menu.m_fMenuDisplayed )
+	{
+		Access_Speak( "Fermez le menu pour lancer le balayage", true );
+		return;
+	}
+	s_iScanStep = 0;
+	s_flNextScan = 0.0f;
+	s_flScanYaw = s_L.yaw;
+}
+
+static void UpdateScan( void )
+{
+	if( s_iScanStep < 0 || s_flTime < s_flNextScan )
+		return;
+	s_flNextScan = s_flTime + 0.06f;
+
+	// Clockwise from straight ahead: rel 0, -15 (right), ... all the way round.
+	const float rel = -360.0f * s_iScanStep / SCAN_STEPS;
+	const Vector start = s_L.eye;
+	const float d = TraceDistance( start, start + DirFromYaw( s_flScanYaw + rel ) * SCAN_RANGE );
+	s_ScanDist[s_iScanStep] = d;
+
+	const float relNow = NormalizeAngle( s_flScanYaw + rel - s_L.yaw );
+	if( d >= SCAN_OPEN )
+	{
+		Play( CUE_OPENING, SpatialFromRelYaw( relNow, 0.55f ) );
+	}
+	else
+	{
+		AccessCueParams p = SpatialFromRelYaw( relNow, 0.35f + 0.5f * ( 1.0f - d / SCAN_OPEN ) );
+		p.pitch = 2.0f - 1.4f * ( d / SCAN_OPEN );
+		Play( CUE_SCAN, p );
+	}
+
+	if( ++s_iScanStep < SCAN_STEPS )
+		return;
+	s_iScanStep = -1;
+
+	// Summarize contiguous open sectors as clock directions.
+	char buf[256] = "";
+	int openings = 0;
+	for( int i = 0; i < SCAN_STEPS; i++ )
+	{
+		const int prev = ( i + SCAN_STEPS - 1 ) % SCAN_STEPS;
+		if( s_ScanDist[i] < SCAN_OPEN || s_ScanDist[prev] >= SCAN_OPEN )
+			continue;
+		int j = i;
+		while( s_ScanDist[( j + 1 ) % SCAN_STEPS] >= SCAN_OPEN && ( j + 1 ) % SCAN_STEPS != i )
+			j++;
+		const float mid = -360.0f * ( i + j ) * 0.5f / SCAN_STEPS;
+		char part[48];
+		snprintf( part, sizeof( part ), "%s%s", openings ? ", " : "", ClockText( mid ) );
+		strncat( buf, part, sizeof( buf ) - strlen( buf ) - 1 );
+		openings++;
+	}
+
+	int nearest = 0;
+	for( int i = 1; i < SCAN_STEPS; i++ )
+		if( s_ScanDist[i] < s_ScanDist[nearest] )
+			nearest = i;
+
+	int openRays = 0;
+	for( int i = 0; i < SCAN_STEPS; i++ )
+		openRays += s_ScanDist[i] >= SCAN_OPEN;
+
+	char summary[384];
+	if( openRays == SCAN_STEPS )
+		snprintf( summary, sizeof( summary ), "Espace ouvert tout autour" );
+	else if( openings == 0 )
+		snprintf( summary, sizeof( summary ), "Espace fermé. Mur le plus proche à %s, %d mètres",
+			ClockText( -360.0f * nearest / SCAN_STEPS ), Meters( s_ScanDist[nearest] ) );
+	else
+		snprintf( summary, sizeof( summary ), "Ouvertures à %s. Mur le plus proche à %s, %d mètres",
+			buf, ClockText( -360.0f * nearest / SCAN_STEPS ), Meters( s_ScanDist[nearest] ) );
+	Access_Speak( summary );
+}
+
+// ---------------------------------------------------------------------------
+// Guidance to an objective along the nav mesh
+// ---------------------------------------------------------------------------
+
+struct Target
+{
+	char name[64];
+	Vector pos;
+	bool dynamic;	// bomb: position follows the radar
+};
+
+static std::vector<Target> s_Targets;
+static int s_iTarget = -1;
+static char s_szTargetName[64];
+static std::vector<AccessVec> s_Path;
+static size_t s_iPathNext;
+static float s_flNextRepath;
+static float s_flNextBeacon;
+
+static AccessVec ToAccess( const Vector &v )
+{
+	AccessVec a = { v.x, v.y, v.z };
+	return a;
+}
+
+static Vector FromAccess( const AccessVec &a )
+{
+	return Vector( a.x, a.y, a.z );
+}
+
+static bool BombVisibleOnRadar( void )
+{
+	const extra_player_info_t &bomb = g_PlayerExtraInfo[33];
+	return !bomb.dead && ( bomb.origin.x != 0.0f || bomb.origin.y != 0.0f );
+}
+
+static void RebuildTargets( void )
+{
+	s_Targets.clear();
+	if( BombVisibleOnRadar() )
+	{
+		Target t;
+		snprintf( t.name, sizeof( t.name ), "%s", g_PlayerExtraInfo[33].playerclass ? "bombe posée" : "bombe au sol" );
+		t.pos = g_PlayerExtraInfo[33].origin;
+		t.dynamic = true;
+		s_Targets.push_back( t );
+	}
+	for( const AccessObjective &o : AccessMap_Objectives() )
+	{
+		Target t;
+		snprintf( t.name, sizeof( t.name ), "%s", o.name );
+		t.pos = FromAccess( o.pos );
+		t.dynamic = false;
+		s_Targets.push_back( t );
+	}
+}
+
+static const Target *CurrentTarget( void )
+{
+	for( const Target &t : s_Targets )
+		if( !strcmp( t.name, s_szTargetName ) )
+			return &t;
+	return NULL;
+}
+
+static float Repath( const Target &t )
+{
+	const AccessVec feet = { s_L.origin.x, s_L.origin.y, s_L.feetZ + 1.0f };
+	const float length = AccessMap_FindPath( feet, ToAccess( t.pos ), s_Path );
+	s_iPathNext = 0;
+	s_flNextRepath = s_flTime + 1.5f;
+	if( length < 0.0f )
+	{
+		// No nav mesh: head straight for it.
+		s_Path.clear();
+		s_Path.push_back( ToAccess( t.pos ) );
+		return ( t.pos - s_L.origin ).Length();
+	}
+	return length;
+}
+
+static void SelectTarget( int delta )
+{
+	RebuildTargets();
+	if( s_Targets.empty() )
+	{
+		Access_Speak( "Aucune cible sur cette carte", true );
+		return;
+	}
+
+	s_iTarget = s_iTarget < 0 ? ( delta > 0 ? 0 : (int)s_Targets.size() - 1 )
+		: ( ( s_iTarget + delta ) % (int)s_Targets.size() + (int)s_Targets.size() ) % (int)s_Targets.size();
+	const Target &t = s_Targets[s_iTarget];
+	snprintf( s_szTargetName, sizeof( s_szTargetName ), "%s", t.name );
+
+	const float length = Repath( t );
+	char buf[160];
+	snprintf( buf, sizeof( buf ), "%s, %d mètres, à %s", t.name, Meters( length ), ClockText( RelativeYaw( t.pos ) ) );
+	Access_Speak( buf, true );
+	s_flNextBeacon = 0.0f;
+}
+
+static void Cmd_TargetNext( void ) { SelectTarget( 1 ); }
+static void Cmd_TargetPrev( void ) { SelectTarget( -1 ); }
+
+static void StopGuidance( void )
+{
+	s_iTarget = -1;
+	s_szTargetName[0] = 0;
+	s_Path.clear();
+}
+
+static void Cmd_TargetStop( void )
+{
+	StopGuidance();
+	Access_Speak( "Guidage arrêté", true );
+}
+
+static void UpdateGuidance( void )
+{
+	if( !s_szTargetName[0] )
+		return;
+
+	RebuildTargets();
+	const Target *t = CurrentTarget();
+	if( !t )
+	{
+		StopGuidance();	// e.g. the dropped bomb was picked up
+		return;
+	}
+
+	const Vector feet( s_L.origin.x, s_L.origin.y, s_L.feetZ );
+	const float toGoal = ( t->pos - feet ).Length2D();
+	if( toGoal < 90.0f && fabsf( t->pos.z - feet.z ) < 120.0f )
+	{
+		Play( CUE_ARRIVED, Centered( 0.9f ) );
+		char buf[96];
+		snprintf( buf, sizeof( buf ), "Arrivé : %s", t->name );
+		Access_Speak( buf );
+		StopGuidance();
+		return;
+	}
+
+	if( s_Path.empty() || s_flTime >= s_flNextRepath )
+		Repath( *t );
+
+	// Drop waypoints we have reached.
+	while( s_iPathNext + 1 < s_Path.size() && ( FromAccess( s_Path[s_iPathNext] ) - feet ).Length2D() < 56.0f )
+		s_iPathNext++;
+
+	// Far off the path (fell, got pushed): recompute now.
+	if( ( FromAccess( s_Path[s_iPathNext] ) - feet ).Length2D() > 450.0f )
+		Repath( *t );
+
+	// Beacon on the farthest of the next few waypoints still in line of sight,
+	// so the sound leads around corners instead of into walls.
+	size_t aim = s_iPathNext;
+	for( size_t i = s_iPathNext + 1; i < s_Path.size() && i <= s_iPathNext + 4; i++ )
+	{
+		const Vector wp = FromAccess( s_Path[i] ) + Vector( 0.0f, 0.0f, 36.0f );
+		if( !LineOfSight( s_L.eye, wp ) )
+			break;
+		aim = i;
+	}
+
+	if( s_flTime < s_flNextBeacon )
+		return;
+
+	const Vector beacon = FromAccess( s_Path[aim] ) + Vector( 0.0f, 0.0f, 36.0f );
+	const float dist = ( beacon - s_L.eye ).Length();
+	// The bomb gets its own timbre so it is never confused with a route point.
+	Play( t->dynamic ? CUE_OBJECTIVE : CUE_BEACON, Spatial( beacon, 0.0f, 0.75f ) );
+	s_flNextBeacon = s_flTime + ( dist < 200.0f ? 0.35f : ( dist > 800.0f ? 1.1f : 0.35f + 0.75f * ( dist - 200.0f ) / 600.0f ) );
+}
+
+// ---------------------------------------------------------------------------
+// Players: visible enemies, nearby teammates, aim assistance tone
+// ---------------------------------------------------------------------------
+
+struct PlayerTrack
+{
+	bool visible;
+	float nextCue;
+	float nextCheck;
+};
+
+static PlayerTrack s_Players[MAX_PLAYERS + 1];
+static float s_flNextAim;
+
+static cl_entity_t *PlayerEntityIfInView( int i, cl_entity_t *local )
+{
+	cl_entity_t *ent = gEngfuncs.GetEntityByIndex( i );
+	if( !ent || !ent->player || ent == local || !ent->model )
+		return NULL;
+	if( ent->curstate.messagenum < local->curstate.messagenum )
+		return NULL;	// not in our PVS this frame
+	if( g_PlayerExtraInfo[i].dead )
+		return NULL;
+	return ent;
+}
+
+static void UpdatePlayers( cl_entity_t *local )
+{
+	const bool wantEnemies = access_enemies && access_enemies->value;
+	const bool wantTeam = access_teammates && access_teammates->value;
+	const bool wantAim = access_aimcue && access_aimcue->value;
+	const float fov = access_enemy_fov && access_enemy_fov->value > 0.0f ? access_enemy_fov->value : 360.0f;
+
+	struct Visible { int index; float dist; Vector chest; };
+	Visible visible[MAX_PLAYERS];
+	int visibleCount = 0;
+
+	const int maxClients = gEngfuncs.GetMaxClients() < MAX_PLAYERS ? gEngfuncs.GetMaxClients() : MAX_PLAYERS;
+	for( int i = 1; i <= maxClients; i++ )
+	{
+		PlayerTrack &track = s_Players[i];
+		cl_entity_t *ent = PlayerEntityIfInView( i, local );
+		const int team = g_PlayerExtraInfo[i].teamnumber;
+		if( !ent || team == 0 || s_L.team == 0 )
+		{
+			track.visible = false;
+			continue;
+		}
+
+		const Vector chest = ent->origin + Vector( 0.0f, 0.0f, 8.0f );
+		const float dist = ( chest - s_L.eye ).Length();
+
+		if( team == s_L.team )
+		{
+			if( wantTeam && dist < 350.0f && s_flTime >= track.nextCue )
+			{
+				Play( CUE_TEAMMATE, Spatial( chest, 350.0f, 0.35f ) );
+				track.nextCue = s_flTime + 1.2f;
+			}
+			continue;
+		}
+
+		if( !wantEnemies && !wantAim )
+			continue;
+
+		// Line-of-sight checks are the expensive part: 10 Hz per player.
+		if( s_flTime >= track.nextCheck )
+		{
+			track.nextCheck = s_flTime + 0.1f;
+			const bool inFov = fov >= 360.0f || fabsf( RelativeYaw( chest ) ) <= fov * 0.5f;
+			const Vector head = ent->origin + Vector( 0.0f, 0.0f, 26.0f );
+			const bool nowVisible = inFov && ( LineOfSight( s_L.eye, chest ) || LineOfSight( s_L.eye, head ) );
+
+			if( nowVisible && !track.visible && wantEnemies )
+			{
+				Play( CUE_ENEMY_SPOTTED, Spatial( chest, 0.0f, 0.9f ) );
+				track.nextCue = s_flTime + 0.35f;
+			}
+			track.visible = nowVisible;
+		}
+
+		if( track.visible && visibleCount < MAX_PLAYERS )
+		{
+			visible[visibleCount].index = i;
+			visible[visibleCount].dist = dist;
+			visible[visibleCount].chest = chest;
+			visibleCount++;
+		}
+	}
+
+	// Pulse the three closest visible enemies; closer = faster.
+	for( int pass = 0; pass < 3 && wantEnemies; pass++ )
+	{
+		int best = -1;
+		for( int v = 0; v < visibleCount; v++ )
+			if( visible[v].index > 0 && ( best < 0 || visible[v].dist < visible[best].dist ) )
+				best = v;
+		if( best < 0 )
+			break;
+
+		PlayerTrack &track = s_Players[visible[best].index];
+		if( s_flTime >= track.nextCue )
+		{
+			Play( CUE_ENEMY, Spatial( visible[best].chest, 2500.0f, 0.8f ) );
+			const float d = visible[best].dist;
+			track.nextCue = s_flTime + ( d < 300.0f ? 0.3f : ( d > 1500.0f ? 1.0f : 0.3f + 0.7f * ( d - 300.0f ) / 1200.0f ) );
+		}
+		visible[best].index = -visible[best].index;	// mark used
+	}
+	for( int v = 0; v < visibleCount; v++ )
+		if( visible[v].index < 0 )
+			visible[v].index = -visible[v].index;
+
+	// Aim tone for the visible enemy closest to the crosshair.
+	if( !wantAim || visibleCount == 0 || s_flTime < s_flNextAim )
+		return;
+
+	const float cone = access_aim_cone && access_aim_cone->value > 1.0f ? access_aim_cone->value : 30.0f;
+	float bestErr = 1e9f;
+	int bestV = -1;
+	for( int v = 0; v < visibleCount; v++ )
+	{
+		Vector to = visible[v].chest - s_L.eye;
+		to = to.Normalize();
+		const float cosErr = DotProduct( to, s_L.forward );
+		const float err = acosf( cosErr > 1.0f ? 1.0f : ( cosErr < -1.0f ? -1.0f : cosErr ) ) * RAD2DEG;
+		if( err < bestErr )
+		{
+			bestErr = err;
+			bestV = v;
+		}
+	}
+	if( bestV < 0 || bestErr > cone )
+		return;
+
+	// Roughly the angular half-width of a player's torso at that range.
+	const float lockAngle = atan2f( 14.0f, visible[bestV].dist ) * RAD2DEG;
+	const float relYaw = RelativeYaw( visible[bestV].chest );
+	if( bestErr <= ( lockAngle > 1.0f ? lockAngle : 1.0f ) )
+	{
+		Play( CUE_AIM_LOCK, Centered( 0.8f ) );
+		s_flNextAim = s_flTime + 0.11f;
+	}
+	else
+	{
+		AccessCueParams p = SpatialFromRelYaw( relYaw, 0.55f );
+		p.muffle = 0.0f;
+		p.pitch = 0.8f + 1.4f * ( 1.0f - bestErr / cone );
+		Play( CUE_AIM, p );
+		s_flNextAim = s_flTime + 0.06f + bestErr * 0.01f;
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Grenades in flight
+// ---------------------------------------------------------------------------
+
+struct GrenadeTrack
+{
+	int index;
+	float nextCue;
+	float lastSeen;
+	bool own;	// thrown by the local player: tracked quietly, not announced
+};
+
+static std::vector<GrenadeTrack> s_Grenades;
+static float s_flNextGrenadeScan;
+
+static const char *GrenadeKind( const cl_entity_t *ent )
+{
+	if( !ent->model || ent->curstate.movetype != MOVETYPE_BOUNCE )
+		return NULL;	// dropped weapons use the same models but do not bounce
+	const char *name = ent->model->name;
+	if( strstr( name, "w_hegrenade" ) )
+		return "Grenade explosive";
+	if( strstr( name, "w_flashbang" ) )
+		return "Flash, détournez-vous";
+	if( strstr( name, "w_smokegrenade" ) )
+		return "Fumigène";
+	return NULL;
+}
+
+static void UpdateGrenades( cl_entity_t *local )
+{
+	if( !access_grenades || !access_grenades->value )
+		return;
+
+	if( s_flTime >= s_flNextGrenadeScan )
+	{
+		s_flNextGrenadeScan = s_flTime + 0.1f;
+		for( int i = gEngfuncs.GetMaxClients() + 1; i < 2048; i++ )
+		{
+			cl_entity_t *ent = gEngfuncs.GetEntityByIndex( i );
+			if( !ent )
+				break;
+			if( ent->curstate.messagenum < local->curstate.messagenum )
+				continue;
+			const char *kind = GrenadeKind( ent );
+			if( !kind || ( ent->origin - s_L.eye ).Length() > 900.0f )
+				continue;
+
+			bool known = false;
+			for( GrenadeTrack &g : s_Grenades )
+			{
+				if( g.index == i )
+				{
+					g.lastSeen = s_flTime;
+					known = true;
+				}
+			}
+			if( !known )
+			{
+				const bool own = ent->curstate.owner == local->index;
+				GrenadeTrack g = { i, 0.0f, s_flTime, own };
+				s_Grenades.push_back( g );
+				if( !own )
+					Access_Speak( kind, true );
+			}
+		}
+	}
+
+	for( size_t k = 0; k < s_Grenades.size(); )
+	{
+		GrenadeTrack &g = s_Grenades[k];
+		cl_entity_t *ent = gEngfuncs.GetEntityByIndex( g.index );
+		if( !ent || s_flTime - g.lastSeen > 0.5f )
+		{
+			s_Grenades.erase( s_Grenades.begin() + k );
+			continue;
+		}
+		if( s_flTime >= g.nextCue )
+		{
+			const float d = ( ent->origin - s_L.eye ).Length();
+			Play( CUE_GRENADE, Spatial( ent->origin, 900.0f, g.own ? 0.4f : 1.0f ) );
+			g.nextCue = s_flTime + ( d < 250.0f ? 0.3f : 0.6f );
+		}
+		k++;
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Body state: heartbeat, compass tick
+// ---------------------------------------------------------------------------
+
+static int s_iHealth = 100;
+static float s_flNextHeartbeat;
+
+void AccessNav_OnHealth( int health )
+{
+	s_iHealth = health;
+}
+
+static void UpdateBody( void )
+{
+	if( access_heartbeat && access_heartbeat->value && s_iHealth > 0 && s_iHealth <= 25 && s_flTime >= s_flNextHeartbeat )
+	{
+		Play( CUE_HEARTBEAT, Centered( 0.5f ) );
+		s_flNextHeartbeat = s_flTime + 0.6f + s_iHealth * 0.03f;
+	}
+
+	if( access_compass_tick && access_compass_tick->value )
+	{
+		// Tick whenever the view sweeps across north (yaw 90).
+		const float a = NormalizeAngle( s_flPrevYaw - 90.0f ), b = NormalizeAngle( s_L.yaw - 90.0f );
+		if( ( a < 0.0f ) != ( b < 0.0f ) && fabsf( a ) < 90.0f && fabsf( b ) < 90.0f )
+			Play( CUE_NORTH, Centered( 0.4f ) );
+	}
+}
+
+void AccessNav_OnDamage( const float *from, int damage )
+{
+	if( damage <= 0 )
+		return;
+	const Vector src( from[0], from[1], from[2] );
+	AccessCueParams p = ( src.x == 0.0f && src.y == 0.0f && src.z == 0.0f ) ? Centered( 0.8f ) : Spatial( src, 0.0f, 0.8f );
+	p.gain = damage >= 30 ? 1.0f : 0.6f;
+	Play( CUE_DAMAGE, p );
+}
+
+static int s_iMaxClipSeen;
+
+void AccessNav_OnClip( bool weaponChanged, int clip )
+{
+	static int prevClip = -1;
+	if( weaponChanged )
+	{
+		s_iMaxClipSeen = clip;
+		prevClip = clip;
+		return;
+	}
+	if( clip > s_iMaxClipSeen )
+		s_iMaxClipSeen = clip;
+
+	if( clip >= 0 && prevClip >= 0 && clip < prevClip && s_iMaxClipSeen > 1 )
+	{
+		const int low = s_iMaxClipSeen / 5 > 1 ? s_iMaxClipSeen / 5 : 1;
+		if( clip == 0 )
+			Access_Speak( "Chargeur vide", true );
+		else if( clip <= low )
+			Play( CUE_AMMO_LOW, Centered( 0.6f ) );
+	}
+	prevClip = clip;
+}
+
+// ---------------------------------------------------------------------------
+// Spoken queries
+// ---------------------------------------------------------------------------
+
+static void Cmd_Where( void )
+{
+	char buf[512];
+	int o = snprintf( buf, sizeof( buf ), "Face %s.", AccessMap_CompassWord( s_L.yaw ) );
+
+	const Target *t = s_szTargetName[0] ? CurrentTarget() : NULL;
+	if( t )
+	{
+		o += snprintf( buf + o, sizeof( buf ) - o, " Cible %s, %d mètres, à %s.", t->name,
+			Meters( ( t->pos - s_L.origin ).Length() ), ClockText( RelativeYaw( t->pos ) ) );
+	}
+
+	// Two closest objectives, straight-line.
+	RebuildTargets();
+	int first = -1, second = -1;
+	float d1 = 1e30f, d2 = 1e30f;
+	for( int i = 0; i < (int)s_Targets.size(); i++ )
+	{
+		const float d = ( s_Targets[i].pos - s_L.origin ).Length();
+		if( d < d1 ) { second = first; d2 = d1; first = i; d1 = d; }
+		else if( d < d2 ) { second = i; d2 = d; }
+	}
+	const int picks[2] = { first, second };
+	for( int k = 0; k < 2 && o < (int)sizeof( buf ); k++ )
+	{
+		if( picks[k] < 0 )
+			continue;
+		const Target &p = s_Targets[picks[k]];
+		o += snprintf( buf + o, sizeof( buf ) - o, " %s à %d mètres, %s.", p.name,
+			Meters( ( p.pos - s_L.origin ).Length() ), ClockText( RelativeYaw( p.pos ) ) );
+	}
+	if( !AccessMap_HasNav() && o < (int)sizeof( buf ) )
+		snprintf( buf + o, sizeof( buf ) - o, " Pas de carte de navigation." );
+	Access_Speak( buf, true );
+}
+
+static void Cmd_Compass( void )
+{
+	char buf[64];
+	snprintf( buf, sizeof( buf ), "Face %s, %d degrés", AccessMap_CompassWord( s_L.yaw ),
+		(int)( fmodf( 450.0f - s_L.yaw, 360.0f ) + 0.5f ) % 360 );
+	Access_Speak( buf, true );
+}
+
+static void Cmd_Enemies( void )
+{
+	if( gHUD.m_fPlayerDead || g_iUser1 || CL_IsDead() )
+	{
+		Access_Speak( "Vous êtes mort ou spectateur", true );
+		return;
+	}
+
+	char buf[256];
+	int count = 0, o = 0;
+	buf[0] = 0;
+	for( int i = 1; i <= MAX_PLAYERS; i++ )
+	{
+		if( !s_Players[i].visible )
+			continue;
+		cl_entity_t *ent = gEngfuncs.GetEntityByIndex( i );
+		if( !ent )
+			continue;
+		count++;
+		if( o < (int)sizeof( buf ) )
+			o += snprintf( buf + o, sizeof( buf ) - o, "%s%s %d mètres", count > 1 ? ", " : "",
+				ClockText( RelativeYaw( ent->origin ) ), Meters( ( ent->origin - s_L.eye ).Length() ) );
+	}
+	char out[320];
+	if( count == 0 )
+		snprintf( out, sizeof( out ), "Aucun ennemi en vue" );
+	else
+		snprintf( out, sizeof( out ), "%d ennemi%s en vue : %s", count, count > 1 ? "s" : "", buf );
+	Access_Speak( out, true );
+}
+
+// ---------------------------------------------------------------------------
+// Frame
+// ---------------------------------------------------------------------------
+
+static bool UpdateListener( cl_entity_t *local )
+{
+	float angles[3];
+	gEngfuncs.GetViewAngles( angles );
+
+	float viewOfs[3] = { 0, 0, 0 };
+	gEngfuncs.pEventAPI->EV_LocalPlayerViewheight( viewOfs );
+
+	s_L.origin = local->origin;
+	s_L.eye = s_L.origin + Vector( viewOfs[0], viewOfs[1], viewOfs[2] );
+	s_L.ducking = viewOfs[2] < 15.0f;
+	s_L.feetZ = s_L.origin.z - ( s_L.ducking ? 18.0f : 36.0f );
+	s_L.pitch = angles[0];
+	s_L.yaw = angles[1];
+	s_L.forward = Vector( cosf( angles[1] * DEG2RAD ) * cosf( angles[0] * DEG2RAD ),
+		sinf( angles[1] * DEG2RAD ) * cosf( angles[0] * DEG2RAD ), -sinf( angles[0] * DEG2RAD ) );
+	s_L.index = local->index;
+	s_L.team = g_PlayerExtraInfo[local->index].teamnumber;
+	return true;
+}
+
+// The client clock restarts at every map change; timers scheduled on the old
+// clock would otherwise stay silent for as long as the previous map ran.
+static void ResetTimers( void )
+{
+	s_flNextSonar = s_flNextLedge = s_flNextStep = 0.0f;
+	s_flNextScan = s_flNextRepath = s_flNextBeacon = 0.0f;
+	s_flNextAim = s_flNextGrenadeScan = s_flNextHeartbeat = 0.0f;
+	memset( s_Players, 0, sizeof( s_Players ) );
+	s_Grenades.clear();
+	s_iScanStep = -1;
+	StopGuidance();
+}
+
+void AccessNav_Frame( void )
+{
+	const char *level = gEngfuncs.pfnGetLevelName();
+	if( !level || !level[0] )
+		return;	// not in a game
+	AccessMap_Update( level );
+	if( access_cue_volume )
+		AccessAudio_SetMasterVolume( access_cue_volume->value );
+
+	cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	const float now = gEngfuncs.GetClientTime();
+	if( !local || gHUD.m_iIntermission )
+		return;
+
+	const float dt = now - s_flTime;
+	if( dt < 0.0f )
+		ResetTimers();
+	s_flTime = now;
+	UpdateListener( local );
+
+	// Motion estimate for sonar gating and ledge probing direction.
+	if( dt > 0.0f && dt < 0.5f )
+	{
+		Vector delta = s_L.origin - s_vecPrevOrigin;
+		delta.z = 0.0f;
+		const float speed = delta.Length() / dt;
+		s_flSpeed = s_flSpeed * 0.7f + speed * 0.3f;
+		if( speed > 5.0f )
+			s_vecMoveDir = delta.Normalize();
+		s_flTurnRate = s_flTurnRate * 0.7f + fabsf( NormalizeAngle( s_L.yaw - s_flPrevYaw ) ) / dt * 0.3f;
+	}
+	if( s_flSpeed < 30.0f || s_vecMoveDir.Length() < 0.5f )
+		s_vecMoveDir = DirFromYaw( s_L.yaw );
+
+	// No world cues while not playing yet or while a numbered menu (team, appearance,
+	// buy, radio) is open: the menu is being read aloud.
+	const bool dead = gHUD.m_fPlayerDead || g_iUser1 || CL_IsDead() || s_L.team == 0;
+	const bool alive = !dead && !gHUD.m_Menu.m_fMenuDisplayed;
+	if( dead )
+	{
+		// Dead or spectating: forget the route and what was in sight, so queries
+		// like access_enemies_list do not report the view from before death.
+		if( s_szTargetName[0] )
+			StopGuidance();
+		for( int i = 0; i <= MAX_PLAYERS; i++ )
+			s_Players[i].visible = false;
+	}
+	if( !alive )
+	{
+		// A menu only pauses the cues; guidance resumes when it closes.
+		s_iScanStep = -1;
+	}
+	else
+	{
+		BeginTraces();
+		UpdateSonar();
+		UpdateLedges();
+		UpdateScan();
+		UpdateGuidance();
+		UpdatePlayers( local );
+		EndTraces();
+
+		UpdateGrenades( local );
+		UpdateBody();
+	}
+
+	s_vecPrevOrigin = s_L.origin;
+	s_flPrevYaw = s_L.yaw;
+}
+
+void AccessNav_Init( void )
+{
+	access_cues         = CVAR_CREATE( "access_cues", "1", FCVAR_ARCHIVE );
+	access_cue_volume   = CVAR_CREATE( "access_cue_volume", "0.8", FCVAR_ARCHIVE );
+	access_sonar        = CVAR_CREATE( "access_sonar", "1", FCVAR_ARCHIVE );
+	access_sonar_range  = CVAR_CREATE( "access_sonar_range", "128", FCVAR_ARCHIVE );
+	access_ledges       = CVAR_CREATE( "access_ledges", "1", FCVAR_ARCHIVE );
+	access_enemies      = CVAR_CREATE( "access_enemies", "1", FCVAR_ARCHIVE );
+	access_enemy_fov    = CVAR_CREATE( "access_enemy_fov", "360", FCVAR_ARCHIVE );
+	access_teammates    = CVAR_CREATE( "access_teammates", "1", FCVAR_ARCHIVE );
+	access_aimcue       = CVAR_CREATE( "access_aimcue", "1", FCVAR_ARCHIVE );
+	access_aim_cone     = CVAR_CREATE( "access_aim_cone", "30", FCVAR_ARCHIVE );
+	access_grenades     = CVAR_CREATE( "access_grenades", "1", FCVAR_ARCHIVE );
+	access_compass_tick = CVAR_CREATE( "access_compass_tick", "1", FCVAR_ARCHIVE );
+	access_heartbeat    = CVAR_CREATE( "access_heartbeat", "1", FCVAR_ARCHIVE );
+
+	gEngfuncs.pfnAddCommand( "access_scan", Cmd_Scan );
+	gEngfuncs.pfnAddCommand( "access_target_next", Cmd_TargetNext );
+	gEngfuncs.pfnAddCommand( "access_target_prev", Cmd_TargetPrev );
+	gEngfuncs.pfnAddCommand( "access_target_stop", Cmd_TargetStop );
+	gEngfuncs.pfnAddCommand( "access_where", Cmd_Where );
+	gEngfuncs.pfnAddCommand( "access_compass", Cmd_Compass );
+	gEngfuncs.pfnAddCommand( "access_enemies_list", Cmd_Enemies );
+
+	if( !AccessAudio_Init() )
+		gEngfuncs.Con_Printf( "[access] XAudio2 indisponible : repères sonores désactivés.\n" );
+}
+
+void AccessNav_Shutdown( void )
+{
+	AccessAudio_Shutdown();
+}
