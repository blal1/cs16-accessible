+// A flashbang whites the screen out: say so, and for how long, as a sighted
+// player would notice. While blind, enemies are not reported as seen.
+static void UpdateBlindness( void )
+{
+	screenfade_t sf;
+	memset( &sf, 0, sizeof( sf ));
+	gEngfuncs.pfnGetScreenFade( &sf );
+	// Flashbangs use a fade-in: full white until fadeReset, then fading out
+	// linearly until fadeEnd. Blind while the white covers more than half.
+	const float threshold = 120.0f;
+	const bool white = sf.fader > 200 && sf.fadeg > 200 && sf.fadeb > 200 && sf.fadealpha > threshold;
+	float clearAt = 0.0f;	// when the white drops below the threshold
+	if( white && sf.fadeEnd > sf.fadeReset )
+		clearAt = sf.fadeReset + ( sf.fadeEnd - sf.fadeReset ) * ( 1.0f - threshold / sf.fadealpha );
+	const bool blind = white && clearAt > s_flTime + 0.3f;
+
+	if( blind && !s_bBlind )
+	{
+		char buf[64];
+		const int seconds = (int)( clearAt - s_flTime + 0.5f );
+		snprintf( buf, sizeof( buf ), "Aveuglé, %d seconde%s", seconds, seconds > 1 ? "s" : "" );
+		Access_Speak( buf, true );
+	}
+	else if( !blind && s_bBlind )
+		Access_Speak( "Vue revenue" );
+	s_bBlind = blind;
+}
+
+static void UpdateBody( void )
+{
+	if( access_heartbeat && access_heartbeat->value && s_iHealth > 0 && s_iHealth <= 25 && s_flTime >= s_flNextHeartbeat )
+	{
+		Play( CUE_HEARTBEAT, Centered( 0.5f ) );
+		s_flNextHeartbeat = s_flTime + 0.6f + s_iHealth * 0.03f;
+	}
+
+	if( access_compass_tick && access_compass_tick->value )
+	{
+		// Tick whenever the view sweeps across north (yaw 90).
+		const float a = NormalizeAngle( s_flPrevYaw - 90.0f ), b = NormalizeAngle( s_L.yaw - 90.0f );
+		if( ( a < 0.0f ) != ( b < 0.0f ) && fabsf( a ) < 90.0f && fabsf( b ) < 90.0f )
+			Play( CUE_NORTH, Centered( 0.4f ) );
+	}
+}
