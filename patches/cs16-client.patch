+// ", il reste 2 ennemis": players still alive on the victim's side, as the
+// scoreboard shows them to everyone.
+static void AppendSurvivors( char *buf, size_t size, int victimIndex )
+{
+	const cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	if( !local || victimIndex <= 0 || victimIndex > MAX_PLAYERS )
+		return;
+	const int ourTeam = g_PlayerExtraInfo[local->index].teamnumber;
+	const int theirTeam = g_PlayerExtraInfo[victimIndex].teamnumber;
+	if( ( ourTeam != 1 && ourTeam != 2 ) || ( theirTeam != 1 && theirTeam != 2 ))
+		return;
+
+	int alive = 0;
+	for( int i = 1; i <= MAX_PLAYERS && i <= gEngfuncs.GetMaxClients(); i++ )
+	{
+		if( i == victimIndex || g_PlayerExtraInfo[i].teamnumber != theirTeam || g_PlayerExtraInfo[i].dead )
+			continue;
+		GetPlayerInfo( i, &g_PlayerInfoList[i] );
+		if( g_PlayerInfoList[i].name && g_PlayerInfoList[i].name[0] )
+			alive++;
+	}
+
+	const size_t len = strlen( buf );
+	if( theirTeam != ourTeam )
+	{
+		if( alive == 0 )
+			snprintf( buf + len, size - len, ", plus aucun ennemi" );
+		else
+			snprintf( buf + len, size - len, ", il reste %d ennemi%s", alive, alive > 1 ? "s" : "" );
+	}
+	else if( alive == 0 )
+		snprintf( buf + len, size - len, ", plus aucun coéquipier en vie" );
+	else
+		snprintf( buf + len, size - len, ", %d coéquipier%s en vie", alive, alive > 1 ? "s" : "" );
+}
+
+void Access_OnDeath( const char *killer, const char *victim, const char *weapon,
+	bool headshot, bool localIsKiller, bool localIsVictim, int victimIndex )
+{
+	if( !SpeechEnabled( access_speech_kills ) && !localIsVictim && !localIsKiller )
+		return;
+	if( !SpeechEnabled( NULL ) )
+		return;
+
+	const char *w = Access_WeaponName( weapon );
+	const char *hs = headshot ? ", tir à la tête" : "";
+	char buf[256];
+
+	if( localIsVictim && localIsKiller )
+		snprintf( buf, sizeof( buf ), "Vous vous êtes tué" );
+	else if( localIsVictim )
+		snprintf( buf, sizeof( buf ), "Vous êtes mort, tué par %s, %s%s", killer[0] ? killer : "le monde", w, hs );
+	else if( localIsKiller )
+		snprintf( buf, sizeof( buf ), "Vous avez tué %s, %s%s", victim, w, hs );
+	else if( killer[0] && strcmp( killer, victim ) )
+		snprintf( buf, sizeof( buf ), "%s a tué %s, %s%s", killer, victim, w, hs );
+	else
+		snprintf( buf, sizeof( buf ), "%s est mort", victim );
+	AppendSurvivors( buf, sizeof( buf ), victimIndex );
+
+	Access_Speak( buf, localIsVictim );
+}
+
+void Access_OnProgressBar( int duration )
+{
+	// The server also clears the bar at every round start: "stopped" is only
+	// news while an action was still running (before its planned end).
+	static unsigned int s_uEnd;
+	const unsigned int now = AccessTts_Ticks();
+	const bool wasRunning = s_uEnd && (int)( s_uEnd - now ) > 200;
+	s_uEnd = duration > 0 ? now + duration * 1000u : 0;
+	if( !SpeechEnabled( access_speech_hud ) || Access_IsSpectating() || ( duration <= 0 && !wasRunning ))
+		return;
+	char buf[96];
+	if( duration <= 0 )
+		snprintf( buf, sizeof( buf ), "Action interrompue" );
+	else
+		snprintf( buf, sizeof( buf ), "Action en cours, %d seconde%s, ne bougez pas", duration, duration > 1 ? "s" : "" );
+	Access_Speak( buf, true );
+}
+
+void Access_OnVoice( int entindex, bool talking )
+{
+	if( !talking || !SpeechEnabled( access_speech_voice ) || entindex <= 0 || entindex > MAX_PLAYERS )
+		return;
+	const cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	if( local && local->index == entindex )
+		return;
+	// Someone holding the key speaks for a while: name them once per 20 s.
+	static float s_flLastSaid[MAX_PLAYERS + 1];
+	if( s_flLastSaid[entindex] && gHUD.m_flTime - s_flLastSaid[entindex] < 20.0f && gHUD.m_flTime >= s_flLastSaid[entindex] )
+		return;
+	s_flLastSaid[entindex] = gHUD.m_flTime;
+
+	GetPlayerInfo( entindex, &g_PlayerInfoList[entindex] );
+	if( !g_PlayerInfoList[entindex].name || !g_PlayerInfoList[entindex].name[0] )
+		return;
+	char buf[96];
+	snprintf( buf, sizeof( buf ), "%s parle", g_PlayerInfoList[entindex].name );
+	Access_Speak( buf );
+}
+
+void Access_OnStatusIcon( const char *icon, int state )
+{
+	// Icons of the watched player (bomb, buy zone) are not ours.
+	if( Access_IsSpectating() )
+		return;
+
+	// C4 icon: state 1 = carrying the bomb, 2 = flashing inside a bomb site.
+	if( !stricmp( icon, "c4" ))
+	{
+		static int c4State;
+		if( state == c4State )
+			return;
+		const char *text = NULL;
+		if( state == 2 )
+			text = "Site de bombe, vous pouvez poser la bombe";
+		else if( state == 1 && c4State == 2 )
+			text = "Hors du site de bombe";
+		else if( state == 1 )
+			text = "Vous portez la bombe";
+		c4State = state;
+		if( text && SpeechEnabled( access_speech_hud ) )
+			Access_Speak( text );
+		return;
+	}
+
+	const bool enabled = state != 0;
+	static const struct { const char *icon; const char *enter; const char *leave; } zones[] =
+	{
+		{ "buyzone", "Zone d'achat", "Hors zone d'achat" },
+		// Rescue, escape and VIP zones are named on entry by access_nav
+		// ("Vous entrez : zone de sauvetage ouest"): not repeated here.
+		{ "rescue", NULL, NULL },
+		{ "escape", NULL, NULL },
+		{ "vipsafety", NULL, NULL },
+		{ "defuser", "Kit de désamorçage équipé", NULL },
+		// Damage-over-time pictures (and mods reuse them).
+		{ "dmg_poison", "Empoisonné", "Fin du poison" },
+		{ "dmg_rad", "Radiation", "Fin des radiations" },
+		{ "dmg_heat", "Brûlure", NULL },
+		{ "dmg_cold", "Froid", NULL },
+		{ "dmg_drown", "Vous vous noyez", NULL },
+		{ "dmg_shock", "Électrocution", NULL },
+		{ "dmg_gas", "Gaz", NULL },
+		{ "dmg_bio", "Contamination", NULL },
+		{ "dmg_chem", "Produit chimique", NULL },
+	};
+	static bool active[ACCESS_ARRAYSIZE( zones )];
+
+	for( size_t i = 0; i < ACCESS_ARRAYSIZE( zones ); i++ )
+	{
+		if( stricmp( icon, zones[i].icon ) )
+			continue;
+		// The server resends enabled icons (e.g. flashing C4); only announce transitions.
+		if( active[i] == enabled )
+			return;
+		active[i] = enabled;
+
+		if( i == 0 )
+			s_bInBuyZone = enabled;
+		const char *text = enabled ? zones[i].enter : zones[i].leave;
+		if( text && SpeechEnabled( access_speech_hud ) )
+			Access_Speak( text );
+		return;
+	}
+
+	// An icon of a mod (a picture only): say its name once per session, so the
+	// player knows something appeared ("Icône du serveur : frozen").
+	static char s_szToldIcons[1024];
+	if( enabled && SpeechEnabled( access_speech_hud ) && strlen( icon ) < 48 )
+	{
+		char tag[64];
+		snprintf( tag, sizeof( tag ), "|%s|", icon );
+		if( !strstr( s_szToldIcons, tag ) && strlen( s_szToldIcons ) + strlen( tag ) < sizeof( s_szToldIcons ))
+		{
+			strcat( s_szToldIcons, tag );
+			char buf[96];
+			snprintf( buf, sizeof( buf ), "Icône du serveur : %s", icon );
+			for( char *c = buf; *c; c++ )
+				if( *c == '_' )
+					*c = ' ';
+			Access_Speak( buf );
+		}
+	}
+}
+
+void Access_OnPickup( const char *name )
+{
+	// Buying also "picks up": only items found on the ground are news.
+	if( !name || !name[0] || s_bInBuyZone || Access_IsSpectating() || !SpeechEnabled( access_speech_hud ))
+		return;
+	// Spawn loadout: arrives before any weapon is in hand (or right after respawning).
+	if( !s_szWeapon[0] || ( gHUD.m_flTime - s_flSpawnTime < 3.0f && gHUD.m_flTime >= s_flSpawnTime ))
+		return;
+	static const struct { const char *id; const char *spoken; } items[] =
+	{
+		{ "item_kevlar", "gilet pare-balles" }, { "item_assaultsuit", "gilet et casque" },
+		{ "item_thighpack", "kit de désamorçage" }, { "item_battery", "armure" },
+		{ "item_healthkit", "trousse de soins" }, { "item_longjump", "module de saut" },
+	};
+	const char *spoken = NULL;
+	for( size_t i = 0; i < ACCESS_ARRAYSIZE( items ) && !spoken; i++ )
+		if( !stricmp( name, items[i].id ))
+			spoken = items[i].spoken;
+	if( !spoken )
+		spoken = Access_WeaponName( name );
+	char buf[96];
+	snprintf( buf, sizeof( buf ), "Ramassé : %s", spoken );
+	Access_Speak( buf );
+}
+
+static void Access_Cmd_Status( void )
+{
+	char buf[256];
+	int o = 0;
+
+	if( Access_IsSpectating() )
+	{
+		// The HUD shows the watched player: say who it is, and our own money.
+		extern int g_iUser2;
+		const char *watched = NULL;
+		if( g_iUser2 > 0 && g_iUser2 <= MAX_PLAYERS )
+		{
+			GetPlayerInfo( g_iUser2, &g_PlayerInfoList[g_iUser2] );
+			watched = g_PlayerInfoList[g_iUser2].name;
+		}
+		o += snprintf( buf, sizeof( buf ), watched ? "Spectateur, vous regardez %s" : "Spectateur%s", watched ? watched : "" );
+		// First-person view: the HUD (hence our cache) shows the watched player.
+		if( g_iUser1 == 4 && watched && s_iHealth > 0 && o < (int)sizeof( buf ))
+		{
+			o += snprintf( buf + o, sizeof( buf ) - o, ", santé %d", s_iHealth );
+			if( s_szWeapon[0] && o < (int)sizeof( buf ))
+				o += snprintf( buf + o, sizeof( buf ) - o, ", %s", s_szWeapon );
+		}
+		if( s_iMoney >= 0 && o < (int)sizeof( buf ) )
+			snprintf( buf + o, sizeof( buf ) - o, ". Vous avez %d dollars", s_iMoney );
+		if( access_speech && access_speech->value )
+			Access_Speak( buf, true );
+		return;
+	}
+
+	o += snprintf( buf + o, sizeof( buf ) - o, "Santé %d, armure %d", s_iHealth < 0 ? 0 : s_iHealth, s_iArmor < 0 ? 0 : s_iArmor );
+	if( s_iMoney >= 0 && o < (int)sizeof( buf ) )
+		o += snprintf( buf + o, sizeof( buf ) - o, ", %d dollars", s_iMoney );
+	if( s_szWeapon[0] && o < (int)sizeof( buf ) )
+	{
+		if( s_iClip >= 0 )
+			snprintf( buf + o, sizeof( buf ) - o, ", %s, %d balles, réserve %d", s_szWeapon, s_iClip, s_iReserve );
+		else
+			snprintf( buf + o, sizeof( buf ) - o, ", %s", s_szWeapon );
+	}
+
+	// Explicit request: speak even if HUD announcements are muted.
+	if( access_speech && access_speech->value )
+	{
+		char clean[256];
+		CleanForSpeech( buf, clean, sizeof( clean ) );
+		SpeakRaw( clean, true );
+	}
+}
+
+static void Access_Cmd_Repeat( void )
+{
+	if( s_szLastSpoken[0] && access_speech && access_speech->value )
+	{
+		char copy[sizeof( s_szLastSpoken )];
+		strcpy( copy, s_szLastSpoken );
+		SpeakRaw( copy, true );
+	}
+}
+
+static void Access_Cmd_Say( void )
+{
+	char buf[512];
+	buf[0] = 0;
+	for( int i = 1; i < gEngfuncs.Cmd_Argc(); i++ )
+	{
+		if( i > 1 )
+			strncat( buf, " ", sizeof( buf ) - strlen( buf ) - 1 );
+		strncat( buf, gEngfuncs.Cmd_Argv( i ), sizeof( buf ) - strlen( buf ) - 1 );
+	}
+	Access_Speak( buf, true );
+}
+
+static void Access_Cmd_Silence( void )
+{
+	AccessTts_Cancel();
+}
+
+void Access_Init( void )
+{
+	access_speech       = CVAR_CREATE( "access_speech", "1", FCVAR_ARCHIVE );
+	access_speech_chat  = CVAR_CREATE( "access_speech_chat", "1", FCVAR_ARCHIVE );
+	access_speech_kills = CVAR_CREATE( "access_speech_kills", "1", FCVAR_ARCHIVE );
+	access_speech_hud   = CVAR_CREATE( "access_speech_hud", "1", FCVAR_ARCHIVE );
+	access_textmenus    = CVAR_CREATE( "access_textmenus", "1", FCVAR_ARCHIVE );
+	access_speech_voice = CVAR_CREATE( "access_speech_voice", "1", FCVAR_ARCHIVE );
+	access_debug        = CVAR_CREATE( "access_debug", "0", FCVAR_ARCHIVE );
+
+	gEngfuncs.pfnAddCommand( "access_status", Access_Cmd_Status );
+	gEngfuncs.pfnAddCommand( "access_repeat", Access_Cmd_Repeat );
+	gEngfuncs.pfnAddCommand( "access_say", Access_Cmd_Say );
+	gEngfuncs.pfnAddCommand( "access_silence", Access_Cmd_Silence );
+
+	AccessNav_Init();
+	AccessScreens_Init();
+}
