diff --git a/cl_dll/accessibility/access_audio.cpp b/cl_dll/accessibility/access_audio.cpp
new file mode 100644
index 0000000..717c118
--- /dev/null
+++ b/cl_dll/accessibility/access_audio.cpp
@@ -0,0 +1,410 @@
+/*
+access_audio.cpp - procedurally synthesized audio cues (XAudio2)
+
+Deliberately engine-free: this file only sees Windows and XAudio2, so it can
+raise _WIN32_WINNT for xaudio2.h without touching the rest of the client.
+xaudio2_9.dll ships with Windows 10+ and is loaded at runtime; without it the
+cues are silently disabled.
+*/
+
+#undef _WIN32_WINNT
+#define _WIN32_WINNT 0x0A00
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#define XAUDIO2_HELPER_FUNCTIONS
+#include <xaudio2.h>
+
+#include <math.h>
+#include <string.h>
+#include <vector>
+
+#include "access_audio.h"
+
+#pragma comment( lib, "ole32.lib" )
+
+static const UINT32 SAMPLE_RATE = 44100;
+static const int VOICE_COUNT = 32;
+static const float PI_F = 3.14159265358979f;
+
+typedef HRESULT ( __stdcall *XAudio2Create_t )( IXAudio2 **ppXAudio2, UINT32 flags, XAUDIO2_PROCESSOR processor );
+
+struct CueVoice
+{
+	IXAudio2SourceVoice *voice;
+	DWORD startTick;
+};
+
+static HMODULE s_hXAudio;
+static IXAudio2 *s_pEngine;
+static IXAudio2MasteringVoice *s_pMaster;
+static CueVoice s_Voices[VOICE_COUNT];
+static std::vector<float> s_Cues[CUE_COUNT];
+static float s_flMasterVolume = 0.8f;
+static bool s_bInitTried;
+
+// XAudio2's mastering voice needs COM. The game thread's apartment belongs to the
+// engine, so a dedicated thread joins the multithreaded apartment, owns creation
+// and teardown, and keeps the MTA alive; XAudio2 calls from other threads are safe.
+static HANDLE s_hAudioThread;
+static HANDLE s_hReadyEvent;
+static HANDLE s_hQuitEvent;
+static bool s_bThreadInitOk;
+
+// ---------------------------------------------------------------------------
+// Synthesis helpers. All cues are mono float PCM at SAMPLE_RATE.
+// ---------------------------------------------------------------------------
+
+static unsigned int s_NoiseState = 0x12345678u;
+
+static float Noise( void )
+{
+	s_NoiseState ^= s_NoiseState << 13;
+	s_NoiseState ^= s_NoiseState >> 17;
+	s_NoiseState ^= s_NoiseState << 5;
+	return (float)( s_NoiseState & 0xFFFFFF ) / (float)0x7FFFFF - 1.0f;
+}
+
+// Linear attack then exponential decay reaching ~e^-decayRate at the end, with a
+// 3 ms fade-out so buffers never end on a click.
+static float Envelope( float t, float attack, float duration, float decayRate )
+{
+	float e;
+	if( t < attack )
+		e = t / attack;
+	else
+		e = expf( -decayRate * ( t - attack ) / ( duration - attack ) );
+
+	const float fadeOut = 0.003f;
+	if( t > duration - fadeOut )
+		e *= ( duration - t ) / fadeOut;
+	return e < 0.0f ? 0.0f : e;
+}
+
+static int Samples( float seconds )
+{
+	return (int)( seconds * SAMPLE_RATE );
+}
+
+// Appends a tone whose frequency glides exponentially from f0 to f1.
+// harmonics[] gives the relative amplitude of partials 1..n.
+static void AddTone( std::vector<float> &out, int offset, float duration, float f0, float f1,
+	const float *harmonics, int harmonicCount, float attack, float decayRate, float gain )
+{
+	const int n = Samples( duration );
+	if( (int)out.size() < offset + n )
+		out.resize( offset + n, 0.0f );
+
+	double phase = 0.0;
+	for( int i = 0; i < n; i++ )
+	{
+		const float t = (float)i / SAMPLE_RATE;
+		const float f = f0 * powf( f1 / f0, t / duration );
+		phase += 2.0 * PI_F * f / SAMPLE_RATE;
+
+		float s = 0.0f;
+		for( int h = 0; h < harmonicCount; h++ )
+			s += harmonics[h] * sinf( (float)( phase * ( h + 1 ) ) );
+
+		out[offset + i] += s * gain * Envelope( t, attack, duration, decayRate );
+	}
+}
+
+// Appends band-limited noise (one-pole high-pass then low-pass).
+static void AddNoise( std::vector<float> &out, int offset, float duration, float highPassHz, float lowPassHz,
+	float attack, float decayRate, float gain )
+{
+	const int n = Samples( duration );
+	if( (int)out.size() < offset + n )
+		out.resize( offset + n, 0.0f );
+
+	const float hpA = expf( -2.0f * PI_F * highPassHz / SAMPLE_RATE );
+	const float lpA = expf( -2.0f * PI_F * lowPassHz / SAMPLE_RATE );
+	float hpLow = 0.0f, lp = 0.0f;
+
+	for( int i = 0; i < n; i++ )
+	{
+		const float t = (float)i / SAMPLE_RATE;
+		const float x = Noise();
+		hpLow = hpA * hpLow + ( 1.0f - hpA ) * x;
+		const float hp = x - hpLow;
+		lp = lpA * lp + ( 1.0f - lpA ) * hp;
+		out[offset + i] += lp * gain * Envelope( t, attack, duration, decayRate );
+	}
+}
+
+static void Normalize( std::vector<float> &buf, float peak )
+{
+	float m = 0.0f;
+	for( float s : buf )
+		m = fabsf( s ) > m ? fabsf( s ) : m;
+	if( m > 0.0f )
+		for( float &s : buf )
+			s *= peak / m;
+}
+
+static void BuildCues( void )
+{
+	static const float pure[] = { 1.0f };
+	static const float warm[] = { 1.0f, 0.3f };
+	static const float soft_square[] = { 1.0f, 0.0f, 0.33f, 0.0f, 0.2f };
+	static const float chirp[] = { 1.0f, 0.0f, 0.25f };
+
+	// Cane-like tap: short bright noise burst.
+	AddNoise( s_Cues[CUE_WALL_TAP], 0, 0.030f, 1500.0f, 5500.0f, 0.001f, 7.0f, 1.0f );
+
+	// Same tap with a ringing partial, so "wall ahead" is distinct from "wall beside".
+	AddNoise( s_Cues[CUE_WALL_FRONT], 0, 0.030f, 1500.0f, 5500.0f, 0.001f, 7.0f, 1.0f );
+	AddTone( s_Cues[CUE_WALL_FRONT], 0, 0.060f, 1400.0f, 1400.0f, pure, 1, 0.001f, 6.0f, 0.6f );
+
+	AddTone( s_Cues[CUE_LEDGE], 0, 0.170f, 900.0f, 240.0f, chirp, 3, 0.005f, 2.5f, 1.0f );
+	AddTone( s_Cues[CUE_STEP], 0, 0.110f, 380.0f, 950.0f, chirp, 3, 0.005f, 2.5f, 1.0f );
+
+	// Bell: inharmonic partial decays faster than the fundamental.
+	AddTone( s_Cues[CUE_BEACON], 0, 0.300f, 880.0f, 880.0f, warm, 2, 0.002f, 4.0f, 1.0f );
+	AddTone( s_Cues[CUE_BEACON], 0, 0.120f, 880.0f * 2.76f, 880.0f * 2.76f, pure, 1, 0.001f, 5.0f, 0.35f );
+
+	// Major arpeggio C5 E5 G5 C6.
+	const float notes[] = { 523.25f, 659.25f, 783.99f, 1046.5f };
+	for( int i = 0; i < 4; i++ )
+		AddTone( s_Cues[CUE_ARRIVED], Samples( 0.09f * i ), i == 3 ? 0.35f : 0.12f, notes[i], notes[i], warm, 2, 0.004f, 3.0f, 1.0f );
+
+	// Two-tone alert (falling fourth) with a buzzy timbre.
+	AddTone( s_Cues[CUE_ENEMY], 0, 0.100f, 440.0f, 440.0f, soft_square, 5, 0.004f, 1.5f, 1.0f );
+	AddTone( s_Cues[CUE_ENEMY], Samples( 0.100f ), 0.110f, 330.0f, 330.0f, soft_square, 5, 0.004f, 2.0f, 1.0f );
+
+	AddTone( s_Cues[CUE_TEAMMATE], 0, 0.070f, 520.0f, 520.0f, warm, 2, 0.006f, 3.0f, 1.0f );
+
+	AddTone( s_Cues[CUE_AIM], 0, 0.045f, 660.0f, 660.0f, pure, 1, 0.003f, 2.0f, 1.0f );
+
+	AddNoise( s_Cues[CUE_AIM_LOCK], 0, 0.004f, 2000.0f, 9000.0f, 0.0005f, 3.0f, 0.8f );
+	AddTone( s_Cues[CUE_AIM_LOCK], 0, 0.055f, 1760.0f, 1760.0f, warm, 2, 0.001f, 4.0f, 0.9f );
+
+	// Marimba: fundamental plus a quickly damped 4th partial.
+	AddTone( s_Cues[CUE_OBJECTIVE], 0, 0.320f, 587.33f, 587.33f, pure, 1, 0.002f, 5.0f, 1.0f );
+	AddTone( s_Cues[CUE_OBJECTIVE], 0, 0.060f, 587.33f * 4.0f, 587.33f * 4.0f, pure, 1, 0.001f, 6.0f, 0.4f );
+
+	AddTone( s_Cues[CUE_NORTH], 0, 0.025f, 1900.0f, 1900.0f, pure, 1, 0.0005f, 8.0f, 1.0f );
+	AddNoise( s_Cues[CUE_NORTH], 0, 0.006f, 1000.0f, 6000.0f, 0.0005f, 4.0f, 0.4f );
+
+	AddTone( s_Cues[CUE_SCAN], 0, 0.060f, 700.0f, 700.0f, pure, 1, 0.003f, 3.0f, 1.0f );
+
+	AddNoise( s_Cues[CUE_OPENING], 0, 0.160f, 300.0f, 1800.0f, 0.040f, 2.0f, 1.0f );
+
+	// Thud: pitched-down sine sweep with a noise transient.
+	AddTone( s_Cues[CUE_DAMAGE], 0, 0.180f, 160.0f, 55.0f, warm, 2, 0.002f, 3.0f, 1.0f );
+	AddNoise( s_Cues[CUE_DAMAGE], 0, 0.020f, 100.0f, 1200.0f, 0.001f, 4.0f, 0.6f );
+
+	// Rattle: 6 quick metallic ticks.
+	for( int i = 0; i < 6; i++ )
+	{
+		AddNoise( s_Cues[CUE_GRENADE], Samples( 0.035f * i ), 0.020f, 3000.0f, 9000.0f, 0.0005f, 6.0f, 1.0f );
+		AddTone( s_Cues[CUE_GRENADE], Samples( 0.035f * i ), 0.025f, 2600.0f, 2600.0f, pure, 1, 0.0005f, 7.0f, 0.5f );
+	}
+
+	AddTone( s_Cues[CUE_HEARTBEAT], 0, 0.110f, 70.0f, 50.0f, warm, 2, 0.004f, 3.0f, 1.0f );
+	AddTone( s_Cues[CUE_HEARTBEAT], Samples( 0.170f ), 0.120f, 60.0f, 45.0f, warm, 2, 0.004f, 3.0f, 0.8f );
+
+	AddNoise( s_Cues[CUE_AMMO_LOW], 0, 0.012f, 2500.0f, 7000.0f, 0.0005f, 5.0f, 1.0f );
+	AddNoise( s_Cues[CUE_AMMO_LOW], Samples( 0.060f ), 0.012f, 2500.0f, 7000.0f, 0.0005f, 5.0f, 0.8f );
+
+	AddTone( s_Cues[CUE_ENEMY_SPOTTED], 0, 0.080f, 600.0f, 1500.0f, soft_square, 5, 0.002f, 2.0f, 1.0f );
+
+	for( int i = 0; i < CUE_COUNT; i++ )
+		Normalize( s_Cues[i], 0.8f );
+}
+
+// ---------------------------------------------------------------------------
+// Playback
+// ---------------------------------------------------------------------------
+
+static void ReleaseEngine( void );
+
+static bool CreateEngine( void )
+{
+	s_hXAudio = LoadLibraryW( L"xaudio2_9.dll" );
+	if( !s_hXAudio )
+		return false;
+
+	XAudio2Create_t pfnCreate = (XAudio2Create_t)GetProcAddress( s_hXAudio, "XAudio2Create" );
+	if( !pfnCreate || FAILED( pfnCreate( &s_pEngine, 0, XAUDIO2_DEFAULT_PROCESSOR ) ) )
+	{
+		ReleaseEngine();
+		return false;
+	}
+
+	// Force a stereo mix so panning maps 1:1 to headphones.
+	if( FAILED( s_pEngine->CreateMasteringVoice( &s_pMaster, 2, SAMPLE_RATE ) ) )
+	{
+		ReleaseEngine();
+		return false;
+	}
+
+	WAVEFORMATEX wfx = {};
+	wfx.wFormatTag = WAVE_FORMAT_IEEE_FLOAT;
+	wfx.nChannels = 1;
+	wfx.nSamplesPerSec = SAMPLE_RATE;
+	wfx.wBitsPerSample = 32;
+	wfx.nBlockAlign = 4;
+	wfx.nAvgBytesPerSec = SAMPLE_RATE * 4;
+
+	for( int i = 0; i < VOICE_COUNT; i++ )
+	{
+		if( FAILED( s_pEngine->CreateSourceVoice( &s_Voices[i].voice, &wfx, XAUDIO2_VOICE_USEFILTER, 4.0f ) ) )
+			s_Voices[i].voice = NULL;
+	}
+
+	BuildCues();
+	return true;
+}
+
+static DWORD WINAPI AudioThread( LPVOID )
+{
+	const HRESULT com = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+	s_bThreadInitOk = SUCCEEDED( com ) && CreateEngine();
+	SetEvent( s_hReadyEvent );
+
+	if( s_bThreadInitOk )
+		WaitForSingleObject( s_hQuitEvent, INFINITE );
+
+	ReleaseEngine();
+	if( SUCCEEDED( com ) )
+		CoUninitialize();
+	return 0;
+}
+
+bool AccessAudio_Init( void )
+{
+	if( s_bInitTried )
+		return s_pMaster != NULL;
+	s_bInitTried = true;
+
+	s_hReadyEvent = CreateEventW( NULL, TRUE, FALSE, NULL );
+	s_hQuitEvent = CreateEventW( NULL, TRUE, FALSE, NULL );
+	if( !s_hReadyEvent || !s_hQuitEvent )
+		return false;
+
+	s_hAudioThread = CreateThread( NULL, 0, AudioThread, NULL, 0, NULL );
+	if( !s_hAudioThread || WaitForSingleObject( s_hReadyEvent, 5000 ) != WAIT_OBJECT_0 )
+		return false;
+	return s_bThreadInitOk;
+}
+
+void AccessAudio_Shutdown( void )
+{
+	if( s_hAudioThread )
+	{
+		SetEvent( s_hQuitEvent );
+		WaitForSingleObject( s_hAudioThread, 5000 );
+		CloseHandle( s_hAudioThread );
+		s_hAudioThread = NULL;
+	}
+	if( s_hReadyEvent )
+	{
+		CloseHandle( s_hReadyEvent );
+		s_hReadyEvent = NULL;
+	}
+	if( s_hQuitEvent )
+	{
+		CloseHandle( s_hQuitEvent );
+		s_hQuitEvent = NULL;
+	}
+}
+
+static void ReleaseEngine( void )
+{
+	for( int i = 0; i < VOICE_COUNT; i++ )
+	{
+		if( s_Voices[i].voice )
+		{
+			s_Voices[i].voice->DestroyVoice();
+			s_Voices[i].voice = NULL;
+		}
+	}
+	if( s_pMaster )
+	{
+		s_pMaster->DestroyVoice();
+		s_pMaster = NULL;
+	}
+	if( s_pEngine )
+	{
+		s_pEngine->Release();
+		s_pEngine = NULL;
+	}
+	if( s_hXAudio )
+	{
+		FreeLibrary( s_hXAudio );
+		s_hXAudio = NULL;
+	}
+}
+
+bool AccessAudio_IsReady( void )
+{
+	return s_pMaster != NULL;
+}
+
+void AccessAudio_SetMasterVolume( float volume )
+{
+	s_flMasterVolume = volume < 0.0f ? 0.0f : ( volume > 2.0f ? 2.0f : volume );
+}
+
+static float Clamp( float v, float lo, float hi )
+{
+	return v < lo ? lo : ( v > hi ? hi : v );
+}
+
+void AccessAudio_Play( AccessCue cue, const AccessCueParams &params )
+{
+	if( !s_pMaster || cue < 0 || cue >= CUE_COUNT || s_Cues[cue].empty() )
+		return;
+
+	const float gain = Clamp( params.gain, 0.0f, 1.0f ) * s_flMasterVolume;
+	if( gain <= 0.001f )
+		return;
+
+	// Free voice first; otherwise steal the one that started longest ago.
+	CueVoice *slot = NULL;
+	for( int i = 0; i < VOICE_COUNT; i++ )
+	{
+		if( !s_Voices[i].voice )
+			continue;
+		XAUDIO2_VOICE_STATE state;
+		s_Voices[i].voice->GetState( &state, XAUDIO2_VOICE_NOSAMPLESPLAYED );
+		if( state.BuffersQueued == 0 )
+		{
+			slot = &s_Voices[i];
+			break;
+		}
+		if( !slot || (LONG)( s_Voices[i].startTick - slot->startTick ) < 0 )
+			slot = &s_Voices[i];
+	}
+	if( !slot )
+		return;
+
+	IXAudio2SourceVoice *v = slot->voice;
+	v->Stop( 0 );
+	v->FlushSourceBuffers();
+
+	XAUDIO2_BUFFER buffer = {};
+	buffer.Flags = XAUDIO2_END_OF_STREAM;
+	buffer.AudioBytes = (UINT32)( s_Cues[cue].size() * sizeof( float ) );
+	buffer.pAudioData = (const BYTE *)s_Cues[cue].data();
+	if( FAILED( v->SubmitSourceBuffer( &buffer ) ) )
+		return;
+
+	// Equal-power pan.
+	const float angle = ( Clamp( params.pan, -1.0f, 1.0f ) + 1.0f ) * PI_F * 0.25f;
+	float matrix[2] = { cosf( angle ) * gain, sinf( angle ) * gain };
+	v->SetOutputMatrix( s_pMaster, 1, 2, matrix );
+
+	const float muffle = Clamp( params.muffle, 0.0f, 1.0f );
+	v->SetFrequencyRatio( Clamp( params.pitch * ( 1.0f - 0.06f * muffle ), 0.25f, 4.0f ) );
+
+	XAUDIO2_FILTER_PARAMETERS filter;
+	filter.Type = LowPassFilter;
+	filter.Frequency = XAudio2CutoffFrequencyToRadians( 16000.0f - 14800.0f * muffle, SAMPLE_RATE );
+	filter.OneOverQ = 1.0f;
+	v->SetFilterParameters( &filter );
+
+	slot->startTick = GetTickCount();
+	v->Start( 0 );
+}
diff --git a/cl_dll/accessibility/access_audio.h b/cl_dll/accessibility/access_audio.h
new file mode 100644
index 0000000..f238b9d
--- /dev/null
+++ b/cl_dll/accessibility/access_audio.h
@@ -0,0 +1,45 @@
+/*
+access_audio.h - procedurally synthesized audio cues (XAudio2), independent of the engine sound system
+*/
+#pragma once
+
+// Every cue is synthesized once at startup; see BuildCues() for the recipes.
+enum AccessCue
+{
+	CUE_WALL_TAP = 0,	// short filtered-noise tap: wall to the side
+	CUE_WALL_FRONT,		// tap with a tonal ring: wall in front
+	CUE_LEDGE,			// falling chirp: drop ahead
+	CUE_STEP,			// rising chirp: obstacle low enough to jump over
+	CUE_BEACON,			// bell: next guidance waypoint
+	CUE_ARRIVED,		// rising arpeggio: guidance target reached
+	CUE_ENEMY,			// two-tone buzz: visible enemy
+	CUE_TEAMMATE,		// soft blip: nearby teammate
+	CUE_AIM,			// pure tone, pitched by aim error
+	CUE_AIM_LOCK,		// bright click: crosshair on target
+	CUE_OBJECTIVE,		// marimba: objective (bomb) beacon
+	CUE_NORTH,			// wood tick: compass north crossing
+	CUE_SCAN,			// sine blip, pitched by distance: radar sweep wall echo
+	CUE_OPENING,		// breathy noise: radar sweep finds open space (corridor, door)
+	CUE_DAMAGE,			// low thud: you were hit, from that direction
+	CUE_GRENADE,		// rattle: live grenade nearby
+	CUE_HEARTBEAT,		// double thump: health critical
+	CUE_AMMO_LOW,		// dry click: magazine almost empty
+	CUE_ENEMY_SPOTTED,	// sharp rising blip: an enemy just came into view
+
+	CUE_COUNT
+};
+
+// Spatial parameters, already resolved relative to the listener.
+struct AccessCueParams
+{
+	float pan;		// -1 = hard left, +1 = hard right
+	float gain;		// 0..1, multiplied by the master volume
+	float pitch;	// frequency ratio, 1 = unchanged (clamped to 0.25..4)
+	float muffle;	// 0 = in front, 1 = directly behind (low-pass + slight dulling)
+};
+
+bool AccessAudio_Init( void );
+void AccessAudio_Shutdown( void );
+bool AccessAudio_IsReady( void );
+void AccessAudio_SetMasterVolume( float volume );
+void AccessAudio_Play( AccessCue cue, const AccessCueParams &params );
diff --git a/cl_dll/accessibility/access_map.cpp b/cl_dll/accessibility/access_map.cpp
new file mode 100644
index 0000000..861de0f
--- /dev/null
+++ b/cl_dll/accessibility/access_map.cpp
@@ -0,0 +1,618 @@
+/*
+access_map.cpp - map knowledge for navigation
+
+Formats:
+- BSP v30: entity lump (0) for objectives, model lump (14) for brush-entity
+  bounds (func_bomb_target & co. only carry "model" "*N").
+- CS bot nav mesh, versions 1-5, as written by ReGameDLL game_shared/bot/nav_file.cpp.
+  Stock 1.6 maps ship version 5 files without place names.
+
+Build with ACCESS_MAP_STANDALONE to test the parsers outside the engine.
+*/
+
+#include "access_map.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <queue>
+#include <string>
+#include <unordered_map>
+
+#ifndef ACCESS_MAP_STANDALONE
+#include "hud.h"
+#include "cl_util.h"
+#endif
+
+struct NavArea
+{
+	unsigned int id;
+	unsigned char flags;
+	AccessVec lo, hi;		// lo = north-west corner, hi = south-east corner
+	float neZ, swZ;
+	AccessVec center;
+	std::vector<int> neighbors;	// indices into s_Areas
+};
+
+static const unsigned char NAV_JUMP = 0x02;
+
+static char s_szLevel[256];
+static std::vector<AccessObjective> s_Objectives;
+static std::vector<NavArea> s_Areas;
+
+// ---------------------------------------------------------------------------
+// Small helpers
+// ---------------------------------------------------------------------------
+
+static AccessVec MakeVec( float x, float y, float z )
+{
+	AccessVec v = { x, y, z };
+	return v;
+}
+
+static float Dist( const AccessVec &a, const AccessVec &b )
+{
+	const float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
+	return sqrtf( dx * dx + dy * dy + dz * dz );
+}
+
+static float Clampf( float v, float lo, float hi )
+{
+	return v < lo ? lo : ( v > hi ? hi : v );
+}
+
+const char *AccessMap_CompassWord( float yaw )
+{
+	static const char *words[8] = { "est", "nord-est", "nord", "nord-ouest", "ouest", "sud-ouest", "sud", "sud-est" };
+	yaw = fmodf( yaw, 360.0f );
+	if( yaw < 0.0f )
+		yaw += 360.0f;
+	return words[(int)( ( yaw + 22.5f ) / 45.0f ) % 8];
+}
+
+// Bounds-checked little-endian reader.
+struct Reader
+{
+	const unsigned char *data;
+	size_t size;
+	size_t pos;
+	bool ok;
+
+	bool Read( void *dst, size_t n )
+	{
+		if( !ok || pos + n > size )
+		{
+			ok = false;
+			return false;
+		}
+		memcpy( dst, data + pos, n );
+		pos += n;
+		return true;
+	}
+	void Skip( size_t n )
+	{
+		if( !ok || pos + n > size )
+			ok = false;
+		else
+			pos += n;
+	}
+	unsigned int U32( void ) { unsigned int v = 0; Read( &v, 4 ); return v; }
+	unsigned short U16( void ) { unsigned short v = 0; Read( &v, 2 ); return v; }
+	unsigned char U8( void ) { unsigned char v = 0; Read( &v, 1 ); return v; }
+	float F32( void ) { float v = 0; Read( &v, 4 ); return v; }
+};
+
+// ---------------------------------------------------------------------------
+// BSP objectives
+// ---------------------------------------------------------------------------
+
+struct RawObjective
+{
+	AccessObjectiveType type;
+	AccessVec pos;
+};
+
+static bool ClassToType( const char *classname, AccessObjectiveType *type )
+{
+	static const struct { const char *name; AccessObjectiveType type; } map[] =
+	{
+		{ "func_bomb_target", OBJ_BOMBSITE }, { "info_bomb_target", OBJ_BOMBSITE },
+		{ "hostage_entity", OBJ_HOSTAGE },
+		{ "func_hostage_rescue", OBJ_RESCUE_ZONE }, { "info_hostage_rescue", OBJ_RESCUE_ZONE },
+		{ "func_vip_safetyzone", OBJ_VIP_SAFETY },
+		{ "func_escapezone", OBJ_ESCAPE_ZONE },
+		{ "info_player_start", OBJ_SPAWN_CT },
+		{ "info_player_deathmatch", OBJ_SPAWN_T },
+	};
+	for( size_t i = 0; i < sizeof( map ) / sizeof( map[0] ); i++ )
+	{
+		if( !strcmp( classname, map[i].name ) )
+		{
+			*type = map[i].type;
+			return true;
+		}
+	}
+	return false;
+}
+
+static void ParseBspObjectives( const unsigned char *bsp, size_t size, std::vector<RawObjective> &out )
+{
+	if( size < 4 + 15 * 8 )
+		return;
+
+	int version, lumps[15][2];
+	memcpy( &version, bsp, 4 );
+	memcpy( lumps, bsp + 4, sizeof( lumps ) );
+	if( version != 30 )
+		return;
+
+	const int entOfs = lumps[0][0], entLen = lumps[0][1];
+	const int modelOfs = lumps[14][0], modelLen = lumps[14][1];
+	if( entOfs < 0 || entLen <= 0 || (size_t)entOfs + entLen > size )
+		return;
+	const int modelCount = ( modelOfs >= 0 && modelLen > 0 && (size_t)modelOfs + modelLen <= size ) ? modelLen / 64 : 0;
+
+	std::string text( (const char *)bsp + entOfs, entLen );
+	size_t p = 0;
+	while( ( p = text.find( '{', p ) ) != std::string::npos )
+	{
+		const size_t end = text.find( '}', p );
+		if( end == std::string::npos )
+			break;
+
+		char classname[64] = "", model[16] = "", origin[64] = "";
+		size_t q = p + 1;
+		while( q < end )
+		{
+			// "key" "value"
+			const size_t k0 = text.find( '"', q );
+			if( k0 == std::string::npos || k0 >= end ) break;
+			const size_t k1 = text.find( '"', k0 + 1 );
+			if( k1 == std::string::npos || k1 >= end ) break;
+			const size_t v0 = text.find( '"', k1 + 1 );
+			if( v0 == std::string::npos || v0 >= end ) break;
+			const size_t v1 = text.find( '"', v0 + 1 );
+			if( v1 == std::string::npos || v1 >= end ) break;
+
+			const std::string key = text.substr( k0 + 1, k1 - k0 - 1 );
+			const std::string value = text.substr( v0 + 1, v1 - v0 - 1 );
+			if( key == "classname" )
+				snprintf( classname, sizeof( classname ), "%s", value.c_str() );
+			else if( key == "model" )
+				snprintf( model, sizeof( model ), "%s", value.c_str() );
+			else if( key == "origin" )
+				snprintf( origin, sizeof( origin ), "%s", value.c_str() );
+			q = v1 + 1;
+		}
+		p = end + 1;
+
+		RawObjective obj;
+		if( !ClassToType( classname, &obj.type ) )
+			continue;
+
+		obj.pos = MakeVec( 0, 0, 0 );
+		if( model[0] == '*' )
+		{
+			const int m = atoi( model + 1 );
+			if( m <= 0 || m >= modelCount )
+				continue;
+			float bounds[6];
+			memcpy( bounds, bsp + modelOfs + m * 64, sizeof( bounds ) );
+			obj.pos = MakeVec( ( bounds[0] + bounds[3] ) * 0.5f, ( bounds[1] + bounds[4] ) * 0.5f, ( bounds[2] + bounds[5] ) * 0.5f );
+		}
+		else if( sscanf( origin, "%f %f %f", &obj.pos.x, &obj.pos.y, &obj.pos.z ) != 3 )
+		{
+			continue;
+		}
+		out.push_back( obj );
+	}
+}
+
+// Names a group of same-type objectives by direction so they can be told apart:
+// two sites -> split on their widest axis ("est"/"ouest"); more -> 8-way compass.
+static void NameGroup( const std::vector<RawObjective> &raw, AccessObjectiveType type, const char *baseName )
+{
+	std::vector<const RawObjective *> group;
+	for( const RawObjective &r : raw )
+		if( r.type == type )
+			group.push_back( &r );
+	if( group.empty() )
+		return;
+
+	AccessVec c = MakeVec( 0, 0, 0 );
+	for( const RawObjective *r : group )
+	{
+		c.x += r->pos.x / group.size();
+		c.y += r->pos.y / group.size();
+	}
+
+	const bool xAxis = group.size() == 2 && fabsf( group[0]->pos.x - group[1]->pos.x ) >= fabsf( group[0]->pos.y - group[1]->pos.y );
+
+	for( size_t i = 0; i < group.size(); i++ )
+	{
+		AccessObjective o;
+		o.type = type;
+		o.pos = group[i]->pos;
+
+		if( group.size() == 1 )
+			snprintf( o.name, sizeof( o.name ), "%s", baseName );
+		else if( group.size() == 2 )
+		{
+			const char *word = xAxis ? ( group[i]->pos.x > c.x ? "est" : "ouest" ) : ( group[i]->pos.y > c.y ? "nord" : "sud" );
+			snprintf( o.name, sizeof( o.name ), "%s %s", baseName, word );
+		}
+		else
+		{
+			const float yaw = atan2f( group[i]->pos.y - c.y, group[i]->pos.x - c.x ) * 57.29578f;
+			snprintf( o.name, sizeof( o.name ), "%s %s %d", baseName, AccessMap_CompassWord( yaw ), (int)i + 1 );
+		}
+		s_Objectives.push_back( o );
+	}
+}
+
+static void AddCentroid( const std::vector<RawObjective> &raw, AccessObjectiveType type, const char *name )
+{
+	AccessObjective o;
+	o.type = type;
+	o.pos = MakeVec( 0, 0, 0 );
+	int n = 0;
+	for( const RawObjective &r : raw )
+	{
+		if( r.type != type )
+			continue;
+		o.pos.x += r.pos.x; o.pos.y += r.pos.y; o.pos.z += r.pos.z;
+		n++;
+	}
+	if( !n )
+		return;
+	o.pos.x /= n; o.pos.y /= n; o.pos.z /= n;
+
+	// The centroid can fall inside a wall; use the real spawn point closest to it.
+	const RawObjective *closest = NULL;
+	for( const RawObjective &r : raw )
+		if( r.type == type && ( !closest || Dist( r.pos, o.pos ) < Dist( closest->pos, o.pos ) ) )
+			closest = &r;
+	o.pos = closest->pos;
+	snprintf( o.name, sizeof( o.name ), "%s", name );
+	s_Objectives.push_back( o );
+}
+
+static void BuildObjectives( const std::vector<RawObjective> &raw )
+{
+	NameGroup( raw, OBJ_BOMBSITE, "site de bombe" );
+	NameGroup( raw, OBJ_RESCUE_ZONE, "zone de sauvetage" );
+	NameGroup( raw, OBJ_VIP_SAFETY, "zone de sécurité VIP" );
+	NameGroup( raw, OBJ_ESCAPE_ZONE, "zone d'évasion" );
+
+	int hostage = 0;
+	for( const RawObjective &r : raw )
+	{
+		if( r.type != OBJ_HOSTAGE )
+			continue;
+		AccessObjective o;
+		o.type = OBJ_HOSTAGE;
+		o.pos = r.pos;
+		snprintf( o.name, sizeof( o.name ), "otage %d", ++hostage );
+		s_Objectives.push_back( o );
+	}
+
+	AddCentroid( raw, OBJ_SPAWN_CT, "départ antiterroriste" );
+	AddCentroid( raw, OBJ_SPAWN_T, "départ terroriste" );
+}
+
+// ---------------------------------------------------------------------------
+// Nav mesh
+// ---------------------------------------------------------------------------
+
+static bool ParseNav( const unsigned char *data, size_t size )
+{
+	Reader r = { data, size, 0, true };
+	if( r.U32() != 0xFEEDFACE )
+		return false;
+	const unsigned int version = r.U32();
+	if( !r.ok || version == 0 || version > 5 )
+		return false;
+	if( version >= 4 )
+		r.Skip( 4 );	// bsp size
+
+	if( version >= 5 )
+	{
+		const unsigned short placeCount = r.U16();
+		for( int i = 0; i < placeCount && r.ok; i++ )
+			r.Skip( r.U16() );
+	}
+
+	const unsigned int count = r.U32();
+	if( !r.ok || count == 0 || count > 100000 )
+		return false;
+
+	std::vector<NavArea> areas( count );
+	std::vector<std::vector<unsigned int>> connIds( count );
+
+	for( unsigned int a = 0; a < count && r.ok; a++ )
+	{
+		NavArea &area = areas[a];
+		area.id = r.U32();
+		area.flags = r.U8();
+		area.lo.x = r.F32(); area.lo.y = r.F32(); area.lo.z = r.F32();
+		area.hi.x = r.F32(); area.hi.y = r.F32(); area.hi.z = r.F32();
+		area.neZ = r.F32();
+		area.swZ = r.F32();
+		area.center = MakeVec( ( area.lo.x + area.hi.x ) * 0.5f, ( area.lo.y + area.hi.y ) * 0.5f, ( area.lo.z + area.hi.z ) * 0.5f );
+
+		for( int d = 0; d < 4 && r.ok; d++ )
+		{
+			const unsigned int n = r.U32();
+			if( n > 10000 )
+				return false;
+			for( unsigned int i = 0; i < n && r.ok; i++ )
+				connIds[a].push_back( r.U32() );
+		}
+
+		const unsigned char hidingSpots = r.U8();
+		r.Skip( hidingSpots * ( version == 1 ? 12u : 17u ) );
+
+		const unsigned char approaches = r.U8();
+		r.Skip( approaches * 14u );
+
+		const unsigned int encounters = r.U32();
+		if( encounters > 100000 )
+			return false;
+		for( unsigned int e = 0; e < encounters && r.ok; e++ )
+		{
+			if( version < 3 )
+			{
+				r.Skip( 32 );
+				r.Skip( r.U8() * 16u );
+			}
+			else
+			{
+				r.Skip( 10 );
+				r.Skip( r.U8() * 5u );
+			}
+		}
+
+		if( version >= 5 )
+			r.Skip( 2 );	// place entry
+	}
+
+	if( !r.ok )
+		return false;
+
+	std::unordered_map<unsigned int, int> index;
+	for( unsigned int a = 0; a < count; a++ )
+		index[areas[a].id] = (int)a;
+	for( unsigned int a = 0; a < count; a++ )
+	{
+		for( unsigned int id : connIds[a] )
+		{
+			auto it = index.find( id );
+			if( it != index.end() )
+				areas[a].neighbors.push_back( it->second );
+		}
+	}
+
+	s_Areas.swap( areas );
+	return true;
+}
+
+// Bilinear height of an area at (x, y); corners are NW=lo.z, NE=neZ, SW=swZ, SE=hi.z.
+static float AreaZ( const NavArea &a, float x, float y )
+{
+	const float w = a.hi.x - a.lo.x, h = a.hi.y - a.lo.y;
+	const float u = w > 0.0f ? Clampf( ( x - a.lo.x ) / w, 0.0f, 1.0f ) : 0.0f;
+	const float v = h > 0.0f ? Clampf( ( y - a.lo.y ) / h, 0.0f, 1.0f ) : 0.0f;
+	const float northZ = a.lo.z + u * ( a.neZ - a.lo.z );
+	const float southZ = a.swZ + u * ( a.hi.z - a.swZ );
+	return northZ + v * ( southZ - northZ );
+}
+
+int AccessMap_FindArea( const AccessVec &pos )
+{
+	int best = -1;
+	float bestScore = 1e30f;
+
+	for( size_t i = 0; i < s_Areas.size(); i++ )
+	{
+		const NavArea &a = s_Areas[i];
+		const float cx = Clampf( pos.x, a.lo.x, a.hi.x );
+		const float cy = Clampf( pos.y, a.lo.y, a.hi.y );
+		const float horiz = sqrtf( ( cx - pos.x ) * ( cx - pos.x ) + ( cy - pos.y ) * ( cy - pos.y ) );
+		if( horiz > 200.0f )
+			continue;
+
+		const float dz = pos.z - AreaZ( a, cx, cy );
+		if( dz < -40.0f || dz > 120.0f )
+			continue;	// area is well above us, or a floor far below
+
+		// Prefer containing areas, then the floor right below the point.
+		const float score = horiz * 4.0f + fabsf( dz );
+		if( score < bestScore )
+		{
+			bestScore = score;
+			best = (int)i;
+		}
+	}
+	if( best >= 0 )
+		return best;
+
+	// Nothing plausible under the point (brush-zone centers float mid-air):
+	// fall back to the area whose surface is closest in 3D.
+	for( size_t i = 0; i < s_Areas.size(); i++ )
+	{
+		const NavArea &a = s_Areas[i];
+		const float cx = Clampf( pos.x, a.lo.x, a.hi.x );
+		const float cy = Clampf( pos.y, a.lo.y, a.hi.y );
+		const AccessVec surface = MakeVec( cx, cy, AreaZ( a, cx, cy ) );
+		const float d = Dist( surface, pos );
+		if( d < bestScore )
+		{
+			bestScore = d;
+			best = (int)i;
+		}
+	}
+	return best;
+}
+
+// Point on the shared boundary of two adjacent areas (middle of their overlap).
+static AccessVec PortalPoint( const NavArea &a, const NavArea &b )
+{
+	const float x0 = a.lo.x > b.lo.x ? a.lo.x : b.lo.x, x1 = a.hi.x < b.hi.x ? a.hi.x : b.hi.x;
+	const float y0 = a.lo.y > b.lo.y ? a.lo.y : b.lo.y, y1 = a.hi.y < b.hi.y ? a.hi.y : b.hi.y;
+	const float mx = ( a.center.x + b.center.x ) * 0.5f, my = ( a.center.y + b.center.y ) * 0.5f;
+	AccessVec p;
+	p.x = x0 <= x1 ? Clampf( mx, x0, x1 ) : mx;
+	p.y = y0 <= y1 ? Clampf( my, y0, y1 ) : my;
+	p.z = ( AreaZ( a, p.x, p.y ) + AreaZ( b, p.x, p.y ) ) * 0.5f;
+	return p;
+}
+
+float AccessMap_FindPath( const AccessVec &from, const AccessVec &to, std::vector<AccessVec> &waypoints )
+{
+	waypoints.clear();
+	const int start = AccessMap_FindArea( from );
+	int goal = AccessMap_FindArea( to );
+	if( start < 0 || goal < 0 )
+		return -1.0f;
+
+	const size_t n = s_Areas.size();
+	std::vector<float> g( n, 1e30f );
+	std::vector<int> parent( n, -1 );
+	std::vector<bool> closed( n, false );
+	typedef std::pair<float, int> Entry;
+	std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> open;
+
+	g[start] = 0.0f;
+	open.push( Entry( Dist( s_Areas[start].center, s_Areas[goal].center ), start ) );
+
+	while( !open.empty() )
+	{
+		const int cur = open.top().second;
+		open.pop();
+		if( closed[cur] )
+			continue;
+		if( cur == goal )
+			break;
+		closed[cur] = true;
+
+		for( int nb : s_Areas[cur].neighbors )
+		{
+			if( closed[nb] )
+				continue;
+			float cost = Dist( s_Areas[cur].center, s_Areas[nb].center );
+			if( s_Areas[nb].flags & NAV_JUMP )
+				cost *= 1.5f;
+			if( g[cur] + cost < g[nb] )
+			{
+				g[nb] = g[cur] + cost;
+				parent[nb] = cur;
+				open.push( Entry( g[nb] + Dist( s_Areas[nb].center, s_Areas[goal].center ), nb ) );
+			}
+		}
+	}
+
+	if( start != goal && parent[goal] < 0 )
+	{
+		// The goal lies in a part of the mesh we cannot reach (one-way drops,
+		// isolated rooftops). The search has exhausted every reachable area, so
+		// guide to the reachable one closest to the goal instead.
+		int bestArea = -1;
+		float bestDist = 1e30f;
+		for( size_t i = 0; i < n; i++ )
+		{
+			if( g[i] >= 1e30f )
+				continue;
+			const float d = Dist( s_Areas[i].center, to );
+			if( d < bestDist )
+			{
+				bestDist = d;
+				bestArea = (int)i;
+			}
+		}
+		if( bestArea < 0 )
+			return -1.0f;
+		goal = bestArea;
+	}
+
+	std::vector<int> chain;
+	for( int a = goal; a >= 0; a = parent[a] )
+	{
+		chain.push_back( a );
+		if( a == start )
+			break;
+	}
+
+	for( size_t i = chain.size() - 1; i > 0; i-- )
+		waypoints.push_back( PortalPoint( s_Areas[chain[i]], s_Areas[chain[i - 1]] ) );
+	waypoints.push_back( to );
+
+	float length = 0.0f;
+	AccessVec prev = from;
+	for( const AccessVec &w : waypoints )
+	{
+		length += Dist( prev, w );
+		prev = w;
+	}
+	return length;
+}
+
+// ---------------------------------------------------------------------------
+// Loading
+// ---------------------------------------------------------------------------
+
+bool AccessMap_HasNav( void )
+{
+	return !s_Areas.empty();
+}
+
+const std::vector<AccessObjective> &AccessMap_Objectives( void )
+{
+	return s_Objectives;
+}
+
+void AccessMap_LoadFromBuffers( const unsigned char *bsp, size_t bspSize, const unsigned char *nav, size_t navSize )
+{
+	s_Objectives.clear();
+	s_Areas.clear();
+
+	std::vector<RawObjective> raw;
+	if( bsp )
+		ParseBspObjectives( bsp, bspSize, raw );
+	BuildObjectives( raw );
+
+	if( nav && !ParseNav( nav, navSize ) )
+		s_Areas.clear();
+}
+
+#ifndef ACCESS_MAP_STANDALONE
+void AccessMap_Update( const char *levelName )
+{
+	if( !levelName || !levelName[0] )
+		return;
+	if( !strcmp( levelName, s_szLevel ) )
+		return;
+	snprintf( s_szLevel, sizeof( s_szLevel ), "%s", levelName );
+
+	// levelName is "maps/<map>.bsp"
+	char navName[256];
+	snprintf( navName, sizeof( navName ), "%s", levelName );
+	char *ext = strrchr( navName, '.' );
+	if( ext && ( ext - navName ) + 5 < (int)sizeof( navName ) )
+		strcpy( ext, ".nav" );
+
+	int bspLen = 0, navLen = 0;
+	byte *bsp = gEngfuncs.COM_LoadFile( (char *)levelName, 5, &bspLen );
+	byte *nav = gEngfuncs.COM_LoadFile( navName, 5, &navLen );
+
+	AccessMap_LoadFromBuffers( bsp, bsp ? bspLen : 0, nav, nav ? navLen : 0 );
+
+	if( bsp )
+		gEngfuncs.COM_FreeFile( bsp );
+	if( nav )
+		gEngfuncs.COM_FreeFile( nav );
+
+	gEngfuncs.Con_Printf( "[access] %s : %d objectifs, %d zones de navigation\n", levelName,
+		(int)s_Objectives.size(), (int)s_Areas.size() );
+}
+#endif
