+/*
+access_map.cpp - map knowledge for navigation
+
+Formats:
+- BSP v30: entity lump (0) for objectives, model lump (14) for brush-entity
+  bounds (func_bomb_target & co. only carry "model" "*N").
+- CS bot nav mesh, versions 1-5, as written by ReGameDLL game_shared/bot/nav_file.cpp.
+  Stock 1.6 maps ship version 5 files without place names.
+
+Build with ACCESS_MAP_STANDALONE to test the parsers outside the engine.
+*/
+
+#include "access_map.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <queue>
+#include <functional>
+#include <string>
+#include <unordered_map>
+
+#ifndef ACCESS_MAP_STANDALONE
+#include "hud.h"
+#include "cl_util.h"
+#endif
+
+struct NavArea
+{
+	unsigned int id;
+	unsigned char flags;
+	AccessVec lo, hi;		// lo = north-west corner, hi = south-east corner
+	float neZ, swZ;
+	AccessVec center;
+	std::vector<int> neighbors;	// indices into s_Areas
+};
+
+static const unsigned char NAV_JUMP = 0x02;
+
+static char s_szLevel[256];
+static std::vector<AccessObjective> s_Objectives;
+static std::vector<AccessFeature> s_Features;
+static std::vector<NavArea> s_Areas;
+// Walking distance from each objective (index into s_Objectives) to each area,
+// computed once per map for place names; 3e38 when unreachable.
+static std::vector<std::vector<float>> s_ObjectiveDistance;
+
+// ---------------------------------------------------------------------------
+// Small helpers
+// ---------------------------------------------------------------------------
+
+static AccessVec MakeVec( float x, float y, float z )
+{
+	AccessVec v = { x, y, z };
+	return v;
+}
+
+static float Dist( const AccessVec &a, const AccessVec &b )
+{
+	const float dx = a.x - b.x, dy = a.y - b.y, dz = a.z - b.z;
+	return sqrtf( dx * dx + dy * dy + dz * dz );
+}
+
+static float Clampf( float v, float lo, float hi )
+{
+	return v < lo ? lo : ( v > hi ? hi : v );
+}
+
+const char *AccessMap_CompassWord( float yaw )
+{
+	static const char *words[8] = { "est", "nord-est", "nord", "nord-ouest", "ouest", "sud-ouest", "sud", "sud-est" };
+	yaw = fmodf( yaw, 360.0f );
+	if( yaw < 0.0f )
+		yaw += 360.0f;
+	return words[(int)( ( yaw + 22.5f ) / 45.0f ) % 8];
+}
+
+// Bounds-checked little-endian reader.
+struct Reader
+{
+	const unsigned char *data;
+	size_t size;
+	size_t pos;
+	bool ok;
+
+	bool Read( void *dst, size_t n )
+	{
+		if( !ok || pos + n > size )
+		{
+			ok = false;
+			return false;
+		}
+		memcpy( dst, data + pos, n );
+		pos += n;
+		return true;
+	}
+	void Skip( size_t n )
+	{
+		if( !ok || pos + n > size )
+			ok = false;
+		else
+			pos += n;
+	}
+	unsigned int U32( void ) { unsigned int v = 0; Read( &v, 4 ); return v; }
+	unsigned short U16( void ) { unsigned short v = 0; Read( &v, 2 ); return v; }
+	unsigned char U8( void ) { unsigned char v = 0; Read( &v, 1 ); return v; }
+	float F32( void ) { float v = 0; Read( &v, 4 ); return v; }
+};
+
+// ---------------------------------------------------------------------------
+// BSP objectives
+// ---------------------------------------------------------------------------
+
+struct RawObjective
+{
+	AccessObjectiveType type;
+	AccessVec pos;
+	bool hasBounds;
+	AccessVec mins, maxs;
+};
+
+static bool ClassToType( const char *classname, AccessObjectiveType *type )
+{
+	static const struct { const char *name; AccessObjectiveType type; } map[] =
+	{
+		{ "func_bomb_target", OBJ_BOMBSITE }, { "info_bomb_target", OBJ_BOMBSITE },
+		{ "hostage_entity", OBJ_HOSTAGE },
+		{ "func_hostage_rescue", OBJ_RESCUE_ZONE }, { "info_hostage_rescue", OBJ_RESCUE_ZONE },
+		{ "func_vip_safetyzone", OBJ_VIP_SAFETY },
+		{ "func_escapezone", OBJ_ESCAPE_ZONE },
+		{ "info_player_start", OBJ_SPAWN_CT },
+		{ "info_player_deathmatch", OBJ_SPAWN_T },
+	};
+	for( size_t i = 0; i < sizeof( map ) / sizeof( map[0] ); i++ )
+	{
+		if( !strcmp( classname, map[i].name ) )
+		{
+			*type = map[i].type;
+			return true;
+		}
+	}
+	return false;
+}
+
+static bool ClassToFeature( const char *classname, AccessFeatureType *type )
+{
+	if( !strcmp( classname, "func_ladder" ))
+		*type = FEAT_LADDER;
+	else if( !strcmp( classname, "func_door" ) || !strcmp( classname, "func_door_rotating" ) || !strcmp( classname, "momentary_door" ))
+		*type = FEAT_DOOR;
+	else if( !strcmp( classname, "func_breakable" ))
+		*type = FEAT_BREAKABLE;
+	else
+		return false;
+	return true;
+}
+
+// Objectives go to `out`; ladders, doors and breakables straight to s_Features.
+static void ParseBspObjectives( const unsigned char *bsp, size_t size, std::vector<RawObjective> &out )
+{
+	if( size < 4 + 15 * 8 )
+		return;
+
+	int version, lumps[15][2];
+	memcpy( &version, bsp, 4 );
+	memcpy( lumps, bsp + 4, sizeof( lumps ) );
+	if( version != 30 )
+		return;
+
+	const int entOfs = lumps[0][0], entLen = lumps[0][1];
+	const int modelOfs = lumps[14][0], modelLen = lumps[14][1];
+	if( entOfs < 0 || entLen <= 0 || (size_t)entOfs + entLen > size )
+		return;
+	const int modelCount = ( modelOfs >= 0 && modelLen > 0 && (size_t)modelOfs + modelLen <= size ) ? modelLen / 64 : 0;
+
+	std::string text( (const char *)bsp + entOfs, entLen );
+	size_t p = 0;
+	while( ( p = text.find( '{', p ) ) != std::string::npos )
+	{
+		const size_t end = text.find( '}', p );
+		if( end == std::string::npos )
+			break;
+
+		char classname[64] = "", model[16] = "", origin[64] = "";
+		size_t q = p + 1;
+		while( q < end )
+		{
+			// "key" "value"
+			const size_t k0 = text.find( '"', q );
+			if( k0 == std::string::npos || k0 >= end ) break;
+			const size_t k1 = text.find( '"', k0 + 1 );
+			if( k1 == std::string::npos || k1 >= end ) break;
+			const size_t v0 = text.find( '"', k1 + 1 );
+			if( v0 == std::string::npos || v0 >= end ) break;
+			const size_t v1 = text.find( '"', v0 + 1 );
+			if( v1 == std::string::npos || v1 >= end ) break;
+
+			const std::string key = text.substr( k0 + 1, k1 - k0 - 1 );
+			const std::string value = text.substr( v0 + 1, v1 - v0 - 1 );
+			if( key == "classname" )
+				snprintf( classname, sizeof( classname ), "%s", value.c_str() );
+			else if( key == "model" )
+				snprintf( model, sizeof( model ), "%s", value.c_str() );
+			else if( key == "origin" )
+				snprintf( origin, sizeof( origin ), "%s", value.c_str() );
+			q = v1 + 1;
+		}
+		p = end + 1;
+
+		AccessFeatureType feature;
+		if( model[0] == '*' && ClassToFeature( classname, &feature ))
+		{
+			const int m = atoi( model + 1 );
+			if( m > 0 && m < modelCount )
+			{
+				float bounds[6];
+				memcpy( bounds, bsp + modelOfs + m * 64, sizeof( bounds ) );
+				AccessFeature f;
+				f.type = feature;
+				f.mins = MakeVec( bounds[0], bounds[1], bounds[2] );
+				f.maxs = MakeVec( bounds[3], bounds[4], bounds[5] );
+				s_Features.push_back( f );
+			}
+			continue;
+		}
+
+		RawObjective obj;
+		if( !ClassToType( classname, &obj.type ) )
+			continue;
+
+		obj.pos = MakeVec( 0, 0, 0 );
+		obj.hasBounds = false;
+		if( model[0] == '*' )
+		{
+			const int m = atoi( model + 1 );
+			if( m <= 0 || m >= modelCount )
+				continue;
+			float bounds[6];
+			memcpy( bounds, bsp + modelOfs + m * 64, sizeof( bounds ) );
+			obj.pos = MakeVec( ( bounds[0] + bounds[3] ) * 0.5f, ( bounds[1] + bounds[4] ) * 0.5f, ( bounds[2] + bounds[5] ) * 0.5f );
+			obj.hasBounds = true;
+			obj.mins = MakeVec( bounds[0], bounds[1], bounds[2] );
+			obj.maxs = MakeVec( bounds[3], bounds[4], bounds[5] );
+		}
+		else if( sscanf( origin, "%f %f %f", &obj.pos.x, &obj.pos.y, &obj.pos.z ) != 3 )
+		{
+			continue;
+		}
+		out.push_back( obj );
+	}
+}
+
+// Names a group of same-type objectives by direction so they can be told apart:
+// two sites -> split on their widest axis ("est"/"ouest"); more -> 8-way compass.
+static void NameGroup( const std::vector<RawObjective> &raw, AccessObjectiveType type, const char *baseName )
+{
+	std::vector<const RawObjective *> group;
+	for( const RawObjective &r : raw )
+		if( r.type == type )
+			group.push_back( &r );
+	if( group.empty() )
+		return;
+
+	AccessVec c = MakeVec( 0, 0, 0 );
+	for( const RawObjective *r : group )
+	{
+		c.x += r->pos.x / group.size();
+		c.y += r->pos.y / group.size();
+	}
+
+	const bool xAxis = group.size() == 2 && fabsf( group[0]->pos.x - group[1]->pos.x ) >= fabsf( group[0]->pos.y - group[1]->pos.y );
+
+	for( size_t i = 0; i < group.size(); i++ )
+	{
+		AccessObjective o = {};
+		o.type = type;
+		o.pos = group[i]->pos;
+		o.hasBounds = group[i]->hasBounds;
+		o.mins = group[i]->mins;
+		o.maxs = group[i]->maxs;
+
+		if( group.size() == 1 )
+			snprintf( o.name, sizeof( o.name ), "%s", baseName );
+		else if( group.size() == 2 )
+		{
+			const char *word = xAxis ? ( group[i]->pos.x > c.x ? "est" : "ouest" ) : ( group[i]->pos.y > c.y ? "nord" : "sud" );
+			snprintf( o.name, sizeof( o.name ), "%s %s", baseName, word );
+		}
+		else
+		{
+			const float yaw = atan2f( group[i]->pos.y - c.y, group[i]->pos.x - c.x ) * 57.29578f;
+			snprintf( o.name, sizeof( o.name ), "%s %s %d", baseName, AccessMap_CompassWord( yaw ), (int)i + 1 );
+		}
+		s_Objectives.push_back( o );
+	}
+}
+
+static void AddCentroid( const std::vector<RawObjective> &raw, AccessObjectiveType type, const char *name )
+{
+	AccessObjective o = {};
+	o.type = type;
+	o.pos = MakeVec( 0, 0, 0 );
+	int n = 0;
+	for( const RawObjective &r : raw )
+	{
+		if( r.type != type )
+			continue;
+		o.pos.x += r.pos.x; o.pos.y += r.pos.y; o.pos.z += r.pos.z;
+		n++;
+	}
+	if( !n )
+		return;
+	o.pos.x /= n; o.pos.y /= n; o.pos.z /= n;
+
+	// The centroid can fall inside a wall; use the real spawn point closest to it.
+	const RawObjective *closest = NULL;
+	for( const RawObjective &r : raw )
+		if( r.type == type && ( !closest || Dist( r.pos, o.pos ) < Dist( closest->pos, o.pos ) ) )
+			closest = &r;
+	o.pos = closest->pos;
+	snprintf( o.name, sizeof( o.name ), "%s", name );
+	s_Objectives.push_back( o );
+}
+
+static void BuildObjectives( const std::vector<RawObjective> &raw )
+{
+	NameGroup( raw, OBJ_BOMBSITE, "site de bombe" );
+	NameGroup( raw, OBJ_RESCUE_ZONE, "zone de sauvetage" );
+	NameGroup( raw, OBJ_VIP_SAFETY, "zone de sécurité VIP" );
+	NameGroup( raw, OBJ_ESCAPE_ZONE, "zone d'évasion" );
+
+	int hostage = 0;
+	for( const RawObjective &r : raw )
+	{
+		if( r.type != OBJ_HOSTAGE )
+			continue;
+		AccessObjective o = {};
+		o.type = OBJ_HOSTAGE;
+		o.pos = r.pos;
+		snprintf( o.name, sizeof( o.name ), "otage %d", ++hostage );
+		s_Objectives.push_back( o );
+	}
+
+	AddCentroid( raw, OBJ_SPAWN_CT, "départ antiterroriste" );
+	AddCentroid( raw, OBJ_SPAWN_T, "départ terroriste" );
+}
+
+// ---------------------------------------------------------------------------
+// Nav mesh
+// ---------------------------------------------------------------------------
+
+static bool ParseNav( const unsigned char *data, size_t size )
+{
+	Reader r = { data, size, 0, true };
+	if( r.U32() != 0xFEEDFACE )
+		return false;
+	const unsigned int version = r.U32();
+	if( !r.ok || version == 0 || version > 5 )
+		return false;
+	if( version >= 4 )
+		r.Skip( 4 );	// bsp size
+
+	if( version >= 5 )
+	{
+		const unsigned short placeCount = r.U16();
+		for( int i = 0; i < placeCount && r.ok; i++ )
+			r.Skip( r.U16() );
+	}
+
+	const unsigned int count = r.U32();
+	if( !r.ok || count == 0 || count > 100000 )
+		return false;
+
+	std::vector<NavArea> areas( count );
+	std::vector<std::vector<unsigned int>> connIds( count );
+
+	for( unsigned int a = 0; a < count && r.ok; a++ )
+	{
+		NavArea &area = areas[a];
+		area.id = r.U32();
+		area.flags = r.U8();
+		area.lo.x = r.F32(); area.lo.y = r.F32(); area.lo.z = r.F32();
+		area.hi.x = r.F32(); area.hi.y = r.F32(); area.hi.z = r.F32();
+		area.neZ = r.F32();
+		area.swZ = r.F32();
+		area.center = MakeVec( ( area.lo.x + area.hi.x ) * 0.5f, ( area.lo.y + area.hi.y ) * 0.5f, ( area.lo.z + area.hi.z ) * 0.5f );
+
+		for( int d = 0; d < 4 && r.ok; d++ )
+		{
+			const unsigned int n = r.U32();
+			if( n > 10000 )
+				return false;
+			for( unsigned int i = 0; i < n && r.ok; i++ )
+				connIds[a].push_back( r.U32() );
+		}
+
+		const unsigned char hidingSpots = r.U8();
+		r.Skip( hidingSpots * ( version == 1 ? 12u : 17u ) );
+
+		const unsigned char approaches = r.U8();
+		r.Skip( approaches * 14u );
+
+		const unsigned int encounters = r.U32();
+		if( encounters > 100000 )
+			return false;
+		for( unsigned int e = 0; e < encounters && r.ok; e++ )
+		{
+			if( version < 3 )
+			{
+				r.Skip( 32 );
+				r.Skip( r.U8() * 16u );
+			}
+			else
+			{
+				r.Skip( 10 );
+				r.Skip( r.U8() * 5u );
+			}
+		}
+
+		if( version >= 5 )
+			r.Skip( 2 );	// place entry
+	}
+
+	if( !r.ok )
+		return false;
+
+	std::unordered_map<unsigned int, int> index;
+	for( unsigned int a = 0; a < count; a++ )
+		index[areas[a].id] = (int)a;
+	for( unsigned int a = 0; a < count; a++ )
+	{
+		for( unsigned int id : connIds[a] )
+		{
+			auto it = index.find( id );
+			if( it != index.end() )
+				areas[a].neighbors.push_back( it->second );
+		}
+	}
+
+	s_Areas.swap( areas );
+	return true;
+}
+
+// Bilinear height of an area at (x, y); corners are NW=lo.z, NE=neZ, SW=swZ, SE=hi.z.
+static float AreaZ( const NavArea &a, float x, float y )
+{
+	const float w = a.hi.x - a.lo.x, h = a.hi.y - a.lo.y;
+	const float u = w > 0.0f ? Clampf( ( x - a.lo.x ) / w, 0.0f, 1.0f ) : 0.0f;
+	const float v = h > 0.0f ? Clampf( ( y - a.lo.y ) / h, 0.0f, 1.0f ) : 0.0f;
+	const float northZ = a.lo.z + u * ( a.neZ - a.lo.z );
+	const float southZ = a.swZ + u * ( a.hi.z - a.swZ );
+	return northZ + v * ( southZ - northZ );
+}
+
+int AccessMap_FindArea( const AccessVec &pos )
+{
+	int best = -1;
+	float bestScore = 1e30f;
+
+	for( size_t i = 0; i < s_Areas.size(); i++ )
+	{
+		const NavArea &a = s_Areas[i];
+		const float cx = Clampf( pos.x, a.lo.x, a.hi.x );
+		const float cy = Clampf( pos.y, a.lo.y, a.hi.y );
+		const float horiz = sqrtf( ( cx - pos.x ) * ( cx - pos.x ) + ( cy - pos.y ) * ( cy - pos.y ) );
+		if( horiz > 200.0f )
+			continue;
+
+		const float dz = pos.z - AreaZ( a, cx, cy );
+		if( dz < -40.0f || dz > 120.0f )
+			continue;	// area is well above us, or a floor far below
+
+		// Prefer containing areas, then the floor right below the point.
+		const float score = horiz * 4.0f + fabsf( dz );
+		if( score < bestScore )
+		{
+			bestScore = score;
+			best = (int)i;
+		}
+	}
+	if( best >= 0 )
+		return best;
+
+	// Nothing plausible under the point (brush-zone centers float mid-air):
+	// fall back to the area whose surface is closest in 3D.
+	for( size_t i = 0; i < s_Areas.size(); i++ )
+	{
+		const NavArea &a = s_Areas[i];
+		const float cx = Clampf( pos.x, a.lo.x, a.hi.x );
+		const float cy = Clampf( pos.y, a.lo.y, a.hi.y );
+		const AccessVec surface = MakeVec( cx, cy, AreaZ( a, cx, cy ) );
+		const float d = Dist( surface, pos );
+		if( d < bestScore )
+		{
+			bestScore = d;
+			best = (int)i;
+		}
+	}
+	return best;
+}
+
+// Point on the shared boundary of two adjacent areas (middle of their overlap).
+static AccessVec PortalPoint( const NavArea &a, const NavArea &b )
+{
+	const float x0 = a.lo.x > b.lo.x ? a.lo.x : b.lo.x, x1 = a.hi.x < b.hi.x ? a.hi.x : b.hi.x;
+	const float y0 = a.lo.y > b.lo.y ? a.lo.y : b.lo.y, y1 = a.hi.y < b.hi.y ? a.hi.y : b.hi.y;
+	const float mx = ( a.center.x + b.center.x ) * 0.5f, my = ( a.center.y + b.center.y ) * 0.5f;
+	AccessVec p;
+	p.x = x0 <= x1 ? Clampf( mx, x0, x1 ) : mx;
+	p.y = y0 <= y1 ? Clampf( my, y0, y1 ) : my;
+	p.z = ( AreaZ( a, p.x, p.y ) + AreaZ( b, p.x, p.y ) ) * 0.5f;
+	return p;
+}
+
+float AccessMap_FindPath( const AccessVec &from, const AccessVec &to, std::vector<AccessVec> &waypoints )
+{
+	waypoints.clear();
+	const int start = AccessMap_FindArea( from );
+	int goal = AccessMap_FindArea( to );
+	if( start < 0 || goal < 0 )
+		return -1.0f;
+
+	const size_t n = s_Areas.size();
+	std::vector<float> g( n, 1e30f );
+	std::vector<int> parent( n, -1 );
+	std::vector<bool> closed( n, false );
+	typedef std::pair<float, int> Entry;
+	std::priority_queue<Entry, std::vector<Entry>, std::greater<Entry>> open;
+
+	g[start] = 0.0f;
+	open.push( Entry( Dist( s_Areas[start].center, s_Areas[goal].center ), start ) );
+
+	while( !open.empty() )
+	{
+		const int cur = open.top().second;
+		open.pop();
+		if( closed[cur] )
+			continue;
+		if( cur == goal )
+			break;
+		closed[cur] = true;
+
+		for( int nb : s_Areas[cur].neighbors )
+		{
+			if( closed[nb] )
+				continue;
+			float cost = Dist( s_Areas[cur].center, s_Areas[nb].center );
+			if( s_Areas[nb].flags & NAV_JUMP )
+				cost *= 1.5f;
+			if( g[cur] + cost < g[nb] )
+			{
+				g[nb] = g[cur] + cost;
+				parent[nb] = cur;
+				open.push( Entry( g[nb] + Dist( s_Areas[nb].center, s_Areas[goal].center ), nb ) );
+			}
+		}
+	}
+
+	if( start != goal && parent[goal] < 0 )
+	{
+		// The goal lies in a part of the mesh we cannot reach (one-way drops,
+		// isolated rooftops). The search has exhausted every reachable area, so
+		// guide to the reachable one closest to the goal instead.
+		int bestArea = -1;
+		float bestDist = 1e30f;
+		for( size_t i = 0; i < n; i++ )
+		{
+			if( g[i] >= 1e30f )
+				continue;
+			const float d = Dist( s_Areas[i].center, to );
+			if( d < bestDist )
+			{
+				bestDist = d;
+				bestArea = (int)i;
+			}
+		}
+		if( bestArea < 0 )
+			return -1.0f;
+		goal = bestArea;
+	}
+
+	std::vector<int> chain;
+	for( int a = goal; a >= 0; a = parent[a] )
+	{
+		chain.push_back( a );
+		if( a == start )
+			break;
+	}
+
+	for( size_t i = chain.size() - 1; i > 0; i-- )
+		waypoints.push_back( PortalPoint( s_Areas[chain[i]], s_Areas[chain[i - 1]] ) );
+	waypoints.push_back( to );
+
+	float length = 0.0f;
+	AccessVec prev = from;
+	for( const AccessVec &w : waypoints )
+	{
+		length += Dist( prev, w );
+		prev = w;
+	}
+	return length;
+}
+
+// ---------------------------------------------------------------------------
+// Loading
+// ---------------------------------------------------------------------------
+
+bool AccessMap_HasNav( void )
+{
+	return !s_Areas.empty();
+}
+
+const std::vector<AccessObjective> &AccessMap_Objectives( void )
+{
+	return s_Objectives;
+}
+
+// Double doors and ladders built from several brushes are one thing to a
+// player: merge same-type boxes that touch (within 32 units).
+static void MergeFeatures( void )
+{
+	const float gap = 32.0f;
+	bool merged = true;
+	while( merged )
+	{
+		merged = false;
+		for( size_t i = 0; i < s_Features.size() && !merged; i++ )
+		{
+			for( size_t j = i + 1; j < s_Features.size() && !merged; j++ )
+			{
+				AccessFeature &a = s_Features[i];
+				const AccessFeature &b = s_Features[j];
+				if( a.type != b.type ||
+					a.mins.x > b.maxs.x + gap || b.mins.x > a.maxs.x + gap ||
+					a.mins.y > b.maxs.y + gap || b.mins.y > a.maxs.y + gap ||
+					a.mins.z > b.maxs.z + gap || b.mins.z > a.maxs.z + gap )
+					continue;
+				a.mins = MakeVec( fminf( a.mins.x, b.mins.x ), fminf( a.mins.y, b.mins.y ), fminf( a.mins.z, b.mins.z ));
+				a.maxs = MakeVec( fmaxf( a.maxs.x, b.maxs.x ), fmaxf( a.maxs.y, b.maxs.y ), fmaxf( a.maxs.z, b.maxs.z ));
+				s_Features.erase( s_Features.begin() + j );
+				merged = true;
+			}
+		}
+	}
+}
+
+const std::vector<AccessFeature> &AccessMap_Features( void )
+{
+	return s_Features;
+}
+
+// ---------------------------------------------------------------------------
+// Places: walking distances from every objective (Dijkstra on the nav graph)
+// ---------------------------------------------------------------------------
+
+static bool IsPlaceLandmark( const AccessObjective &o )
+{
+	return o.type != OBJ_HOSTAGE;	// hostages move: not a landmark
+}
+
+static void BuildPlaceDistances( void )
+{
+	s_ObjectiveDistance.clear();
+	const size_t n = s_Areas.size();
+	if( !n )
+		return;
+
+	// Links are one-way in the file (drops); walking back is what matters for
+	// "how far is this from there", so use them both ways.
+	std::vector<std::vector<int>> links( n );
+	for( size_t i = 0; i < n; i++ )
+		for( int nb : s_Areas[i].neighbors )
+		{
+			links[i].push_back( nb );
+			links[nb].push_back( (int)i );
+		}
+
+	s_ObjectiveDistance.resize( s_Objectives.size() );
+	for( size_t o = 0; o < s_Objectives.size(); o++ )
+	{
+		std::vector<float> &dist = s_ObjectiveDistance[o];
+		dist.assign( n, 3.0e38f );
+		const int start = IsPlaceLandmark( s_Objectives[o] ) ? AccessMap_FindArea( s_Objectives[o].pos ) : -1;
+		if( start < 0 )
+			continue;
+		typedef std::pair<float, int> Item;
+		std::priority_queue<Item, std::vector<Item>, std::greater<Item>> open;
+		dist[start] = 0.0f;
+		open.push( Item( 0.0f, start ));
+		while( !open.empty() )
+		{
+			const Item top = open.top();
+			open.pop();
+			if( top.first > dist[top.second] )
+				continue;
+			for( int nb : links[top.second] )
+			{
+				const float d = top.first + Dist( s_Areas[top.second].center, s_Areas[nb].center );
+				if( d < dist[nb] )
+				{
+					dist[nb] = d;
+					open.push( Item( d, nb ));
+				}
+			}
+		}
+	}
+}
+
+// "du site..." / "de la zone...", "le site..." / "la zone..."
+static const char *Article( const char *name, bool of )
+{
+	const bool feminine = !strncmp( name, "zone", 4 );
+	if( of )
+		return feminine ? "de la " : "du ";
+	return feminine ? "la " : "le ";
+}
+
+bool AccessMap_PlaceName( const AccessVec &pos, char *out, size_t size, int *key )
+{
+	out[0] = 0;
+	const int area = AccessMap_FindArea( pos );
+	if( area < 0 || s_ObjectiveDistance.size() != s_Objectives.size() )
+		return false;
+
+	int first = -1, second = -1;
+	float d1 = 3.0e38f, d2 = 3.0e38f;
+	for( size_t o = 0; o < s_Objectives.size(); o++ )
+	{
+		if( !IsPlaceLandmark( s_Objectives[o] ) || s_ObjectiveDistance[o].size() <= (size_t)area )
+			continue;
+		const float d = s_ObjectiveDistance[o][area];
+		if( d >= 3.0e38f )
+			continue;
+		if( d < d1 ) { second = first; d2 = d1; first = (int)o; d1 = d; }
+		else if( d < d2 ) { second = (int)o; d2 = d; }
+	}
+	if( first < 0 )
+		return false;
+
+	const char *a = s_Objectives[first].name;
+	if( d1 < 600.0f || second < 0 )	// 15 m walk
+	{
+		snprintf( out, size, "près %s%s", Article( a, true ), a );
+		*key = first * 1000 + 999;
+	}
+	else if( ( s_Objectives[first].type == OBJ_SPAWN_T && s_Objectives[second].type == OBJ_SPAWN_CT ) ||
+		( s_Objectives[first].type == OBJ_SPAWN_CT && s_Objectives[second].type == OBJ_SPAWN_T ))
+	{
+		// Between the two starts, away from every goal: the middle of the map.
+		snprintf( out, size, "au milieu de la carte, côté %s", a );
+		*key = 998;
+	}
+	else
+	{
+		const char *b = s_Objectives[second].name;
+		snprintf( out, size, "entre %s%s et %s%s", Article( a, false ), a, Article( b, false ), b );
+		// Same place whichever of the two is nearer.
+		*key = ( first < second ? first : second ) * 1000 + ( first < second ? second : first );
+	}
+	return true;
+}
+
+void AccessMap_LoadFromBuffers( const unsigned char *bsp, size_t bspSize, const unsigned char *nav, size_t navSize )
+{
+	s_Objectives.clear();
+	s_Features.clear();
+	s_Areas.clear();
+
+	std::vector<RawObjective> raw;
+	if( bsp )
+		ParseBspObjectives( bsp, bspSize, raw );
+	MergeFeatures();
+	BuildObjectives( raw );
+
+	if( nav && !ParseNav( nav, navSize ) )
+		s_Areas.clear();
+	BuildPlaceDistances();
+}
+
+#ifndef ACCESS_MAP_STANDALONE
+void AccessMap_Update( const char *levelName )
+{
+	if( !levelName || !levelName[0] )
+		return;
+	if( !strcmp( levelName, s_szLevel ) )
+		return;
+	snprintf( s_szLevel, sizeof( s_szLevel ), "%s", levelName );
+
+	// levelName is "maps/<map>.bsp"
+	char navName[256];
+	snprintf( navName, sizeof( navName ), "%s", levelName );
+	char *ext = strrchr( navName, '.' );
+	if( ext && ( ext - navName ) + 5 < (int)sizeof( navName ) )
+		strcpy( ext, ".nav" );
+
+	int bspLen = 0, navLen = 0;
+	byte *bsp = gEngfuncs.COM_LoadFile( (char *)levelName, 5, &bspLen );
+	byte *nav = gEngfuncs.COM_LoadFile( navName, 5, &navLen );
+
+	AccessMap_LoadFromBuffers( bsp, bsp ? bspLen : 0, nav, nav ? navLen : 0 );
+
+	if( bsp )
+		gEngfuncs.COM_FreeFile( bsp );
+	if( nav )
+		gEngfuncs.COM_FreeFile( nav );
+
+	gEngfuncs.Con_Printf( "[access] %s : %d objectifs, %d zones de navigation\n", levelName,
+		(int)s_Objectives.size(), (int)s_Areas.size() );
+}
+#endif
diff --git a/cl_dll/accessibility/access_map.h b/cl_dll/accessibility/access_map.h
