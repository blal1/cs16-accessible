diff --git a/cl_dll/accessibility/access_platform.cpp b/cl_dll/accessibility/access_platform.cpp
new file mode 100644
index 0000000..39dccde
--- /dev/null
+++ b/cl_dll/accessibility/access_platform.cpp
@@ -0,0 +1,51 @@
+/*
+access_platform.cpp - small operating system services for the accessibility layer
+
+Kept apart from the HUD code: windows.h does not mix with the game headers.
+*/
+
+#include "accessibility/access_platform.h"
+
+#include <string.h>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <shellapi.h>
+#endif
+
+bool Access_IsWebAddress( const char *text )
+{
+	if( !text )
+		return false;
+	while( *text == ' ' || *text == '\t' || *text == '\r' || *text == '\n' )
+		text++;
+	return !_strnicmp( text, "http://", 7 ) || !_strnicmp( text, "https://", 8 );
+}
+
+bool Access_OpenWebAddress( const char *url )
+{
+	if( !Access_IsWebAddress( url ))
+		return false;
+	while( *url == ' ' || *url == '\t' || *url == '\r' || *url == '\n' )
+		url++;
+
+	// The address comes from the server: keep only one printable token, so it
+	// can never be read by the shell as a program with arguments.
+	char clean[1024];
+	size_t n = 0;
+	for( ; url[n] && n + 1 < sizeof( clean ); n++ )
+	{
+		const unsigned char c = (unsigned char)url[n];
+		if( c <= ' ' || c == '"' || c >= 0x7F )
+			break;
+		clean[n] = (char)c;
+	}
+	clean[n] = 0;
+
+#ifdef _WIN32
+	return (INT_PTR)ShellExecuteA( NULL, "open", clean, NULL, NULL, SW_SHOWNORMAL ) > 32;
+#else
+	return false;
+#endif
+}
diff --git a/cl_dll/accessibility/access_platform.h b/cl_dll/accessibility/access_platform.h
new file mode 100644
index 0000000..a306469
--- /dev/null
+++ b/cl_dll/accessibility/access_platform.h
@@ -0,0 +1,10 @@
+/*
+access_platform.h - small operating system services for the accessibility layer
+*/
+#pragma once
+
+// True for an http:// or https:// address (leading spaces allowed).
+bool Access_IsWebAddress( const char *text );
+// Opens a web address in the default browser (screen-reader friendly), only
+// when the user asked for it. Refuses anything that is not a plain web address.
+bool Access_OpenWebAddress( const char *url );
diff --git a/cl_dll/accessibility/access_screens.cpp b/cl_dll/accessibility/access_screens.cpp
new file mode 100644
index 0000000..19cb435
--- /dev/null
+++ b/cl_dll/accessibility/access_screens.cpp
@@ -0,0 +1,348 @@
+/*
+access_screens.cpp - spoken versions of visual-only HUD screens
+*/
+
+#include "hud.h"
+#include "cl_util.h"
+
+#include "accessibility/access_screens.h"
+#include "accessibility/access_speech.h"
+#include "accessibility/access_platform.h"
+#include "accessibility/access_nav.h"
+
+#include <stdio.h>
+#include <string.h>
+
+extern int g_iUser1;
+extern int g_iUser2;
+
+static cvar_t *access_speech_hints;
+static cvar_t *access_speech_aimtarget;
+static cvar_t *access_speech_timer;
+
+static char s_szMotd[2048];
+static char s_szLastStatus[256];
+static char s_szLastHint[512];
+static float s_flLastHintTime;
+static int s_iLastSpecMode = -1;
+static int s_iLastSpecTarget = -1;
+static int s_iLastIntermission;
+static int s_iLastTimerAnnounce = -1;
+
+// Removes HTML tags/entities so HTML MOTDs (not drawn by the text HUD) can still be read.
+static void StripHtml( const char *in, char *out, size_t outSize )
+{
+	size_t o = 0;
+	bool inTag = false, inScript = false;
+	for( const char *p = in; *p && o + 2 < outSize; p++ )
+	{
+		if( *p == '<' )
+		{
+			inTag = true;
+			if( !strnicmp( p, "<script", 7 ) || !strnicmp( p, "<style", 6 ) )
+				inScript = true;
+			else if( !strnicmp( p, "</script", 8 ) || !strnicmp( p, "</style", 7 ) )
+				inScript = false;
+			// Block-level tags become line breaks.
+			if( !strnicmp( p, "<br", 3 ) || !strnicmp( p, "<p", 2 ) || !strnicmp( p, "</p", 3 ) ||
+				!strnicmp( p, "<li", 3 ) || !strnicmp( p, "<h", 2 ) || !strnicmp( p, "<div", 4 ) )
+				out[o++] = '\n';
+			continue;
+		}
+		if( *p == '>' && inTag )
+		{
+			inTag = false;
+			continue;
+		}
+		if( inTag || inScript )
+			continue;
+		if( *p == '&' )
+		{
+			static const struct { const char *ent; char ch; } ents[] =
+				{ { "&nbsp;", ' ' }, { "&amp;", '&' }, { "&lt;", '<' }, { "&gt;", '>' }, { "&quot;", '"' }, { "&#39;", '\'' } };
+			bool matched = false;
+			for( size_t e = 0; e < sizeof( ents ) / sizeof( ents[0] ); e++ )
+			{
+				const size_t len = strlen( ents[e].ent );
+				if( !strnicmp( p, ents[e].ent, len ) )
+				{
+					out[o++] = ents[e].ch;
+					p += len - 1;
+					matched = true;
+					break;
+				}
+			}
+			if( matched )
+				continue;
+		}
+		out[o++] = *p;
+	}
+	out[o] = 0;
+}
+
+void AccessScreens_OnMotd( const char *text )
+{
+	StripHtml( text, s_szMotd, sizeof( s_szMotd ) );
+	char buf[sizeof( s_szMotd ) + 96];
+	// Many servers send a web address, shown as a page by a sighted player's
+	// client: offer to open it in the browser (read by the screen reader).
+	if( Access_IsWebAddress( s_szMotd ))
+		snprintf( buf, sizeof( buf ), "Message du serveur : page web. Touche O pour l'ouvrir dans le navigateur." );
+	else
+		snprintf( buf, sizeof( buf ), "Message du serveur : %s", s_szMotd );
+	Access_Speak( buf );
+}
+
+// Text without its digits: "Fireworks In: 33" and "Fireworks In: 32" match.
+static void WithoutDigits( const char *in, char *out, size_t size )
+{
+	size_t o = 0;
+	for( ; *in && o + 1 < size; in++ )
+		if( *in < '0' || *in > '9' )
+			out[o++] = *in;
+	out[o] = 0;
+}
+
+void AccessScreens_OnHudText( const char *text )
+{
+	if( !access_speech_hints || !access_speech_hints->value || !text || !text[0] )
+		return;
+	// Servers often resend the same hint every frame or so.
+	if( !strcmp( text, s_szLastHint ) && gHUD.m_flTime - s_flLastHintTime < 5.0f )
+		return;
+	// Plugin countdowns and live counters redraw the message every second with
+	// a new number: read them every 10 seconds, and the last 5 seconds.
+	char shape[512], lastShape[512];
+	WithoutDigits( text, shape, sizeof( shape ));
+	WithoutDigits( s_szLastHint, lastShape, sizeof( lastShape ));
+	if( strcmp( text, s_szLastHint ) && !strcmp( shape, lastShape ) && gHUD.m_flTime - s_flLastHintTime < 10.0f )
+	{
+		const char *digit = strpbrk( text, "0123456789" );
+		const int number = digit ? atoi( digit ) : 0;
+		if( number > 5 || number < 1 )
+			return;
+	}
+	snprintf( s_szLastHint, sizeof( s_szLastHint ), "%s", text );
+	s_flLastHintTime = gHUD.m_flTime;
+	Access_Speak( text );
+}
+
+// Who the status line is about: the text before its health field.
+static void StatusSubject( const char *text, char *out, size_t size )
+{
+	snprintf( out, size, "%s", text );
+	static const char *const fields[] = { "Santé", "Health", "%" };
+	for( const char *field : fields )
+		if( char *at = strstr( out, field ))
+			*at = 0;
+}
+
+// "Enemy: Name  Health: 100%" etc. Spoken only when it changes.
+void AccessScreens_OnStatusBar( const char *text )
+{
+	if( !access_speech_aimtarget || !access_speech_aimtarget->value )
+		return;
+	// Spectators hear who they watch from the spectator announcement.
+	if( Access_IsSpectating() )
+		return;
+	if( !strcmp( text, s_szLastStatus ) )
+		return;
+
+	// The line flickers off and on as the crosshair jitters over a player, and
+	// health ticks down: the same player is spoken again only after a pause.
+	static char s_szLastSubject[256];
+	static float s_flLastSpoken;
+	char subject[256];
+	StatusSubject( text, subject, sizeof( subject ));
+	snprintf( s_szLastStatus, sizeof( s_szLastStatus ), "%s", text );
+	if( !text[0] )
+		return;
+	if( !strcmp( subject, s_szLastSubject ) && gHUD.m_flTime - s_flLastSpoken < 4.0f )
+		return;
+	snprintf( s_szLastSubject, sizeof( s_szLastSubject ), "%s", subject );
+	s_flLastSpoken = gHUD.m_flTime;
+	Access_Speak( text );
+}
+
+static const char *TeamName( int team )
+{
+	return team == 1 ? "terroristes" : ( team == 2 ? "antiterroristes" : "spectateurs" );
+}
+
+static void Cmd_Scores( void )
+{
+	char buf[2048];
+	int o = 0;
+
+	// Ourselves first: frags, deaths and rank among all players (by frags,
+	// then fewer deaths), which a sighted player finds by scanning the board.
+	const cl_entity_t *local = gEngfuncs.GetLocalPlayer();
+	const int me = local ? local->index : 0;
+	if( me > 0 && me <= MAX_PLAYERS )
+	{
+		int rank = 1, players = 0;
+		const extra_player_info_t &mine = g_PlayerExtraInfo[me];
+		for( int i = 1; i <= MAX_PLAYERS && i <= gEngfuncs.GetMaxClients(); i++ )
+		{
+			GetPlayerInfo( i, &g_PlayerInfoList[i] );
+			if( !g_PlayerInfoList[i].name || !g_PlayerInfoList[i].name[0] )
+				continue;
+			players++;
+			const extra_player_info_t &other = g_PlayerExtraInfo[i];
+			if( i != me && ( other.frags > mine.frags || ( other.frags == mine.frags && other.deaths < mine.deaths )))
+				rank++;
+		}
+		o += snprintf( buf + o, sizeof( buf ) - o, "Vous : %d frags, %d morts, %de sur %d. ", mine.frags, mine.deaths, rank, players );
+	}
+
+	// Team scores (rounds won).
+	for( int t = 1; t <= 2; t++ )
+	{
+		for( int j = 0; j <= MAX_TEAMS; j++ )
+		{
+			if( g_TeamInfo[j].teamnumber != t || !g_TeamInfo[j].name[0] )
+				continue;
+			o += snprintf( buf + o, sizeof( buf ) - o, "%s %d. ", t == 1 ? "Terroristes" : "Antiterroristes", g_TeamInfo[j].frags );
+			break;
+		}
+	}
+
+	for( int team = 1; team <= 3 && o < (int)sizeof( buf ); team++ )
+	{
+		bool header = false;
+		for( int i = 1; i <= MAX_PLAYERS && i <= gEngfuncs.GetMaxClients() && o < (int)sizeof( buf ); i++ )
+		{
+			GetPlayerInfo( i, &g_PlayerInfoList[i] );
+			if( !g_PlayerInfoList[i].name || !g_PlayerInfoList[i].name[0] )
+				continue;
+			const int t = g_PlayerExtraInfo[i].teamnumber;
+			if( ( team == 3 ) ? ( t == 1 || t == 2 ) : t != team )
+				continue;
+			if( !header )
+			{
+				o += snprintf( buf + o, sizeof( buf ) - o, "Équipe %s : ", TeamName( team ) );
+				header = true;
+			}
+			o += snprintf( buf + o, sizeof( buf ) - o, "%s, %d frags %d morts%s%s. ",
+				g_PlayerInfoList[i].name, g_PlayerExtraInfo[i].frags, g_PlayerExtraInfo[i].deaths,
+				g_PlayerExtraInfo[i].dead ? ", mort" : "", g_PlayerExtraInfo[i].has_c4 ? ", porte la bombe" : "" );
+		}
+	}
+	Access_Speak( o ? buf : "Tableau des scores vide", true );
+}
+
+static void Cmd_Time( void )
+{
+	char buf[96];
+	const int planted = AccessNav_BombPlantedSeconds();
+	if( !( gHUD.m_Timer.m_iFlags & HUD_DRAW ) && planted >= 0 )
+		snprintf( buf, sizeof( buf ), "Bombe posée depuis %d seconde%s", planted, planted > 1 ? "s" : "" );
+	else if( !( gHUD.m_Timer.m_iFlags & HUD_DRAW ) )
+		snprintf( buf, sizeof( buf ), "Pas de minuterie" );
+	else
+	{
+		const int t = gHUD.m_Timer.GetRemainingTime( gHUD.m_flTime );
+		snprintf( buf, sizeof( buf ), "%d minute%s %d secondes", t / 60, t / 60 > 1 ? "s" : "", t % 60 );
+	}
+	Access_Speak( buf, true );
+}
+
+static void Cmd_Motd( void )
+{
+	if( Access_IsWebAddress( s_szMotd ))
+	{
+		const bool opened = Access_OpenWebAddress( s_szMotd );
+		Access_Speak( opened ? "Ouverture du message du serveur dans le navigateur" : "Impossible d'ouvrir la page du serveur", true );
+		return;
+	}
+	Access_Speak( s_szMotd[0] ? s_szMotd : "Pas de message du serveur", true );
+}
+
+static const char *SpectatorModeName( int mode )
+{
+	switch( mode )
+	{
+	case 1: return "caméra verrouillée";
+	case 2: return "caméra libre derrière le joueur";
+	case 3: return "vol libre";
+	case 4: return "à la première personne";
+	case 5: return "carte libre";
+	case 6: return "carte, suivi du joueur";
+	default: return "";
+	}
+}
+
+void AccessScreens_Frame( void )
+{
+	// Spectator: announce mode and the player being watched.
+	if( g_iUser1 != s_iLastSpecMode || ( g_iUser1 && g_iUser2 != s_iLastSpecTarget ) )
+	{
+		char buf[320] = "";
+		static bool s_bToldKeys;
+		if( g_iUser1 && g_iUser1 != s_iLastSpecMode )
+		{
+			snprintf( buf, sizeof( buf ), "Spectateur, %s. ", SpectatorModeName( g_iUser1 ) );
+			if( !s_bToldKeys )
+			{
+				// Keyboard equivalents of the mouse buttons (access.cfg binds them).
+				strncat( buf, "Entrée : joueur suivant, Retour arrière : joueur précédent, Espace : changer de vue. ",
+					sizeof( buf ) - strlen( buf ) - 1 );
+				s_bToldKeys = true;
+			}
+		}
+		if( g_iUser1 && g_iUser2 > 0 && g_iUser2 <= MAX_PLAYERS && g_iUser2 != s_iLastSpecTarget )
+		{
+			GetPlayerInfo( g_iUser2, &g_PlayerInfoList[g_iUser2] );
+			if( g_PlayerInfoList[g_iUser2].name )
+			{
+				const int team = g_PlayerExtraInfo[g_iUser2].teamnumber;
+				const size_t len = strlen( buf );
+				snprintf( buf + len, sizeof( buf ) - len, "Vous regardez %s%s%s", g_PlayerInfoList[g_iUser2].name,
+					team == 1 ? ", terroriste" : ( team == 2 ? ", antiterroriste" : "" ),
+					g_PlayerExtraInfo[g_iUser2].has_c4 ? ", porte la bombe" : "" );
+			}
+		}
+		if( buf[0] )
+			Access_Speak( buf, true );
+		s_iLastSpecMode = g_iUser1;
+		s_iLastSpecTarget = g_iUser2;
+	}
+
+	// End of map: read the final scoreboard.
+	if( gHUD.m_iIntermission && !s_iLastIntermission )
+	{
+		Access_Speak( "Fin de la partie.", true );
+		Cmd_Scores();
+	}
+	s_iLastIntermission = gHUD.m_iIntermission;
+
+	// Round time warnings.
+	if( access_speech_timer && access_speech_timer->value && ( gHUD.m_Timer.m_iFlags & HUD_DRAW ) )
+	{
+		const int t = gHUD.m_Timer.GetRemainingTime( gHUD.m_flTime );
+		static const int marks[] = { 60, 30, 10 };
+		for( int m : marks )
+		{
+			if( t == m && s_iLastTimerAnnounce != m )
+			{
+				char buf[48];
+				snprintf( buf, sizeof( buf ), m == 60 ? "1 minute" : "%d secondes", m );
+				Access_Speak( buf );
+				s_iLastTimerAnnounce = m;
+			}
+		}
+		if( t > 60 )
+			s_iLastTimerAnnounce = -1;
+	}
+}
+
+void AccessScreens_Init( void )
+{
+	access_speech_hints     = CVAR_CREATE( "access_speech_hints", "1", FCVAR_ARCHIVE );
+	access_speech_aimtarget = CVAR_CREATE( "access_speech_aimtarget", "1", FCVAR_ARCHIVE );
+	access_speech_timer     = CVAR_CREATE( "access_speech_timer", "1", FCVAR_ARCHIVE );
+
+	gEngfuncs.pfnAddCommand( "access_scores", Cmd_Scores );
+	gEngfuncs.pfnAddCommand( "access_time", Cmd_Time );
+	gEngfuncs.pfnAddCommand( "access_motd", Cmd_Motd );
+}
diff --git a/cl_dll/accessibility/access_screens.h b/cl_dll/accessibility/access_screens.h
