+// Shape of the space around: width = narrowest wall-to-wall line through us,
+// length = widest one (8 directions at eye height).
+static void DescribeSpace( char *out, size_t size )
+{
+	out[0] = 0;
+	if( gHUD.m_fPlayerDead || g_iUser1 || CL_IsDead() )
+		return;
+	BeginTraces();
+	float width = 1e9f, length = 0.0f, lengthYaw = 0.0f;
+	for( int k = 0; k < 4; k++ )
+	{
+		const float yaw = s_L.yaw + 45.0f * k;
+		const float span = TraceDistance( s_L.eye, s_L.eye + DirFromYaw( yaw ) * 2000.0f ) +
+			TraceDistance( s_L.eye, s_L.eye - DirFromYaw( yaw ) * 2000.0f );
+		if( span < width )
+			width = span;
+		if( span > length )
+		{
+			length = span;
+			lengthYaw = yaw;
+		}
+	}
+	EndTraces();
+
+	const char *kind;
+	if( width < 160.0f && length > 3.0f * width )
+		kind = "couloir étroit";
+	else if( width < 300.0f && length > 2.5f * width )
+		kind = "couloir";
+	else if( width > 900.0f )
+		kind = "grande zone ouverte";
+	else if( length > 900.0f )
+		kind = "zone ouverte";
+	else
+		kind = "pièce";
+	snprintf( out, size, " %s, %s de large, dans l'axe %s, %s.", kind, MetersText( width ),
+		AccessMap_CompassWord( lengthYaw ), AccessMap_CompassWord( lengthYaw + 180.0f ));
+	out[1] = out[1] - 'a' + 'A';	// sentence start (all kinds begin with a plain letter)
+}
